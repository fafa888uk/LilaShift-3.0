+private struct W6BatchBar: View {
+    let summary: W6BatchSummary
+    let onSelectAll: () -> Void
+    let onDeselectAll: () -> Void
+    let onInvert: () -> Void
+    let onShare: () -> Void
+    let onPack: () -> Void
+
+    var body: some View {
