diff --git a/tests/StructuredLogTests.swift b/tests/StructuredLogTests.swift
new file mode 100644
index 0000000..305c7df
--- /dev/null
+++ b/tests/StructuredLogTests.swift
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Structured log tests (LilaShift 5.0.0, Wave 1 W2) — level
+// mapping, entry construction and redaction, keyword / level /
+// kind / source / date filtering, JSON and text export (including
+// the honesty notes and the redaction of shared files), and the W2
+// directory metadata. Everything here is synchronous and uses only
+// invented identifiers, never a real device's.
+import Foundation
+import XCTest
+@testable import GestaltX
+
+final class StructuredLogTests: XCTestCase {
+    /// Fixed whole-second dates, so JSON round trips are exact
+    /// (ISO 8601 has second precision).
+    private let dayOne = Date(timeIntervalSince1970: 1_800_000_000)
+    private let dayTwo = Date(timeIntervalSince1970: 1_800_086_400)
+    private let exportAt = Date(timeIntervalSince1970: 1_800_100_000)
+
+    private func event(
+        date: Date? = nil, kind: OperationEventKind,
+        key: String? = nil, detail: String, featureID: String? = nil
+    ) -> OperationEvent {
+        OperationEvent(
+            date: date ?? dayOne, kind: kind, key: key,
+            detail: detail, featureID: featureID)
+    }
+
+    private func entries() -> [StructuredLogEntry] {
+        [
+            StructuredLogEntry(event: event(kind: .readSucceeded, detail: "read ok")),
+            StructuredLogEntry(event: event(kind: .readFailed, detail: "read timed out")),
+            StructuredLogEntry(event: event(kind: .guardLayoutUnresolved, detail: "layout unknown")),
+            StructuredLogEntry(event: event(kind: .backupCreated, detail: "backup saved")),
+            StructuredLogEntry(sessionLine: "session started"),
+        ]
+    }
+
+    // MARK: - Level mapping
+
+    func testLevelMappingForAllKinds() {
+        let errors: [OperationEventKind] = [.readFailed, .writeFailed, .restoreFailed, .backupFailed]
+        for kind in errors {
+            XCTAssertEqual(StructuredLogLevel.level(for: kind), .error, "\(kind.rawValue) is an error")
+        }
+        let warnings: [OperationEventKind] = [
+            .guardLayoutUnresolved, .guardHardwareIdentity, .guardNativeConflict,
+            .slotUnresolvable, .regionReverted,
+        ]
+        for kind in warnings {
+            XCTAssertEqual(StructuredLogLevel.level(for: kind), .warning, "\(kind.rawValue) is a warning")
+        }
+        let infos: [OperationEventKind] = [.readSucceeded, .writeVerified, .restoreSucceeded, .backupCreated]
+        for kind in infos {
+            XCTAssertEqual(StructuredLogLevel.level(for: kind), .info, "\(kind.rawValue) is info")
+        }
+        XCTAssertEqual(errors.count + warnings.count + infos.count, 13)
+    }
+
+    func testAllKindsListsEveryKindOnce() {
+        XCTAssertEqual(StructuredLog.allKinds.count, 13)
+        XCTAssertEqual(Set(StructuredLog.allKinds).count, 13)
+        for kind in [OperationEventKind.readSucceeded, .readFailed,
+                     .writeVerified, .writeFailed,
+                     .restoreSucceeded, .restoreFailed,
+                     .guardLayoutUnresolved, .guardHardwareIdentity,
+                     .guardNativeConflict, .slotUnresolvable,
+                     .backupCreated, .backupFailed, .regionReverted] {
+            XCTAssertTrue(StructuredLog.allKinds.contains(kind), "\(kind.rawValue) must be listed")
+        }
+    }
+
+    func testLevelTitlesArePresent() {
+        XCTAssertEqual(StructuredLogLevel.info.title, "Info")
+        XCTAssertEqual(StructuredLogLevel.warning.title, "Warning")
+        XCTAssertEqual(StructuredLogLevel.error.title, "Error")
+    }
+
+    // MARK: - Entry construction
+
+    func testEntryFromOperationEvent() {
+        let entry = StructuredLogEntry(event: event(
+            kind: .readFailed, key: "A62OafQ85EJAiiqKn4agtg",
+            detail: "read timed out", featureID: "regionCode"))
+        XCTAssertEqual(entry.level, .error)
+        XCTAssertEqual(entry.source, .operationEvent)
+        XCTAssertEqual(entry.kind, .readFailed)
+        XCTAssertEqual(entry.date, dayOne)
+        XCTAssertEqual(entry.key, "A62OafQ85EJAiiqKn4agtg")
+        XCTAssertEqual(entry.featureID, "regionCode")
+        XCTAssertEqual(entry.title, OperationEventKind.readFailed.title)
+        XCTAssertEqual(entry.detail, "read timed out")
+    }
+
+    func testEntryRedactsDeviceIdentifiers() {
+        let entry = StructuredLogEntry(event: event(
+            kind: .readFailed,
+            detail: "UniqueDeviceID=00008150-000C0C5A14D2401C and serial ab12cd34ef56"))
+        XCTAssertFalse(entry.detail.contains("00008150-000C0C5A14D2401C"))
+        XCTAssertFalse(entry.detail.contains("ab12cd34ef56"))
+        XCTAssertTrue(entry.detail.contains("[redacted]"))
+    }
+
+    func testEntryFromSessionLineHasNoDateAndIsInfo() {
+        let entry = StructuredLogEntry(sessionLine: "session started")
+        XCTAssertNil(entry.date, "A session line has no recorded time; none is invented")
+        XCTAssertNil(entry.kind)
+        XCTAssertEqual(entry.level, .info)
+        XCTAssertEqual(entry.source, .sessionLine)
+        XCTAssertEqual(entry.detail, "session started")
+    }
+
+    // MARK: - Keyword search
+
+    func testKeywordMatchesTitleDetailKeyAndFeatureID() {
+        let byDetail = StructuredLogEntry(event: event(kind: .backupCreated, detail: "backup saved"))
+        XCTAssertTrue(byDetail.matches(keyword: "backup"))
+        XCTAssertTrue(byDetail.matches(keyword: "BACKUP"), "Search is case-insensitive")
+        let byKey = StructuredLogEntry(event: event(
+            kind: .readSucceeded, key: "A62OafQ85EJAiiqKn4agtg", detail: "read ok"))
+        XCTAssertTrue(byKey.matches(keyword: "A62OafQ85EJAiiqKn4agtg"))
+        let byFeature = StructuredLogEntry(event: event(
+            kind: .readSucceeded, detail: "read ok", featureID: "regionCode"))
+        XCTAssertTrue(byFeature.matches(keyword: "regionCode"))
+        XCTAssertFalse(byDetail.matches(keyword: "regionCode"))
+    }
+
+    func testEmptyKeywordMatchesEverything() {
+        let entry = StructuredLogEntry(event: event(kind: .readFailed, detail: "read timed out"))
+        XCTAssertTrue(entry.matches(keyword: ""))
+        XCTAssertTrue(entry.matches(keyword: "   "))
+    }
+
+    // MARK: - Filters
+
+    func testLevelFilter() {
+        let all = entries()
+        var filter = StructuredLogFilter()
+        filter.levels = [.error]
+        let errors = filter.applying(to: all)
+        XCTAssertEqual(errors.count, 1)
+        XCTAssertEqual(errors.first?.kind, .readFailed)
+        filter.levels = [.info, .warning]
+        XCTAssertEqual(filter.applying(to: all).count, 4)
+    }
+
+    func testKindFilterExcludesSessionLines() {
+        var filter = StructuredLogFilter()
+        filter.kinds = [.backupCreated]
+        let found = filter.applying(to: entries())
+        XCTAssertEqual(found.count, 1)
+        XCTAssertEqual(found.first?.kind, .backupCreated)
+    }
+
+    func testSourceFilter() {
+        var filter = StructuredLogFilter()
+        filter.source = .sessionLine
+        let lines = filter.applying(to: entries())
+        XCTAssertEqual(lines.count, 1)
+        XCTAssertEqual(lines.first?.source, .sessionLine)
+        filter.source = .operationEvent
+        XCTAssertEqual(filter.applying(to: entries()).count, 4)
+    }
+
+    func testDateRangeFilter() {
+        let first = StructuredLogEntry(event: event(date: dayOne, kind: .readSucceeded, detail: "day one"))
+        let second = StructuredLogEntry(event: event(date: dayTwo, kind: .readSucceeded, detail: "day two"))
+        let line = StructuredLogEntry(sessionLine: "undated line")
+        var filter = StructuredLogFilter()
+        filter.fromDate = dayOne
+        filter.toDate = dayOne.addingTimeInterval(3_600)
+        let found = filter.applying(to: [first, second, line])
+        XCTAssertEqual(found.count, 1)
+        XCTAssertEqual(found.first?.detail, "day one")
+        // With no date range the undated line is included.
+        XCTAssertEqual(StructuredLogFilter.unfiltered.applying(to: [first, second, line]).count, 3)
+    }
+
+    func testDayRangeCoversOneCalendarDay() {
+        let range = StructuredLogFilter.dayRange(
+            for: dayOne, calendar: Calendar(identifier: .gregorian))
+        XCTAssertEqual(range.to.timeIntervalSince(range.from), 86_399, accuracy: 0.001)
+        XCTAssertTrue(range.from <= dayOne && dayOne <= range.to)
+    }
+
+    func testCombinedFilters() {
+        var filter = StructuredLogFilter()
+        filter.keyword = "read"
+        filter.levels = [.error]
+        let found = filter.applying(to: entries())
+        XCTAssertEqual(found.count, 1)
+        XCTAssertEqual(found.first?.kind, .readFailed)
+    }
+
+    func testUnfilteredFilterIsNotActive() {
+        XCTAssertFalse(StructuredLogFilter.unfiltered.isActive)
+        var filter = StructuredLogFilter()
+        filter.keyword = "read"
+        XCTAssertTrue(filter.isActive)
+    }
+
+    // MARK: - Assembly and counts
+
+    func testEntriesFromSnapshotOrder() {
+        let snapshot = OperationLogSnapshot(
+            events: [
+                event(kind: .readSucceeded, detail: "first"),
+                event(kind: .backupCreated, detail: "second"),
+            ],
+            freeTextLines: ["line one", "line two"])
+        let built = StructuredLog.entries(from: snapshot)
+        XCTAssertEqual(built.count, 4)
+        XCTAssertEqual(built[0].detail, "first")
+        XCTAssertEqual(built[1].detail, "second")
+        // Session lines have no timestamp, so they follow the
+        // events, newest first.
+        XCTAssertEqual(built[2].detail, "line two")
+        XCTAssertEqual(built[3].detail, "line one")
+        XCTAssertNil(built[2].date)
+    }
+
+    func testCountsByLevel() {
+        let counts = StructuredLog.countsByLevel(entries())
+        XCTAssertEqual(counts[.info], 3)
+        XCTAssertEqual(counts[.warning], 1)
+        XCTAssertEqual(counts[.error], 1)
+        XCTAssertEqual(StructuredLog.countsByLevel([])[.error], 0)
+    }
+
+    // MARK: - Export
+
+    func testJsonExportRoundTrip() throws {
+        let all = entries()
+        let data = try StructuredLogExporter.jsonData(for: all, exportedAt: exportAt)
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        let decoded = try decoder.decode(StructuredLogExportDocument.self, from: data)
+        XCTAssertEqual(decoded.formatVersion, StructuredLogExporter.formatVersion)
+        XCTAssertEqual(decoded.exportedAt, exportAt)
+        XCTAssertEqual(decoded.entryCount, all.count)
+        XCTAssertEqual(decoded.entries, all)
+        XCTAssertEqual(
+            decoded.writeAndRestoreEventsConnected,
+            OperationLogSnapshot.writeAndRestoreEventsConnected)
+    }
+
+    func testJsonExportRedactsIdentifiers() throws {
+        let entry = StructuredLogEntry(event: event(
+            kind: .readFailed,
+            detail: "UniqueDeviceID=00008150-000C0C5A14D2401C failed"))
+        let data = try StructuredLogExporter.jsonData(for: [entry], exportedAt: exportAt)
+        let text = String(decoding: data, as: UTF8.self)
+        XCTAssertFalse(text.contains("00008150-000C0C5A14D2401C"))
+        XCTAssertTrue(text.contains("[redacted]"))
+    }
+
+    func testTextExportContainsHonestyNotesAndLevels() {
+        let text = StructuredLogExporter.text(for: entries(), exportedAt: exportAt)
+        XCTAssertTrue(text.contains(OperationLogSnapshot.writeAndRestoreNote))
+        XCTAssertTrue(text.contains("no network request records"))
+        XCTAssertTrue(text.contains("[ERROR]"))
+        XCTAssertTrue(text.contains("[WARNING]"))
+        XCTAssertTrue(text.contains("[INFO]"))
+        XCTAssertTrue(text.contains("unknown time"), "Undated session lines say so")
+        XCTAssertTrue(text.contains("read timed out"))
+    }
+
+    func testExportFileNames() {
+        XCTAssertEqual(
+            StructuredLogExportFormat.json.fileName(exportedAt: exportAt),
+            "LilaShift-operation-log-1800100000.json")
+        XCTAssertEqual(
+            StructuredLogExportFormat.text.fileName(exportedAt: exportAt),
+            "LilaShift-operation-log-1800100000.log")
+    }
+
+    func testTemporaryExportWritesShareableFile() throws {
+        let export = try StructuredLogExporter.temporaryExport(
+            for: entries(), format: .json, exportedAt: exportAt)
+        addTeardownBlock { export.cleanUp() }
+        XCTAssertTrue(FileManager.default.fileExists(atPath: export.url.path))
+        XCTAssertEqual(export.url.lastPathComponent, "LilaShift-operation-log-1800100000.json")
+        let data = try Data(contentsOf: export.url)
+        XCTAssertFalse(data.isEmpty)
+        export.cleanUp()
+        XCTAssertFalse(FileManager.default.fileExists(atPath: export.url.path))
+    }
+
+    // MARK: - Registration
+
+    func testRegistrationListsBothFeatures() {
+        XCTAssertEqual(W2Registration.features.count, 2)
+        let viewer = W2Registration.feature(id: "w2.structured-log-viewer")
+        XCTAssertEqual(viewer?.title, "结构化日志查看")
+        XCTAssertEqual(viewer?.category, .deviceDiagnostics)
+        XCTAssertEqual(viewer?.viewType, "StructuredLogView")
+        let export = W2Registration.feature(id: "w2.log-export-share")
+        XCTAssertEqual(export?.title, "日志导出分享")
+        XCTAssertEqual(export?.category, .deviceDiagnostics)
+        XCTAssertEqual(export?.viewType, "StructuredLogView")
+        XCTAssertNil(W2Registration.feature(id: "w2.no-such-feature"))
+    }
+}
diff --git a/tests/W4AppleWikiKeyTableTests.swift b/tests/W4AppleWikiKeyTableTests.swift
new file mode 100644
index 0000000..0059441
--- /dev/null
+++ b/tests/W4AppleWikiKeyTableTests.swift
@@ -0,0 +1,155 @@
+import Foundation
+import XCTest
+@testable import GestaltX
+
+/// W4 Apple Wiki key table tests: the generated 943-key table, its
+/// merge into the field editor search, and the hand-reviewed Chinese
+/// names. No key here is guessed — the table is generated from The
+/// Apple Wiki page by scripts/generate_apple_wiki_key_table.py and
+/// cross-checked against the upstream worstgestalt data file.
+final class W4AppleWikiKeyTableTests: XCTestCase {
+    func testWikiTableCounts() {
+        XCTAssertEqual(AppleWikiKeyTable.count, 943)
+        XCTAssertEqual(AppleWikiKeyTable.names.count, 943)
+        XCTAssertEqual(AppleWikiKeyTable.descriptions.count, 671)
+    }
+
+    func testEveryHashedKeyIs22Characters() {
+        XCTAssertTrue(AppleWikiKeyTable.names.keys.allSatisfy { $0.count == 22 })
+        XCTAssertTrue(AppleWikiKeyTable.descriptions.keys.allSatisfy { $0.count == 22 })
+    }
+
+    func testDescriptionsOnlyCoverKnownKeys() {
+        for key in AppleWikiKeyTable.descriptions.keys {
+            XCTAssertNotNil(AppleWikiKeyTable.names[key], "Description for unknown key \(key)")
+        }
+    }
+
+    func testKnownKeysPresent() {
+        XCTAssertEqual(
+            AppleWikiKeyTable.plainName(forHashedKey: "YlEtTtHlNesRBMal1CqRaA"),
+            "DeviceSupportsDynamicIsland")
+        XCTAssertEqual(
+            AppleWikiKeyTable.plainName(forHashedKey: "waGD2UTpntjbDXD1r3oALQ"),
+            "DeviceSupportsSiriHub")
+        XCTAssertEqual(
+            AppleWikiKeyTable.plainName(forHashedKey: "h9jDsbgj7xIVeIQ8S3/X3Q"),
+            "ProductType")
+        XCTAssertEqual(
+            AppleWikiKeyTable.description(forHashedKey: "QHxt+hGLaBPbQJbXiUJX3w"),
+            "The device plays a chime when it turns on.")
+        XCTAssertNil(AppleWikiKeyTable.plainName(forHashedKey: "definitely-not-a-real-key"))
+        XCTAssertNil(AppleWikiKeyTable.description(forHashedKey: "YlEtTtHlNesRBMal1CqRaA"),
+                     "Dynamic Island has no wiki description")
+    }
+
+    func testAppleWikiEntriesAreTheNonCuratedKeys() {
+        XCTAssertEqual(MGKeysTable.appleWikiEntries.count, 878)
+        XCTAssertEqual(MGKeysTable.searchableCount, 955)
+        let curatedKeys = Set(MGKeysTable.all.map(\.key))
+        let wikiKeys = Set(MGKeysTable.appleWikiEntries.map(\.key))
+        XCTAssertTrue(curatedKeys.isDisjoint(with: wikiKeys))
+        XCTAssertEqual(curatedKeys.union(wikiKeys).count, 943)
+        // Sorted by name, like `all`.
+        let names = MGKeysTable.appleWikiEntries.map(\.name)
+        XCTAssertEqual(names, names.sorted { $0.localizedCaseInsensitiveCompare($1) == .orderedAscending })
+    }
+
+    func testAppleWikiEntriesCiteTheWiki() {
+        for entry in MGKeysTable.appleWikiEntries {
+            XCTAssertFalse(entry.meaning.isEmpty, "Entry \(entry.key) has no meaning")
+            XCTAssertTrue(entry.source.contains("The Apple Wiki"), "Entry \(entry.key) cites \(entry.source)")
+            XCTAssertTrue(entry.source.contains("CC BY-SA 4.0"), "Entry \(entry.key) carries the data license")
+        }
+    }
+
+    func testCuratedRowsKeepPriority() {
+        // The spatial audio key is both curated and in the wiki; the
+        // searchable index must carry the capability row only.
+        let spatial = MGKeysTable.matching("X6NGcYcvHmbqlR8hLXASJA")
+        XCTAssertEqual(spatial.count, 1)
+        XCTAssertTrue(spatial.first!.source.contains("spatialAudioRecording"))
+        XCTAssertEqual(MGKeysTable.matching("SiriHub").count, 1)
+        XCTAssertEqual(MGKeysTable.matching("SiriHub").first?.key, "waGD2UTpntjbDXD1r3oALQ")
+    }
+
+    func testEmptyQueryStillReturnsTheCuratedTableOnly() {
+        // The browse list is the 77 curated rows: MGDatabaseSeed
+        // mirrors `all` exactly, so the wiki rows stay search-only.
+        XCTAssertEqual(MGKeysTable.matching("").count, MGKeysTable.all.count)
+        XCTAssertEqual(MGKeysTable.all.count, 77)
+    }
+
+    func testSearchFindsWikiOnlyKeys() {
+        // By wiki plain name.
+        let liquid = MGKeysTable.matching("DeviceSupportsLiquidDetection")
+        XCTAssertEqual(liquid.count, 1)
+        XCTAssertEqual(liquid.first?.key, "XxnEk9uiIk5vCdbWEGt7lA")
+        // By wiki description words.
+        XCTAssertFalse(MGKeysTable.matching("accelerometer hardware").isEmpty)
+        // By obfuscated key.
+        XCTAssertFalse(MGKeysTable.matching("XxnEk9uiIk5vCdbWEGt7lA").isEmpty)
+        // No match returns an empty list, never a guess.
+        XCTAssertTrue(MGKeysTable.matching("definitely-not-a-real-key-xyz").isEmpty)
+    }
+
+    func testSearchFindsChineseNames() {
+        let island = MGKeysTable.matching("灵动岛")
+        XCTAssertEqual(island.count, 1)
+        XCTAssertEqual(island.first?.key, "YlEtTtHlNesRBMal1CqRaA")
+        XCTAssertFalse(MGKeysTable.matching("常亮显示").isEmpty)
+        XCTAssertFalse(MGKeysTable.matching("销售地区代码").isEmpty)
+        // The "no Chinese name yet" label is a status, not a name.
+        XCTAssertTrue(MGKeysTable.matching("暂无中文名").isEmpty)
+    }
+
+    func testChineseCoverage() {
+        XCTAssertEqual(MGKeyChineseNames.translatedKeyCount, 122)
+        XCTAssertEqual(Set(MGKeyChineseNames.names.keys), Set(MGKeyChineseNames.descriptions.keys))
+        // Every curated key has a reviewed Chinese name.
+        for entry in MGKeysTable.all {
+            XCTAssertNotNil(entry.chineseName, "Curated key \(entry.key) has no Chinese name")
+            XCTAssertNotNil(entry.chineseDescription, "Curated key \(entry.key) has no Chinese description")
+        }
+        // Every translated key is a real key: in the wiki table or the
+        // curated table (identity keys such as the Siri AI mode key are
+        // curated-only).
+        let wikiKeys = Set(AppleWikiKeyTable.names.keys)
+        let curatedKeys = Set(MGKeysTable.all.map(\.key))
+        for key in MGKeyChineseNames.names.keys {
+            XCTAssertTrue(wikiKeys.contains(key) || curatedKeys.contains(key),
+                          "Translated key \(key) is in neither table")
+        }
+        // 821 wiki keys are still untranslated: they must report nil,
+        // never a fabricated name.
+        let untranslated = MGKeysTable.appleWikiEntries.filter { $0.chineseName == nil }
+        XCTAssertEqual(untranslated.count, 878 - 45)
+        XCTAssertEqual(MGKeyChineseNames.missingChineseNameLabel, "暂无中文名")
+    }
+}
+
+/// W4 registration tests: the two features' directory metadata.
+final class W4RegistrationTests: XCTestCase {
+    func testTwoFeatures() {
+        XCTAssertEqual(W4Registration.features.count, 2)
+        XCTAssertEqual(Set(W4Registration.features.map(\.id)).count, 2)
+    }
+
+    func testKeyTableFeature() {
+        let feature = W4Registration.features.first { $0.id == "w4.appleWikiKeyTable" }
+        XCTAssertNotNil(feature)
+        XCTAssertEqual(feature!.chineseTitle, "Apple Wiki 键值表")
+        XCTAssertEqual(feature!.category, .deviceDiagnostics)
+        XCTAssertEqual(feature!.viewKind, .keyTableSearch)
+        XCTAssertFalse(feature!.summary.isEmpty)
+    }
+
+    func testChineseNamesFeature() {
+        let feature = W4Registration.features.first { $0.id == "w4.chineseKeyNames" }
+        XCTAssertNotNil(feature)
+        XCTAssertEqual(feature!.chineseTitle, "键名中文翻译")
+        XCTAssertEqual(feature!.category, .deviceDiagnostics)
+        XCTAssertEqual(feature!.viewKind, .keyRowDisplay)
+        XCTAssertFalse(feature!.summary.isEmpty)
+    }
+}
diff --git a/tests/W4KeyTableGeneratorTests.py b/tests/W4KeyTableGeneratorTests.py
new file mode 100644
index 0000000..e69ac08
--- /dev/null
+++ b/tests/W4KeyTableGeneratorTests.py
@@ -0,0 +1,149 @@
+import importlib.util
+import re
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+GENERATOR = ROOT / "scripts" / "generate_apple_wiki_key_table.py"
+GENERATED = ROOT / "GestaltX" / "AppleWikiKeyTable.swift"
+CHINESE = ROOT / "GestaltX" / "MGKeyChineseNames.swift"
+NOTICES = ROOT / "W4NOTICES.md"
+SOURCE_URL = "https://theapplewiki.com/wiki/List_of_MobileGestalt_keys"
+
+
+def load_generator():
+    spec = importlib.util.spec_from_file_location(
+        "generate_apple_wiki_key_table", GENERATOR
+    )
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+SAMPLE_WIKITEXT = """Intro text, not a table.
+{| class="wikitable sortable"
+|+
+!Key
+!Hashed key
+!iOS introduced
+!iOS removed
+!Device introduced
+!Description
+|-
+|DeviceClass
+|<code>+3Uf0Pm5F8Xy7Onyvko0vA</code>
+|1.0
+|
+|
+|Device class for this device. One of the kMGDeviceClass* constants defined below
+|-
+|arkit
+|<code>67A3BpQkCRe1ihx0Me4lgg</code>
+|
+|
+|
+|The device is capable of using [[ARKit]].
+|-
+|NoDescriptionKey
+|<code>AAAAAAAAAAAAAAAAAAAAAA</code>
+|
+|
+|
+|
+|}
+"""
+
+
+class GeneratorTests(unittest.TestCase):
+    def test_parser_reads_names_and_descriptions(self):
+        gen = load_generator()
+        entries = gen.parse_wikitext(SAMPLE_WIKITEXT)
+        self.assertEqual(len(entries), 3)
+        self.assertEqual(entries["+3Uf0Pm5F8Xy7Onyvko0vA"][0], "DeviceClass")
+        self.assertIn("Device class for this device", entries["+3Uf0Pm5F8Xy7Onyvko0vA"][1])
+        # Wiki links are cleaned to their label; empty descriptions stay empty.
+        self.assertEqual(
+            entries["67A3BpQkCRe1ihx0Me4lgg"][1],
+            "The device is capable of using ARKit.",
+        )
+        self.assertEqual(entries["AAAAAAAAAAAAAAAAAAAAAA"][1], "")
+
+    def test_parser_rejects_bad_hashed_keys(self):
+        gen = load_generator()
+        bad = SAMPLE_WIKITEXT.replace("+3Uf0Pm5F8Xy7Onyvko0vA", "not-a-key!!")
+        with self.assertRaises(ValueError):
+            gen.parse_wikitext(bad)
+
+    def test_swift_escaping(self):
+        gen = load_generator()
+        self.assertEqual(gen.swift_escape('a"b\\c'), 'a\\"b\\\\c')
+
+    def test_render_carries_attribution(self):
+        gen = load_generator()
+        entries = gen.parse_wikitext(SAMPLE_WIKITEXT)
+        output = gen.render(entries, "wiki revision 2026-11-28")
+        self.assertIn("CC BY-SA 4.0", output)
+        self.assertIn("The Apple Wiki", output)
+        self.assertIn(SOURCE_URL, output)
+        self.assertIn("Do not edit by hand", output)
+        self.assertIn("static let count = 3", output)
+
+    def test_generated_file_counts(self):
+        # The committed file must be the generator's output for the live
+        # wiki page (943 keys, 671 with descriptions; see records/w4-keytable.md).
+        text = GENERATED.read_text(encoding="utf-8")
+        self.assertIn("static let count = 943", text)
+        names_section = text.split("static let names")[1].split("static let descriptions")[0]
+        descriptions_section = text.split("static let descriptions")[1]
+        names = re.findall(r'"([A-Za-z0-9+/=_-]{22})": "([^"]+)",', names_section)
+        descriptions = re.findall(
+            r'"([A-Za-z0-9+/=_-]{22})": "(.*)",', descriptions_section
+        )
+        self.assertEqual(len(names), 943)
+        self.assertEqual(len({key for key, _ in names}), 943)
+        self.assertEqual(len(descriptions), 671)
+        self.assertTrue(
+            {key for key, _ in descriptions} <= {key for key, _ in names}
+        )
+        self.assertIn("CC BY-SA 4.0", text)
+        self.assertIn("The Apple Wiki", text)
+
+    def test_chinese_map_counts(self):
+        text = CHINESE.read_text(encoding="utf-8")
+        names_section = text.split("static let names")[1].split("static let descriptions")[0]
+        descriptions_section = text.split("static let descriptions")[1]
+        names = dict(
+            re.findall(r'"((?:[^"\\]|\\.)*)": "((?:[^"\\]|\\.)*)",', names_section)
+        )
+        descriptions = dict(
+            re.findall(r'"((?:[^"\\]|\\.)*)": "((?:[^"\\]|\\.)*)",', descriptions_section)
+        )
+        self.assertEqual(len(names), 122)
+        self.assertEqual(set(names), set(descriptions))
+        self.assertTrue(all(value.strip() for value in names.values()))
+        self.assertTrue(all(value.strip() for value in descriptions.values()))
+        # No fabricated "translation" for untranslated keys: the map
+        # only lists reviewed keys, and the missing-name label is separate.
+        self.assertIn('static let missingChineseNameLabel = "暂无中文名"', text)
+
+    def test_notices(self):
+        text = NOTICES.read_text(encoding="utf-8")
+        for required in (
+            "worstgestalt",
+            "GPL-3.0",
+            "awesomenull",
+            "Taj C",
+            "forcequitOS",
+            "CC BY-SA 4.0",
+            "The Apple Wiki",
+            "相同方式共享",
+        ):
+            self.assertIn(required, text)
+        # What W4 deliberately did NOT port must be on record.
+        for excluded in ("Nugget", "NeoSpring", "device spoofing", "bad_query"):
+            self.assertIn(excluded, text)
+
+
+if __name__ == "__main__":
+    unittest.main()
