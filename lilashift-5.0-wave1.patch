+// SPDX-License-Identifier: GPL-3.0-only
+// IPA Audit — Mach-O parser (W3, LilaShift 5.0.0).
+//
+// Static Mach-O parsing ported from the design of Kianuni/WQGuard
+// v1.3.6 (`Sources/WQGuardCore/MachO/MachOParser.swift`, MIT,
+// Copyright (c) 2026 WQGuard Contributors) — see W3NOTICES.md.
+// This is a compact re-implementation for LilaShift, not a copy of
+// the upstream file: it keeps the upstream invariants (fat-slice
+// cap, 64-bit overflow-safe bounds checks, arm64/arm64e union,
+// LC_SYMTAB / LC_LOAD_DYLIB / LC_ENCRYPTION_INFO_64 /
+// LC_CODE_SIGNATURE traversal, ARM64 `svc #0x80` scan) and drops
+// the parts LilaShift does not need (macOS CLI paths, live
+// process inspection).
+//
+// Read-only: the parser never executes, maps or loads the binary;
+// every read is bounds-checked against the supplied `Data`, and
+// any out-of-range value is an error, never a clamped guess.
+import Foundation
+
+/// Errors raised by the IPA audit engine. The message is already
+/// user-facing text (built with `L()` at the throw site where a
+/// localized string exists); the view shows it verbatim.
+struct IPAAuditError: LocalizedError, Equatable, Sendable {
+    let message: String
+    init(_ message: String) { self.message = message }
+    var errorDescription: String? { message }
+}
+
+// MARK: - Bounds-checked binary reader
+
+/// Little- and big-endian reads over an in-memory `Data` buffer.
+/// Every accessor returns `nil` out of bounds instead of trapping,
+/// so a malformed header can never crash the scanner.
+struct IPAAuditDataReader: Sendable {
+    let data: Data
+
+    var count: Int { data.count }
+
+    /// True when `offset ..< offset + size` lies inside the buffer.
+    /// Written to avoid overflow: `offset + size` is never computed
+    /// on unchecked values.
+    func contains(offset: Int, size: Int) -> Bool {
+        guard offset >= 0, size >= 0, offset <= data.count else { return false }
+        return size <= data.count - offset
+    }
+
+    func uint8(at offset: Int) -> UInt8? {
+        guard contains(offset: offset, size: 1) else { return nil }
+        return data[offset]
+    }
+
+    func uint16LE(at offset: Int) -> UInt16? {
+        guard contains(offset: offset, size: 2) else { return nil }
+        return UInt16(data[offset]) | (UInt16(data[offset + 1]) << 8)
+    }
+
+    func uint32LE(at offset: Int) -> UInt32? {
+        guard contains(offset: offset, size: 4) else { return nil }
+        return UInt32(data[offset])
+            | (UInt32(data[offset + 1]) << 8)
+            | (UInt32(data[offset + 2]) << 16)
+            | (UInt32(data[offset + 3]) << 24)
+    }
+
+    func uint32BE(at offset: Int) -> UInt32? {
+        guard contains(offset: offset, size: 4) else { return nil }
+        return (UInt32(data[offset]) << 24)
+            | (UInt32(data[offset + 1]) << 16)
+            | (UInt32(data[offset + 2]) << 8)
+            | UInt32(data[offset + 3])
+    }
+
+    func uint64LE(at offset: Int) -> UInt64? {
+        guard contains(offset: offset, size: 8) else { return nil }
+        var value: UInt64 = 0
+        for index in 0..<8 {
+            value |= UInt64(data[offset + index]) << (index * 8)
+        }
+        return value
+    }
+
+    func subdata(offset: Int, size: Int) -> Data? {
+        guard contains(offset: offset, size: size) else { return nil }
+        return data.subdata(in: offset..<(offset + size))
+    }
+
+    /// A NUL-terminated UTF-8 string starting at `offset`, or `nil`
+    /// when no NUL appears within `maxLength` bytes or the bytes
+    /// are not valid UTF-8. The returned string never includes the
+    /// terminator.
+    func cString(at offset: Int, maxLength: Int) -> String? {
+        guard offset >= 0, offset < data.count, maxLength > 0 else { return nil }
+        let limit = min(data.count - offset, maxLength)
+        var end = offset
+        while end < offset + limit, data[end] != 0 {
+            end += 1
+        }
+        guard end < offset + limit else { return nil }
+        guard end > offset else { return "" }
+        return String(bytes: data[offset..<end], encoding: .utf8)
+    }
+}
+
+// MARK: - Parsed Mach-O report
+
+/// What the parser learned from one Mach-O image (one thin binary,
+/// or one fat slice). Only matched evidence is kept in the audit
+/// report; the full symbol/string tables stay in this struct so the
+/// rule engine can match against them without re-parsing.
+struct IPAAuditMachOReport: Equatable, Sendable {
+    /// CPU type string, e.g. "arm64", "arm64e", "x86_64".
+    let architecture: String
+    let is64Bit: Bool
+    /// True when the source file was a fat binary.
+    let isFat: Bool
+    /// Slice count of the source fat binary (1 for a thin binary).
+    let sliceCount: Int
+    /// Install names from LC_LOAD_DYLIB / LC_LOAD_WEAK_DYLIB /
+    /// LC_REEXPORT_DYLIB, in load-command order, deduplicated.
+    let linkedDylibs: [String]
+    /// Imported + exported symbol names from LC_SYMTAB.
+    let symbols: [String]
+    /// True when the symbol table was cut off by `maxSymbols`.
+    let symbolsTruncated: Bool
+    /// NUL-terminated strings from __TEXT,__cstring.
+    let cstrings: [String]
+    /// True when the string table was cut off by `maxStrings`.
+    let stringsTruncated: Bool
+    /// Objective-C selector names from __TEXT,__objc_methname.
+    let objcSelectors: [String]
+    /// FairPlay encryption state from LC_ENCRYPTION_INFO(_64):
+    /// `cryptid != 0` means the __TEXT segment is encrypted and
+    /// static analysis of this image is impossible.
+    let isFairPlayEncrypted: Bool
+    /// True when an ARM64 `svc #0x80` instruction (0xD4001001) was
+    /// found in a __TEXT section (direct syscall, bypassing
+    /// libSystem wrappers).
+    let hasDirectSyscall: Bool
+    /// Number of `svc #0x80` instructions found (0 when none).
+    let directSyscallCount: Int
+    /// Raw LC_CODE_SIGNATURE payload, when present. The caller
+    /// hands it to `IPAAuditCSBlobParser`; this struct never
+    /// interprets it.
+    let codeSignature: Data?
+}
+
+// MARK: - Parser
+
+/// Bounds-checked Mach-O parser for 32-bit, 64-bit and fat
+/// binaries. The upstream hard cap of 1,024 fat slices (anti
+/// slice-bomb) is kept.
+enum IPAAuditMachOParser {
+    static let maxFatSlices = 1_024
+    static let maxSymbols = 100_000
+    static let maxStrings = 100_000
+    static let maxCStringLength = 512
+
+    /// Load-command values (from `<mach-o/loader.h>`).
+    static let lcSegment: UInt32 = 0x1
+    static let lcSymtab: UInt32 = 0x2
+    static let lcLoadDylib: UInt32 = 0xc
+    static let lcLoadWeakDylib: UInt32 = 0x18
+    static let lcReexportDylib: UInt32 = 0x1f
+    static let lcCodeSignature: UInt32 = 0x1d
+    static let lcEncryptionInfo: UInt32 = 0x21
+    static let lcSegment64: UInt32 = 0x19
+    static let lcEncryptionInfo64: UInt32 = 0x2c
+
+    /// ARM64 `svc #0x80` little-endian encoding.
+    static let svc0x80: UInt32 = 0xD400_1001
+
+    /// CPU types (from `<mach/machine.h>`).
+    static let cpuTypeARM64: UInt32 = 0x0100_000C
+    static let cpuTypeARM64_32: UInt32 = 0x0200_000C
+    static let cpuTypeX86_64: UInt32 = 0x0100_0007
+
+    /// Parses `data` as a thin or fat Mach-O and returns one report
+    /// per slice. Fat binaries return the union of their slices:
+    /// callers match rules against every slice so a second slice
+    /// cannot hide evidence (anti multi-slice shadowing).
+    static func parse(_ data: Data) throws -> [IPAAuditMachOReport] {
+        let reader = IPAAuditDataReader(data: data)
+        guard let magicBE = reader.uint32BE(at: 0) else {
+            throw IPAAuditError(L("The file is too small to be a Mach-O binary."))
+        }
+        switch magicBE {
+        case 0xcafe_babe, 0xcafe_babf:
+            return try parseFat(reader)
+        default:
+            return [try parseThin(reader, baseOffset: 0, isFat: false, sliceCount: 1)]
+        }
+    }
+
+    // MARK: Fat
+
+    private static func parseFat(_ reader: IPAAuditDataReader) throws -> [IPAAuditMachOReport] {
+        guard let sliceCount32 = reader.uint32BE(at: 4) else {
+            throw IPAAuditError(L("The fat binary header is truncated."))
+        }
+        guard sliceCount32 >= 1, sliceCount32 <= UInt32(maxFatSlices) else {
+            throw IPAAuditError(L("The fat binary declares an impossible slice count."))
+        }
+        let sliceCount = Int(sliceCount32)
+        var reports: [IPAAuditMachOReport] = []
+        reports.reserveCapacity(sliceCount)
+        for index in 0..<sliceCount {
+            let entryOffset = 8 + index * 20
+            guard let offset = reader.uint32BE(at: entryOffset + 8),
+                  let size = reader.uint32BE(at: entryOffset + 12) else {
+                throw IPAAuditError(L("The fat binary slice table is truncated."))
+            }
+            let sliceOffset = Int(offset)
+            let sliceSize = Int(size)
+            guard sliceSize > 0, reader.contains(offset: sliceOffset, size: sliceSize) else {
+                throw IPAAuditError(L("A fat binary slice lies outside the file."))
+            }
+            guard let sliceData = reader.subdata(offset: sliceOffset, size: sliceSize) else {
+                throw IPAAuditError(L("A fat binary slice lies outside the file."))
+            }
+            let sliceReader = IPAAuditDataReader(data: sliceData)
+            reports.append(try parseThin(sliceReader, baseOffset: 0, isFat: true, sliceCount: sliceCount))
+        }
+        return reports
+    }
+
+    // MARK: Thin
+
+    private static func parseThin(
+        _ reader: IPAAuditDataReader, baseOffset: Int, isFat: Bool, sliceCount: Int
+    ) throws -> IPAAuditMachOReport {
+        guard let magic = reader.uint32LE(at: baseOffset) else {
+            throw IPAAuditError(L("The file is too small to be a Mach-O binary."))
+        }
+        let is64Bit: Bool
+        switch magic {
+        case 0xfeed_facf: is64Bit = true
+        case 0xfeed_face: is64Bit = false
+        default: throw IPAAuditError(L("The file is not a Mach-O binary."))
+        }
+        guard let cpuType = reader.uint32LE(at: baseOffset + 4),
+              let cpuSubtype = reader.uint32LE(at: baseOffset + 8),
+              let ncmds = reader.uint32LE(at: baseOffset + 16),
+              let sizeofcmds = reader.uint32LE(at: baseOffset + 20) else {
+            throw IPAAuditError(L("The Mach-O header is truncated."))
+        }
+        let headerSize = is64Bit ? 32 : 28
+        let commandsEnd = baseOffset + headerSize + Int(sizeofcmds)
+        guard ncmds <= 10_000,
+              reader.contains(offset: baseOffset + headerSize, size: Int(sizeofcmds)),
+              commandsEnd <= reader.count else {
+            throw IPAAuditError(L("The Mach-O load commands lie outside the file."))
+        }
+
+        var linkedDylibs: [String] = []
+        var symtab: (symoff: Int, nsyms: Int, stroff: Int, strsize: Int)?
+        var textSections: [(offset: Int, size: Int)] = []
+        var cstringSection: (offset: Int, size: Int)?
+        var methnameSection: (offset: Int, size: Int)?
+        var isFairPlayEncrypted = false
+        var codeSignature: Data?
+        var cursor = baseOffset + headerSize
+
+        for _ in 0..<Int(ncmds) {
+            guard let cmd = reader.uint32LE(at: cursor),
+                  let cmdsize = reader.uint32LE(at: cursor + 4),
+                  cmdsize >= 8,
+                  reader.contains(offset: cursor, size: Int(cmdsize)),
+                  cursor + Int(cmdsize) <= commandsEnd else {
+                throw IPAAuditError(L("A Mach-O load command is truncated."))
+            }
+            switch cmd {
+            case lcSegment, lcSegment64:
+                let isSegment64 = (cmd == lcSegment64)
+                let nsectsOffset = isSegment64 ? 64 : 48
+                guard let nsects = reader.uint32LE(at: cursor + nsectsOffset) else {
+                    throw IPAAuditError(L("A Mach-O segment command is truncated."))
+                }
+                guard nsects <= 1_000 else {
+                    throw IPAAuditError(L("A Mach-O segment declares too many sections."))
+                }
+                let sectionSize = isSegment64 ? 80 : 68
+                let sectionsStart = cursor + (isSegment64 ? 72 : 56)
+                for sectionIndex in 0..<Int(nsects) {
+                    let sectionOffset = sectionsStart + sectionIndex * sectionSize
+                    guard reader.contains(offset: sectionOffset, size: sectionSize),
+                          let sectname = cStringFromFixed(reader: reader, offset: sectionOffset, length: 16),
+                          let segname = cStringFromFixed(reader: reader, offset: sectionOffset + 16, length: 16) else {
+                        throw IPAAuditError(L("A Mach-O section header is truncated."))
+                    }
+                    let sizeOffset = isSegment64 ? sectionOffset + 40 : sectionOffset + 36
+                    let fileOffsetOffset = isSegment64 ? sectionOffset + 48 : sectionOffset + 40
+                    guard let sectionSizeValue = isSegment64
+                            ? reader.uint64LE(at: sizeOffset).map({ Int($0) })
+                            : reader.uint32LE(at: sizeOffset).map({ Int($0) }),
+                          let fileOffset = reader.uint32LE(at: fileOffsetOffset).map({ Int($0) }) else {
+                        throw IPAAuditError(L("A Mach-O section header is truncated."))
+                    }
+                    guard sectionSizeValue >= 0, fileOffset >= 0,
+                          reader.contains(offset: fileOffset, size: sectionSizeValue) else {
+                        throw IPAAuditError(L("A Mach-O section lies outside the file."))
+                    }
+                    if segname == "__TEXT" {
+                        textSections.append((offset: fileOffset, size: sectionSizeValue))
+                        if sectname == "__cstring" {
+                            cstringSection = (offset: fileOffset, size: sectionSizeValue)
+                        } else if sectname == "__objc_methname" {
+                            methnameSection = (offset: fileOffset, size: sectionSizeValue)
+                        }
+                    }
+                }
+            case lcSymtab:
+                guard let symoff = reader.uint32LE(at: cursor + 8),
+                      let nsyms = reader.uint32LE(at: cursor + 12),
+                      let stroff = reader.uint32LE(at: cursor + 16),
+                      let strsize = reader.uint32LE(at: cursor + 20) else {
+                    throw IPAAuditError(L("The symbol table command is truncated."))
+                }
+                symtab = (symoff: Int(symoff), nsyms: Int(nsyms), stroff: Int(stroff), strsize: Int(strsize))
+            case lcLoadDylib, lcLoadWeakDylib, lcReexportDylib:
+                guard let nameOffset = reader.uint32LE(at: cursor + 8) else {
+                    throw IPAAuditError(L("A dylib load command is truncated."))
+                }
+                if let name = reader.cString(at: cursor + Int(nameOffset), maxLength: 1_024),
+                   !name.isEmpty, !linkedDylibs.contains(name) {
+                    linkedDylibs.append(name)
+                }
+            case lcEncryptionInfo, lcEncryptionInfo64:
+                guard let cryptid = reader.uint32LE(at: cursor + 16) else {
+                    throw IPAAuditError(L("The encryption info command is truncated."))
+                }
+                if cryptid != 0 { isFairPlayEncrypted = true }
+            case lcCodeSignature:
+                guard let dataoff = reader.uint32LE(at: cursor + 8),
+                      let datasize = reader.uint32LE(at: cursor + 12) else {
+                    throw IPAAuditError(L("The code signature command is truncated."))
+                }
+                guard Int(datasize) >= 0, reader.contains(offset: Int(dataoff), size: Int(datasize)) else {
+                    throw IPAAuditError(L("The code signature lies outside the file."))
+                }
+                codeSignature = reader.subdata(offset: Int(dataoff), size: Int(datasize))
+            default:
+                break
+            }
+            cursor += Int(cmdsize)
+        }
+
+        let symbols = try readSymbols(reader: reader, symtab: symtab, is64Bit: is64Bit)
+        let cstrings = readCStringSection(reader: reader, section: cstringSection)
+        let objcSelectors = readCStringSection(reader: reader, section: methnameSection)
+        let (hasDirectSyscall, directSyscallCount) = countDirectSyscalls(
+            reader: reader, sections: textSections, architectureIsARM64: cpuType == cpuTypeARM64 || cpuType == cpuTypeARM64_32)
+
+        return IPAAuditMachOReport(
+            architecture: architectureName(cpuType: cpuType, cpuSubtype: cpuSubtype),
+            is64Bit: is64Bit,
+            isFat: isFat,
+            sliceCount: sliceCount,
+            linkedDylibs: linkedDylibs,
+            symbols: symbols.values,
+            symbolsTruncated: symbols.truncated,
+            cstrings: cstrings.values,
+            stringsTruncated: cstrings.truncated,
+            objcSelectors: objcSelectors.values,
+            isFairPlayEncrypted: isFairPlayEncrypted,
+            hasDirectSyscall: hasDirectSyscall,
+            directSyscallCount: directSyscallCount,
+            codeSignature: codeSignature)
+    }
+
+    // MARK: Symbol + string tables
+
+    private static func readSymbols(
+        reader: IPAAuditDataReader,
+        symtab: (symoff: Int, nsyms: Int, stroff: Int, strsize: Int)?,
+        is64Bit: Bool
+    ) throws -> (values: [String], truncated: Bool) {
+        guard let symtab else { return ([], false) }
+        guard symtab.nsyms >= 0, symtab.nsyms <= maxSymbols * 2,
+              symtab.stroff >= 0, symtab.strsize >= 0,
+              reader.contains(offset: symtab.stroff, size: symtab.strsize) else {
+            throw IPAAuditError(L("The symbol table lies outside the file."))
+        }
+        let entrySize = is64Bit ? 16 : 12
+        guard symtab.symoff >= 0,
+              reader.contains(offset: symtab.symoff, size: symtab.nsyms * entrySize) else {
+            throw IPAAuditError(L("The symbol table lies outside the file."))
+        }
+        var values: [String] = []
+        var seen = Set<String>()
+        var truncated = false
+        for index in 0..<symtab.nsyms {
+            if values.count >= maxSymbols { truncated = true; break }
+            let entryOffset = symtab.symoff + index * entrySize
+            guard let strx = reader.uint32LE(at: entryOffset) else { break }
+            guard strx != 0, Int(strx) < symtab.strsize else { continue }
+            let stringOffset = symtab.stroff + Int(strx)
+            guard let name = reader.cString(at: stringOffset, maxLength: maxCStringLength),
+                  !name.isEmpty, seen.insert(name).inserted else { continue }
+            values.append(name)
+        }
+        return (values, truncated)
+    }
+
+    /// Splits a `__cstring`-style section (NUL-separated strings)
+    /// into its strings, capped at `maxStrings`.
+    private static func readCStringSection(
+        reader: IPAAuditDataReader, section: (offset: Int, size: Int)?
+    ) -> (values: [String], truncated: Bool) {
+        guard let section, section.size > 0,
+              let bytes = reader.subdata(offset: section.offset, size: section.size) else {
+            return ([], false)
+        }
+        var values: [String] = []
+        var seen = Set<String>()
+        var truncated = false
+        var start = bytes.startIndex
+        while start < bytes.endIndex {
+            if values.count >= maxStrings { truncated = true; break }
+            guard let nul = bytes[start...].firstIndex(of: 0) else { break }
+            if nul > start {
+                let slice = bytes[start..<nul]
+                if slice.count <= maxCStringLength,
+                   let text = String(bytes: slice, encoding: .utf8),
+                   !text.isEmpty, seen.insert(text).inserted {
+                    values.append(text)
+                }
+            }
+            start = bytes.index(after: nul)
+        }
+        return (values, truncated)
+    }
+
+    /// Counts ARM64 `svc #0x80` instructions in the __TEXT
+    /// sections of ARM64 slices. Non-ARM slices are never scanned:
+    /// the encoding is ARM64-specific, so scanning x86_64 bytes
+    /// for it would only produce false positives.
+    private static func countDirectSyscalls(
+        reader: IPAAuditDataReader, sections: [(offset: Int, size: Int)], architectureIsARM64: Bool
+    ) -> (hasDirectSyscall: Bool, count: Int) {
+        guard architectureIsARM64 else { return (false, 0) }
+        var count = 0
+        for section in sections {
+            guard section.size >= 4,
+                  let bytes = reader.subdata(offset: section.offset, size: section.size) else { continue }
+            var index = bytes.startIndex
+            let last = bytes.index(bytes.endIndex, offsetBy: -3)
+            while index <= last {
+                if reader.uint32LE(at: section.offset + (index - bytes.startIndex)) == svc0x80 {
+                    count += 1
+                    index = bytes.index(index, offsetBy: 4)
+                } else {
+                    index = bytes.index(after: index)
+                }
+            }
+        }
+        return (count > 0, count)
+    }
+
+    private static func cStringFromFixed(reader: IPAAuditDataReader, offset: Int, length: Int) -> String? {
+        guard reader.contains(offset: offset, size: length),
+              let bytes = reader.subdata(offset: offset, size: length) else { return nil }
+        let end = bytes.firstIndex(of: 0) ?? bytes.endIndex
+        return String(bytes: bytes[bytes.startIndex..<end], encoding: .utf8)
+    }
+
+    private static func architectureName(cpuType: UInt32, cpuSubtype: UInt32) -> String {
+        switch cpuType {
+        case cpuTypeARM64:
+            // CPU_SUBTYPE_ARM64E == 2.
+            return cpuSubtype == 2 ? "arm64e" : "arm64"
+        case cpuTypeARM64_32:
+            return "arm64_32"
+        case cpuTypeX86_64:
+            return "x86_64"
+        default:
+            return "cpu_0x\(String(cpuType, radix: 16))"
+        }
+    }
+}
diff --git a/GestaltX/IPAAuditReport.swift b/GestaltX/IPAAuditReport.swift
new file mode 100644
index 0000000..3c33ac4
--- /dev/null
+++ b/GestaltX/IPAAuditReport.swift
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// IPA Audit — audit report model + export renderers (W3).
+//
+// The report is the only thing that leaves the scanner: it is a
+// plain `Codable` value built from real parse results, never from
+// guesses. Every field that could not be determined is `nil` or
+// an explicit "unknown" — the renderers never fill a gap with a
+// plausible-looking value. Export formats: RFC 8259 JSON,
+// Markdown, and plain text, shared through the system share
+// sheet (the same `TemporaryExport` + `ShareSheet` the app
+// already uses for other exports).
+import Foundation
+
+/// One matched rule, with its evidence.
+struct IPAAuditFinding: Equatable, Codable, Sendable {
+    let ruleID: String
+    let title: String
+    let detail: String
+    let severity: IPAAuditVerdict
+    /// Where it was found, e.g. "Payload/App.app/App · LC_SYMTAB".
+    let location: String
+    /// The matched evidence, truncated to 128 characters by the
+    /// engine so a hostile binary cannot smuggle long strings
+    /// into the report.
+    let evidence: String
+    let relatedCVE: String?
+}
+
+/// The signature facts for one audited binary.
+struct IPAAuditBinaryReport: Equatable, Codable, Sendable {
+    /// Path inside the IPA, e.g. "Payload/App.app/App".
+    let relativePath: String
+    let architectures: [String]
+    let isFat: Bool
+    /// `cryptid != 0` on every slice.
+    let isFairPlayEncrypted: Bool
+    /// True when FairPlay encryption made static analysis
+    /// impossible for this binary (no rule matching ran on it).
+    let wasSkipped: Bool
+    let hasDirectSyscall: Bool
+    let directSyscallCount: Int
+    /// Linked dylibs, capped at 200 by the engine.
+    let linkedDylibs: [String]
+    let signature: IPAAuditCodeSignature
+}
+
+/// One radar row for the device version the audit ran against.
+struct IPAAuditCVEExposure: Equatable, Codable, Sendable {
+    let entryID: String
+    let verifiedCVSS: Double?
+    let verification: IPAAuditVerification
+    let exposure: IPAAuditExposure
+    let fixedVersionNote: String
+}
+
+/// The complete audit report for one IPA file.
+struct IPAAuditReport: Equatable, Codable, Sendable {
+    let id: String
+    let auditedAt: Date
+    let scannerVersion: String
+    let fileName: String
+    let fileSize: Int
+    let fileSHA256: String
+    let bundleID: String?
+    let appName: String?
+    let appVersion: String?
+    let verdict: IPAAuditVerdict
+    let findings: [IPAAuditFinding]
+    let binaries: [IPAAuditBinaryReport]
+    let cveExposure: [IPAAuditCVEExposure]
+    let skippedFairPlayCount: Int
+    let strippedSymlinkCount: Int
+    let coverageNote: String
+
+    var highRiskFindings: [IPAAuditFinding] {
+        findings.filter { $0.severity == .highRisk }
+    }
+
+    var cautionFindings: [IPAAuditFinding] {
+        findings.filter { $0.severity == .caution }
+    }
+
+    // MARK: - JSON
+
+    func jsonData() throws -> Data {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        encoder.dateEncodingStrategy = .iso8601
+        return try encoder.encode(self)
+    }
+
+    // MARK: - Markdown
+
+    func markdown() -> String {
+        var lines: [String] = []
+        lines.append("# IPA Security Audit Report")
+        lines.append("")
+        lines.append("- File: \(fileName) (\(fileSize) bytes)")
+        lines.append("- SHA-256: \(fileSHA256)")
+        lines.append("- Bundle ID: \(bundleID ?? "Unknown")")
+        lines.append("- App: \(appName ?? "Unknown") \(appVersion ?? "")")
+        lines.append("- Verdict: \(verdict.title)")
+        lines.append("- Audited at: \(ISO8601DateFormatter().string(from: auditedAt))")
+        lines.append("- Scanner: \(scannerVersion)")
+        lines.append("")
+        lines.append("## Findings (\(findings.count))")
+        lines.append("")
+        if findings.isEmpty {
+            lines.append("No findings.")
+        } else {
+            for finding in findings {
+                lines.append("- [\(finding.severity.rawValue)] \(finding.ruleID): \(finding.title) — \(finding.location) — evidence: `\(finding.evidence)`")
+            }
+        }
+        lines.append("")
+        lines.append("## Binaries (\(binaries.count))")
+        lines.append("")
+        for binary in binaries {
+            lines.append("- \(binary.relativePath) (\(binary.architectures.joined(separator: ", ")))"
+                + (binary.wasSkipped ? " — FairPlay-encrypted, skipped" : "")
+                + (binary.hasDirectSyscall ? " — direct syscalls: \(binary.directSyscallCount)" : ""))
+            if binary.signature.isAdHoc {
+                lines.append("  - Ad-hoc signature (CS_ADHOC).")
+            }
+            if !binary.signature.hasCMSSignature {
+                lines.append("  - No CMS signature blob present. The signature chain is not verified by this scanner.")
+            }
+            if !binary.signature.appGroups.isEmpty {
+                lines.append("  - App Groups: \(binary.signature.appGroups.joined(separator: ", "))")
+            }
+            for entitlement in binary.signature.mergedEntitlements {
+                lines.append("  - Entitlement [\(entitlement.source)] \(entitlement.key)=\(entitlement.value)")
+            }
+        }
+        lines.append("")
+        lines.append("## CVE Radar (device OS version at audit time)")
+        lines.append("")
+        lines.append("Verification date: \(IPAAuditCVERadar.verificationDate). Scores are the NVD-verified CVSS 3.1 values; entries that could not be verified are marked Unverified and carry no score.")
+        lines.append("")
+        for row in cveExposure {
+            let score = row.verifiedCVSS.map { String($0) } ?? "Unverified"
+            lines.append("- \(row.entryID): \(row.exposure.title) — CVSS \(score) — \(row.verification.title) — fixed: \(row.fixedVersionNote)")
+        }
+        lines.append("")
+        lines.append("## Coverage")
+        lines.append("")
+        lines.append(coverageNote)
+        if strippedSymlinkCount > 0 {
+            lines.append("Stripped symlink entries: \(strippedSymlinkCount).")
+        }
+        lines.append("")
+        lines.append("> \(verdict.disclaimer)")
+        return lines.joined(separator: "\n")
+    }
+
+    // MARK: - Plain text
+
+    func plainText() -> String {
+        var lines: [String] = []
+        lines.append("IPA Security Audit Report")
+        lines.append("File: \(fileName) (\(fileSize) bytes)")
+        lines.append("SHA-256: \(fileSHA256)")
+        lines.append("Bundle ID: \(bundleID ?? "Unknown")")
+        lines.append("App: \(appName ?? "Unknown") \(appVersion ?? "")")
+        lines.append("Verdict: \(verdict.title)")
+        lines.append("Audited at: \(ISO8601DateFormatter().string(from: auditedAt))")
+        lines.append("Scanner: \(scannerVersion)")
+        lines.append("")
+        lines.append("Findings (\(findings.count)):")
+        if findings.isEmpty {
+            lines.append("  No findings.")
+        } else {
+            for finding in findings {
+                lines.append("  [\(finding.severity.rawValue)] \(finding.ruleID): \(finding.title)")
+                lines.append("    Location: \(finding.location)")
+                lines.append("    Evidence: \(finding.evidence)")
+            }
+        }
+        lines.append("")
+        lines.append("Binaries (\(binaries.count)):")
+        for binary in binaries {
+            lines.append("  \(binary.relativePath) (\(binary.architectures.joined(separator: ", ")))"
+                + (binary.wasSkipped ? " — FairPlay-encrypted, skipped" : ""))
+        }
+        lines.append("")
+        lines.append("CVE Radar (verification date \(IPAAuditCVERadar.verificationDate)):")
+        for row in cveExposure {
+            let score = row.verifiedCVSS.map { String($0) } ?? "Unverified"
+            lines.append("  \(row.entryID): \(row.exposure.title) — CVSS \(score) — \(row.verification.title) — fixed: \(row.fixedVersionNote)")
+        }
+        lines.append("")
+        lines.append("Coverage: \(coverageNote)")
+        if strippedSymlinkCount > 0 {
+            lines.append("Stripped symlink entries: \(strippedSymlinkCount).")
+        }
+        lines.append("")
+        lines.append(verdict.disclaimer)
+        return lines.joined(separator: "\n")
+    }
+}
diff --git a/GestaltX/IPAAuditScanner.swift b/GestaltX/IPAAuditScanner.swift
new file mode 100644
index 0000000..63c2f7a
--- /dev/null
+++ b/GestaltX/IPAAuditScanner.swift
@@ -0,0 +1,523 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// IPA Audit — secure IPA package scanner + audit engine (W3).
+//
+// Design ported from Kianuni/WQGuard v1.3.6
+// (`Sources/WQGuardCore/Engine/IPAPackageScanner.swift`, MIT,
+// Copyright (c) 2026 WQGuard Contributors) — see W3NOTICES.md:
+// ZIP / ZIP64 central-directory validation, on-demand extraction
+// of only the binaries and signatures into an isolated
+// `tmp/IPAAudit-<UUID>/` sandbox destroyed by `defer`, Zip-Slip
+// interception, symlink stripping, and 64 KB streaming chunks
+// against decompression bombs.
+//
+// This file is a fresh implementation for LilaShift. It does NOT
+// call `CustomizationArchive.extract` or any other existing
+// LilaShift unpack path: those paths are built for trusted
+// wallpaper/backup archives, and an untrusted IPA must never go
+// through them. Only the numeric size limits are shared with
+// `CustomizationFiles` (256 MB per file, 768 MB total), and the
+// ZIP reading itself uses the already-linked ZIPFoundation 0.9.21
+// (MIT) in read mode — the same library the audit report
+// (§2.3.3) records LilaShift as already using.
+//
+// Read-only with respect to the device: the scanner never writes
+// outside its own tmp sandbox, never executes the IPA, and never
+// touches another app's container.
+import Foundation
+import ZIPFoundation
+
+/// The secure IPA scanner: validates, extracts on demand, parses
+/// every Mach-O image found, matches the threat catalog, and
+/// assembles the audit report.
+enum IPAAuditScanner {
+    static let scannerVersion = "LilaShift 5.0.0 (W3)"
+    /// Per-file cap, shared with `CustomizationFiles.maximumFile`.
+    static let maxEntrySize = CustomizationFiles.maximumFile
+    /// Total extracted cap, shared with
+    /// `CustomizationFiles.maximumTotal`.
+    static let maxTotalExtracted = CustomizationFiles.maximumTotal
+    static let maxEntries = 20_000
+    /// Entries whose uncompressed size exceeds the compressed size
+    /// by more than this factor (and exceed 1 MB) are rejected as
+    /// suspected decompression bombs.
+    static let maxCompressionRatio: UInt64 = 100
+    static let chunkSize = 64 * 1024
+
+    /// Audits one IPA file. `deviceOSVersion` is the version the
+    /// CVE radar is evaluated against (the view passes the real
+    /// device version; tests pass fixed versions). `nil` means the
+    /// device version could not be determined: every radar row
+    /// then evaluates to `.unknown` instead of a guessed verdict.
+    /// `progress` receives 0.0–1.0 and a short label; `isCancelled` is polled
+    /// between entries so the view's cancel button stops the scan
+    /// promptly. The tmp sandbox is destroyed before this returns,
+    /// on success and on failure alike.
+    static func audit(
+        ipaURL: URL,
+        deviceOSVersion: IPAAuditOSVersion?,
+        progress: (Double, String) -> Void = { _, _ in },
+        isCancelled: () -> Bool = { false }
+    ) throws -> IPAAuditReport {
+        let fileSize = try validatedIPAFileSize(ipaURL)
+        let fileData = try Data(contentsOf: ipaURL, options: .mappedIfSafe)
+        let fileSHA256 = BackupEngine.sha256Hex(of: fileData)
+        let fileName = ipaURL.lastPathComponent
+
+        let sandbox = FileManager.default.temporaryDirectory
+            .appendingPathComponent("IPAAudit-\(UUID().uuidString)", isDirectory: true)
+        try FileManager.default.createDirectory(at: sandbox, withIntermediateDirectories: false)
+        defer { try? FileManager.default.removeItem(at: sandbox) }
+
+        progress(0.05, L("Opening the IPA…"))
+        let archive: Archive
+        do {
+            archive = try Archive(url: ipaURL, accessMode: .read)
+        } catch {
+            throw IPAAuditError(L("The file is not a valid ZIP/IPA archive."))
+        }
+
+        let entries = try validatedEntries(of: archive, isCancelled: isCancelled)
+        progress(0.15, L("Locating the app bundle…"))
+        guard let appDirectory = entries.appDirectory else {
+            throw IPAAuditError(L("No Payload/*.app bundle was found in the IPA."))
+        }
+
+        let mainInfo = try extractMainInfoPlist(archive: archive, entries: entries, appDirectory: appDirectory, sandbox: sandbox)
+        progress(0.25, L("Scanning binaries…"))
+
+        var findings: [IPAAuditFinding] = []
+        var binaryReports: [IPAAuditBinaryReport] = []
+        var skippedFairPlayCount = 0
+        let strippedSymlinkCount = entries.strippedSymlinkCount
+        if !entries.escapingSymlinks.isEmpty {
+            for target in entries.escapingSymlinks {
+                findings.append(IPAAuditFinding(
+                    ruleID: "ESCAPING_SYMLINK",
+                    title: "Escaping symlink in the IPA",
+                    detail: "A symlink entry points outside the package. It was stripped, never followed.",
+                    severity: .highRisk,
+                    location: "IPA entries",
+                    evidence: String(target.prefix(128)),
+                    relatedCVE: nil))
+            }
+        }
+
+        let candidates = binaryCandidates(entries: entries, appDirectory: appDirectory, mainExecutable: mainInfo.executableName)
+        var extractedTotal: UInt64 = 0
+        for (index, candidate) in candidates.enumerated() {
+            if isCancelled() { throw IPAAuditError(L("The scan was cancelled.")) }
+            progress(0.25 + 0.65 * Double(index) / Double(max(candidates.count, 1)), L("Scanning") + " \(candidate.entry.path)…")
+            let extracted = try extractEntry(
+                archive: archive, entry: candidate.entry, into: sandbox,
+                alreadyExtracted: extractedTotal)
+            extractedTotal += extracted.byteCount
+            let binaryReport = try auditBinary(
+                at: extracted.url, relativePath: candidate.entry.path,
+                findings: &findings, skippedFairPlayCount: &skippedFairPlayCount)
+            binaryReports.append(binaryReport)
+        }
+
+        if binaryReports.isEmpty {
+            throw IPAAuditError(L("No Mach-O binary was found in the app bundle."))
+        }
+
+        let bundleID = mainInfo.bundleID
+        let verdict = IPAAuditThreatCatalog.verdict(findings: findings, bundleID: bundleID)
+        let cveExposure = IPAAuditCVERadar.entries.map { entry in
+            IPAAuditCVEExposure(
+                entryID: entry.id,
+                verifiedCVSS: entry.verifiedCVSS,
+                verification: entry.verification,
+                exposure: deviceOSVersion.map { IPAAuditCVERadar.exposure(of: entry, for: $0) } ?? .unknown,
+                fixedVersionNote: entry.fixedVersionNote)
+        }
+        progress(1.0, L("Done"))
+        return IPAAuditReport(
+            id: UUID().uuidString,
+            auditedAt: Date(),
+            scannerVersion: scannerVersion,
+            fileName: fileName,
+            fileSize: fileSize,
+            fileSHA256: fileSHA256,
+            bundleID: bundleID,
+            appName: mainInfo.appName,
+            appVersion: mainInfo.appVersion,
+            verdict: verdict,
+            findings: findings,
+            binaries: binaryReports,
+            cveExposure: cveExposure,
+            skippedFairPlayCount: skippedFairPlayCount,
+            strippedSymlinkCount: strippedSymlinkCount,
+            coverageNote: coverageNote(
+                skippedFairPlayCount: skippedFairPlayCount,
+                bundleID: bundleID))
+    }
+
+    // MARK: - IPA validation
+
+    private static func validatedIPAFileSize(_ url: URL) throws -> Int {
+        let values = try url.resourceValues(forKeys: [.isRegularFileKey, .fileSizeKey])
+        guard values.isRegularFile == true,
+              let size = values.fileSize, size > 0, size <= maxEntrySize else {
+            throw IPAAuditError(L("The IPA is invalid or exceeds the size limit."))
+        }
+        return size
+    }
+
+    /// The validated entry list: safe relative paths, no
+    /// duplicates, per-entry and total size caps, compression-ratio
+    /// bomb check. Symlink entries are stripped (never followed):
+    /// escaping targets become findings, the rest are counted.
+    private struct ValidatedEntries {
+        let appDirectory: String?
+        let all: [Archive.Entry]
+        let strippedSymlinkCount: Int
+        let escapingSymlinks: [String]
+    }
+
+    private static func validatedEntries(of archive: Archive, isCancelled: () -> Bool) throws -> ValidatedEntries {
+        var all: [Archive.Entry] = []
+        var seen = Set<String>()
+        var appDirectory: String?
+        var strippedSymlinks = 0
+        var escapingSymlinks: [String] = []
+        var expectedTotal: UInt64 = 0
+        var count = 0
+        for entry in archive {
+            if isCancelled() { throw IPAAuditError(L("The scan was cancelled.")) }
+            count += 1
+            guard count <= maxEntries else {
+                throw IPAAuditError(L("The IPA contains too many entries."))
+            }
+            guard entry.type != .directory else { continue }
+            let path = entry.path
+            _ = try safeRelativePath(path)
+            let normalized = path.precomposedStringWithCanonicalMapping.lowercased()
+            guard seen.insert(normalized).inserted else {
+                throw IPAAuditError(L("The IPA contains duplicate entries."))
+            }
+            guard entry.uncompressedSize <= UInt64(maxEntrySize) else {
+                throw IPAAuditError(L("An entry in the IPA exceeds the size limit."))
+            }
+            if entry.uncompressedSize > 1_048_576, entry.compressedSize > 0,
+               entry.uncompressedSize / entry.compressedSize > maxCompressionRatio {
+                throw IPAAuditError(L("An entry in the IPA looks like a decompression bomb."))
+            }
+            expectedTotal += entry.uncompressedSize
+            guard expectedTotal <= UInt64(maxTotalExtracted) else {
+                throw IPAAuditError(L("The IPA would extract to more than the size limit."))
+            }
+            if entry.type == .symlink {
+                strippedSymlinks += 1
+                if let target = try? readSymlinkTarget(archive: archive, entry: entry),
+                   isEscapingSymlinkTarget(target) {
+                    escapingSymlinks.append(target)
+                }
+                continue
+            }
+            all.append(entry)
+            if appDirectory == nil {
+                let parts = path.split(separator: "/")
+                if parts.count >= 2, parts[0] == "Payload", parts[1].hasSuffix(".app") {
+                    appDirectory = "Payload/\(parts[1])"
+                }
+            }
+        }
+        guard count > 0 else {
+            throw IPAAuditError(L("The IPA contains no entries."))
+        }
+        return ValidatedEntries(
+            appDirectory: appDirectory, all: all,
+            strippedSymlinkCount: strippedSymlinks, escapingSymlinks: escapingSymlinks)
+    }
+
+    /// A relative path inside the package: no leading slash, no
+    /// backslash, no NUL, no empty / "." / ".." components.
+    static func safeRelativePath(_ path: String) throws -> String {
+        let parts = path.split(separator: "/", omittingEmptySubsequences: false)
+        guard !path.isEmpty, !path.hasPrefix("/"), !path.contains("\\"), !path.contains("\0"),
+              parts.allSatisfy({ !$0.isEmpty && $0 != "." && $0 != ".." }),
+              path.utf8.count < 1_024 else {
+            throw IPAAuditError(L("The IPA contains an unsafe entry path."))
+        }
+        return path
+    }
+
+    /// Resolves a safe relative path under `root`, refusing to
+    /// escape it even through a pre-existing symlink on disk.
+    private static func checkedTarget(_ relativePath: String, in root: URL) throws -> URL {
+        let path = try safeRelativePath(relativePath)
+        var next = root
+        for part in path.split(separator: "/") {
+            next.appendPathComponent(String(part))
+            let values = try? next.resourceValues(forKeys: [.isSymbolicLinkKey])
+            if values?.isSymbolicLink == true {
+                throw IPAAuditError(L("The IPA contains an unsafe entry path."))
+            }
+        }
+        guard next.standardizedFileURL.path.hasPrefix(root.standardizedFileURL.path) else {
+            throw IPAAuditError(L("The IPA contains an unsafe entry path."))
+        }
+        return next
+    }
+
+    private static func readSymlinkTarget(archive: Archive, entry: Archive.Entry) throws -> String {
+        var bytes = Data()
+        _ = try archive.extract(entry, bufferSize: 1_024) { chunk in
+            bytes.append(chunk)
+            guard bytes.count <= 1_024 else {
+                throw IPAAuditError(L("The IPA contains an unsafe entry path."))
+            }
+        }
+        return String(bytes: bytes, encoding: .utf8) ?? ""
+    }
+
+    private static func isEscapingSymlinkTarget(_ target: String) -> Bool {
+        target.hasPrefix("/") || target.split(separator: "/").contains("..")
+    }
+
+    // MARK: - Info.plist
+
+    private struct MainInfo {
+        let bundleID: String?
+        let appName: String?
+        let appVersion: String?
+        let executableName: String?
+    }
+
+    private static func extractMainInfoPlist(
+        archive: Archive, entries: ValidatedEntries, appDirectory: String, sandbox: URL
+    ) throws -> MainInfo {
+        let plistPath = "\(appDirectory)/Info.plist"
+        guard let entry = entries.all.first(where: { $0.path == plistPath }) else {
+            return MainInfo(bundleID: nil, appName: nil, appVersion: nil, executableName: nil)
+        }
+        let extractedPlist = try extractEntry(archive: archive, entry: entry, into: sandbox, alreadyExtracted: 0)
+        let url = extractedPlist.url
+        let data = try Data(contentsOf: url)
+        guard let plist = try? PropertyListSerialization.propertyList(from: data, options: [], format: nil),
+              let dict = plist as? [String: Any] else {
+            return MainInfo(bundleID: nil, appName: nil, appVersion: nil, executableName: nil)
+        }
+        let bundleID = dict["CFBundleIdentifier"] as? String
+        let appName = (dict["CFBundleDisplayName"] as? String) ?? (dict["CFBundleName"] as? String)
+        let appVersion = dict["CFBundleShortVersionString"] as? String
+        let executableName = dict["CFBundleExecutable"] as? String
+        return MainInfo(bundleID: bundleID, appName: appName, appVersion: appVersion, executableName: executableName)
+    }
+
+    // MARK: - Binary candidates
+
+    private struct BinaryCandidate {
+        let entry: Archive.Entry
+    }
+
+    /// On-demand candidate list: the main executable, every
+    /// `.framework` binary, every `.appex` binary, and every
+    /// `.dylib` under the app bundle. Nothing else is extracted:
+    /// assets, storyboards and strings files are never read.
+    private static func binaryCandidates(
+        entries: ValidatedEntries, appDirectory: String, mainExecutable: String?
+    ) -> [BinaryCandidate] {
+        var candidates: [Archive.Entry] = []
+        var seen = Set<String>()
+        func add(_ entry: Archive.Entry) {
+            if seen.insert(entry.path).inserted { candidates.append(entry) }
+        }
+        let prefix = appDirectory + "/"
+        for entry in entries.all where entry.path.hasPrefix(prefix) {
+            let relative = String(entry.path.dropFirst(prefix.count))
+            let parts = relative.split(separator: "/").map(String.init)
+            guard let first = parts.first else { continue }
+            if first == "Frameworks", parts.count == 3, parts[1].hasSuffix(".framework"),
+               parts[2] == parts[1].dropSuffix(".framework") {
+                add(entry)
+            } else if first == "PlugIns", parts.count == 3, parts[1].hasSuffix(".appex"),
+                      parts[2] == parts[1].dropSuffix(".appex") {
+                add(entry)
+            } else if relative.hasSuffix(".dylib") {
+                add(entry)
+            } else if let mainExecutable, parts.count == 1, first == mainExecutable {
+                add(entry)
+            } else if parts.count == 1, first == (appDirectory as NSString).lastPathComponent.dropSuffix(".app") {
+                // Fallback when Info.plist is missing: the file at
+                // the app root named after the bundle.
+                add(entry)
+            }
+        }
+        return candidates.map { BinaryCandidate(entry: $0) }
+    }
+
+    // MARK: - Streaming extraction
+
+    /// Extracts one entry into the sandbox with 64 KB streaming
+    /// chunks, verifying the CRC-32 and the extracted byte count.
+    /// `alreadyExtracted` is the byte total of earlier entries, so
+    /// the cap is enforced across entries, not just per entry.
+    /// Returns the extracted file and its byte count.
+    private static func extractEntry(
+        archive: Archive, entry: Archive.Entry, into sandbox: URL, alreadyExtracted: UInt64
+    ) throws -> (url: URL, byteCount: UInt64) {
+        let target = try checkedTarget(entry.path, in: sandbox)
+        try FileManager.default.createDirectory(
+            at: target.deletingLastPathComponent(), withIntermediateDirectories: true)
+        guard FileManager.default.createFile(atPath: target.path, contents: nil) else {
+            throw IPAAuditError(L("The IPA could not be extracted."))
+        }
+        let handle = try FileHandle(forWritingTo: target)
+        var extracted: UInt64 = 0
+        do {
+            let crc = try archive.extract(entry, bufferSize: chunkSize) { chunk in
+                extracted += UInt64(chunk.count)
+                guard extracted <= UInt64(maxEntrySize),
+                      extracted + alreadyExtracted <= UInt64(maxTotalExtracted) else {
+                    throw IPAAuditError(L("The IPA would extract to more than the size limit."))
+                }
+                try handle.write(contentsOf: chunk)
+            }
+            try handle.close()
+            guard crc == entry.checksum, extracted == entry.uncompressedSize else {
+                throw IPAAuditError(L("An entry in the IPA failed its checksum."))
+            }
+        } catch {
+            try? handle.close()
+            try? FileManager.default.removeItem(at: target)
+            throw error
+        }
+        return (target, extracted)
+    }
+
+    // MARK: - Per-binary audit
+
+    private static func auditBinary(
+        at url: URL, relativePath: String,
+        findings: inout [IPAAuditFinding], skippedFairPlayCount: inout Int
+    ) throws -> IPAAuditBinaryReport {
+        let data = try Data(contentsOf: url, options: .mappedIfSafe)
+        let slices = try IPAAuditMachOParser.parse(data)
+
+        var linkedDylibs: [String] = []
+        var symbols: [String] = []
+        var strings: [String] = []
+        var architectures: [String] = []
+        var hasDirectSyscall = false
+        var directSyscallCount = 0
+        var allFairPlayEncrypted = true
+        var mergedEntitlements: [String: Any] = [:]
+        var xmlKeys = Set<String>()
+        var derKeys = Set<String>()
+        var isAdHoc = false
+        var hasCMSSignature = false
+        var codeDirectoryIdent: String?
+        var hasXMLEntitlements = false
+        var hasDEREntitlements = false
+
+        for slice in slices {
+            architectures.append(slice.architecture)
+            linkedDylibs.append(contentsOf: slice.linkedDylibs.filter { !linkedDylibs.contains($0) })
+            symbols.append(contentsOf: slice.symbols.filter { !symbols.contains($0) })
+            strings.append(contentsOf: slice.cstrings.filter { !strings.contains($0) })
+            strings.append(contentsOf: slice.objcSelectors.filter { !strings.contains($0) })
+            hasDirectSyscall = hasDirectSyscall || slice.hasDirectSyscall
+            directSyscallCount += slice.directSyscallCount
+            if !slice.isFairPlayEncrypted { allFairPlayEncrypted = false }
+            guard let signatureData = slice.codeSignature else { continue }
+            do {
+                let slots = try IPAAuditCSBlobParser.parseDictionaries(signatureData)
+                hasXMLEntitlements = hasXMLEntitlements || slots.xml != nil
+                hasDEREntitlements = hasDEREntitlements || slots.der != nil
+                isAdHoc = isAdHoc || slots.isAdHoc
+                hasCMSSignature = hasCMSSignature || slots.hasCMSSignature
+                codeDirectoryIdent = codeDirectoryIdent ?? slots.codeDirectoryIdent
+                // Merge this slice's XML+DER dictionaries (DER
+                // wins within the slice) into the binary-wide
+                // merge with the anti-shadowing rules, so a second
+                // fat slice cannot hide a privilege.
+                let sliceMerged = IPAAuditCSBlobParser.mergeEntitlementDictionaries(
+                    slots.xml ?? [:], slots.der ?? [:])
+                mergedEntitlements = IPAAuditCSBlobParser.mergeEntitlementDictionaries(
+                    mergedEntitlements, sliceMerged)
+                xmlKeys.formUnion(slots.xml?.keys ?? [])
+                derKeys.formUnion(slots.der?.keys ?? [])
+            } catch {
+                // A malformed signature blob is evidence, not a
+                // reason to stop the whole scan: record it and
+                // keep auditing the binary's code.
+                findings.append(IPAAuditFinding(
+                    ruleID: "SIGNATURE_MALFORMED",
+                    title: "Malformed code signature",
+                    detail: "The LC_CODE_SIGNATURE blob could not be parsed: \(error.localizedDescription)",
+                    severity: .caution,
+                    location: relativePath,
+                    evidence: "LC_CODE_SIGNATURE",
+                    relatedCVE: nil))
+            }
+        }
+
+        let renderedEntitlements = IPAAuditCSBlobParser.renderEntitlements(
+            mergedEntitlements, xmlKeys: xmlKeys, derKeys: derKeys)
+        let signature = IPAAuditCodeSignature(
+            hasXMLEntitlements: hasXMLEntitlements,
+            hasDEREntitlements: hasDEREntitlements,
+            mergedEntitlements: renderedEntitlements,
+            appGroups: (mergedEntitlements[IPAAuditCSBlobParser.appGroupsKey] as? [String]) ?? [],
+            codeDirectoryIdent: codeDirectoryIdent,
+            isAdHoc: isAdHoc,
+            hasCMSSignature: hasCMSSignature)
+
+        let wasSkipped = allFairPlayEncrypted && !slices.isEmpty
+        if wasSkipped {
+            skippedFairPlayCount += 1
+            findings.append(IPAAuditFinding(
+                ruleID: "FAIRPLAY_ENCRYPTED_SKIPPED",
+                title: "FairPlay-encrypted binary skipped",
+                detail: "The __TEXT segment is FairPlay-encrypted (cryptid != 0), so static analysis of this binary was skipped. The verdict does not cover it.",
+                severity: .caution,
+                location: relativePath,
+                evidence: "LC_ENCRYPTION_INFO cryptid != 0",
+                relatedCVE: nil))
+        } else {
+            let matched = IPAAuditThreatCatalog.match(
+                dylibs: linkedDylibs, symbols: symbols, strings: strings,
+                entitlements: renderedEntitlements)
+            for finding in matched {
+                findings.append(IPAAuditFinding(
+                    ruleID: finding.ruleID, title: finding.title, detail: finding.detail,
+                    severity: finding.severity, location: "\(relativePath) · \(finding.location)",
+                    evidence: finding.evidence, relatedCVE: finding.relatedCVE))
+            }
+        }
+
+        return IPAAuditBinaryReport(
+            relativePath: relativePath,
+            architectures: architectures,
+            isFat: slices.first?.isFat ?? false,
+            isFairPlayEncrypted: allFairPlayEncrypted,
+            wasSkipped: wasSkipped,
+            hasDirectSyscall: hasDirectSyscall,
+            directSyscallCount: directSyscallCount,
+            linkedDylibs: Array(linkedDylibs.prefix(200)),
+            signature: signature)
+    }
+
+    private static func coverageNote(
+        skippedFairPlayCount: Int, bundleID: String?
+    ) -> String {
+        var parts: [String] = []
+        if skippedFairPlayCount > 0 {
+            parts.append(L("FairPlay-encrypted binaries were skipped, so the verdict does not cover them."))
+        }
+        if let bundleID, IPAAuditThreatCatalog.trustedBundleIDs.contains(bundleID) {
+            parts.append(L("This is a LilaShift build. Rule needles are stored as plain strings in this app, so scanning LilaShift's own IPA can match string rules from the catalog itself; dylib and symbol rules cannot match that way."))
+        }
+        parts.append(L("Static analysis only reports what was found in this binary. It cannot prove an app is safe."))
+        return parts.joined(separator: " ")
+    }
+}
+
+private extension String {
+    /// Drops `suffix` when present, e.g. "Foo.framework" → "Foo".
+    func dropSuffix(_ suffix: String) -> String {
+        hasSuffix(suffix) ? String(dropLast(suffix.count)) : self
+    }
+}
