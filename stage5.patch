diff --git a/GestaltX/AdvAISlotRestore.swift b/GestaltX/AdvAISlotRestore.swift
new file mode 100644
index 0000000..58cc1fe
--- /dev/null
+++ b/GestaltX/AdvAISlotRestore.swift
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import Foundation
+
+/// Restores the two AdvAI CacheData slots (#178/#266) in a working
+/// document to the values recorded in a snapshot (Stage 5, ADR-2-02).
+///
+/// The guards mirror `fixAIBaseline`: an original that cannot be
+/// parsed is skipped, never guessed; an original equal to the current
+/// value is skipped (no false diff); a write error is reported as a
+/// failed outcome and does not stop the other slot. This helper is
+/// the single place that writes slots back — both one-tap restore
+/// paths (`restoreChinaUnlock`, `restoreChinaAIOnly`) call it, so the
+/// two paths cannot drift apart.
+///
+/// `layout` is the explicit layout for tests; production passes `nil`
+/// and each slot read resolves the layout from the documents.
+enum AdvAISlotRestore {
+    enum Outcome: Equatable, Sendable {
+        /// The slot was written back to its recorded original.
+        case restored(key: String, original: Bool)
+        /// The original equals the current value: nothing to do.
+        case skippedUnchanged(key: String)
+        /// The original or the current value could not be parsed
+        /// (unresolvable layout or invalid bytes): left alone.
+        case skippedUnresolvable(key: String)
+        /// The write threw: the reason is logged by the caller and
+        /// the other slot is still attempted.
+        case failed(key: String, reason: String)
+
+        var isRestored: Bool {
+            if case .restored = self { return true }
+            return false
+        }
+    }
+
+    static func restore(in document: inout GestaltDocument, from snapshot: GestaltDocument,
+                        using layout: MobileGestaltCacheLayout? = nil) -> [Outcome] {
+        var outcomes: [Outcome] = []
+        for key in [DeviceCacheOptions.personalTranslatorKey, DeviceCacheOptions.audioIntelligenceKey] {
+            guard let original = DeviceCacheOptions.advAISlotValue(key, in: snapshot, using: layout) else {
+                outcomes.append(.skippedUnresolvable(key: key))
+                continue
+            }
+            guard let current = DeviceCacheOptions.advAISlotValue(key, in: document, using: layout) else {
+                outcomes.append(.skippedUnresolvable(key: key))
+                continue
+            }
+            guard original != current else {
+                outcomes.append(.skippedUnchanged(key: key))
+                continue
+            }
+            do {
+                try document.setAdvAISlot(key, value: original, using: layout)
+                outcomes.append(.restored(key: key, original: original))
+            } catch {
+                outcomes.append(.failed(key: key, reason: error.localizedDescription))
+            }
+        }
+        return outcomes
+    }
+}
diff --git a/GestaltX/BackupEngine.swift b/GestaltX/BackupEngine.swift
new file mode 100644
index 0000000..abe3be2
--- /dev/null
+++ b/GestaltX/BackupEngine.swift
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Backup engine (Stage 5, ADR-2-08): the single owner of backup
+// creation and of SHA-256 in the app.
+//
+// - SHA-256: `sha256Hex(of:)` is the ONE implementation. Every other
+//   digest call in the app delegates to it (`GestaltFileStore`,
+//   `HistoryJournal`, `CustomizationFiles`, `SystemSettingsStore`),
+//   so a digest can never silently disagree between two call sites.
+// - Pre-write backup: `createPreWriteBackup` is the AppCore
+//   orchestration entry point for the §3.4 rule — never write
+//   without a fresh backup first. The caller passes the record to
+//   `GestaltFileStore.commit(preWriteBackup:)`; commit verifies the
+//   record covers the pre-write bytes and skips its internal backup
+//   (no double backup). When no record is supplied, commit still
+//   creates the backup itself, so the rule holds on every path.
+import CryptoKit
+import Foundation
+
+enum BackupEngine {
+    /// The canonical SHA-256 hex digest. The only implementation in
+    /// the app; all other digest helpers delegate here.
+    static func sha256Hex(of data: Data) -> String {
+        SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+    }
+
+    /// Creates a fresh pre-write backup of the snapshot's current
+    /// state through the store and returns its record. `reason` is
+    /// the device-write reason ("Before applying" /
+    /// "Before restoring"); a locally opened file always records
+    /// "Before editing" with `.importedHistory` provenance, matching
+    /// what `commit` used to do internally. The store verifies the
+    /// backup by read-back before returning, so a returned record
+    /// always covers bytes that are on disk.
+    static func createPreWriteBackup(store: GestaltFileStore,
+                                     snapshot: DocumentSnapshot,
+                                     reason: String) async throws -> BackupRecord {
+        try await store.createPreWriteBackup(snapshot, reason: reason)
+    }
+}
