diff --git a/GestaltX/W9WallpaperStudio.swift b/GestaltX/W9WallpaperStudio.swift
new file mode 100644
index 0000000..9c4fa59
--- /dev/null
+++ b/GestaltX/W9WallpaperStudio.swift
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import CoreGraphics
+import Foundation
+import ImageIO
+import UniformTypeIdentifiers
+
+enum W9WallpaperStudio {
+    enum Layer: Equatable, Sendable { case background, foreground }
+    enum Failure: Error, Equatable { case unreadable, tooLarge, unsupportedImage, renderFailed }
+
+    static let sourceByteLimit = 20 * 1_024 * 1_024
+
+    static func loadImage(at url: URL, for layer: Layer) throws -> CGImage {
+        let scoped = url.startAccessingSecurityScopedResource()
+        defer { if scoped { url.stopAccessingSecurityScopedResource() } }
+        let data = try readBounded(url)
+        guard let source = CGImageSourceCreateWithData(data as CFData, nil),
+              CGImageSourceGetCount(source) == 1,
+              let identifier = CGImageSourceGetType(source),
+              let type = UTType(identifier as String),
+              (layer == .foreground ? type == .png : [.png, .jpeg, .heic].contains(type)),
+              let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [CFString: Any],
+              let width = properties[kCGImagePropertyPixelWidth] as? Int,
+              let height = properties[kCGImagePropertyPixelHeight] as? Int,
+              (1...16_000).contains(width), (1...16_000).contains(height),
+              width * height <= 64_000_000 else { throw Failure.unsupportedImage }
+
+        let settings: [CFString: Any] = [
+            kCGImageSourceCreateThumbnailFromImageAlways: true,
+            kCGImageSourceCreateThumbnailWithTransform: true,
+            kCGImageSourceThumbnailMaxPixelSize: 2_048,
+            kCGImageSourceShouldCacheImmediately: true
+        ]
+        guard let image = CGImageSourceCreateThumbnailAtIndex(source, 0, settings as CFDictionary) else {
+            throw Failure.unsupportedImage
+        }
+        if layer == .foreground {
+            switch image.alphaInfo {
+            case .premultipliedFirst, .premultipliedLast, .first, .last: break
+            default: throw Failure.unsupportedImage
+            }
+        }
+        return image
+    }
+
+    private static func readBounded(_ url: URL) throws -> Data {
+        do {
+            let file = try FileHandle(forReadingFrom: url)
+            defer { try? file.close() }
+            var buffer = Data()
+            while buffer.count <= sourceByteLimit {
+                let count = min(65_536, sourceByteLimit + 1 - buffer.count)
+                guard let chunk = try file.read(upToCount: count), !chunk.isEmpty else { return buffer }
+                buffer.append(chunk)
+            }
+            throw Failure.tooLarge
+        } catch let failure as Failure {
+            throw failure
+        } catch {
+            throw Failure.unreadable
+        }
+    }
+
+    /// The background fills the canvas with a horizontal margin for movement.
+    /// Foreground fits inside an 80% box and moves in the opposite direction.
+    static func placement(
+        background: CGSize, foreground: CGSize?, canvas: CGSize, shift: Double
+    ) -> (background: CGRect, foreground: CGRect?) {
+        let clamped = shift.isFinite ? max(-1, min(1, shift)) : 0
+        let amount = CGFloat(clamped)
+        let pad = canvas.width * 0.04
+        let scale = max((canvas.width + pad * 2) / background.width, canvas.height / background.height)
+        let backgroundRect = centered(background, scale: scale, canvas: canvas, dx: -pad * amount)
+        let foregroundRect = foreground.map { size in
+            let fit = min(canvas.width * 0.8 / size.width, canvas.height * 0.8 / size.height)
+            return centered(size, scale: fit, canvas: canvas, dx: canvas.width * 0.09 * amount)
+        }
+        return (backgroundRect, foregroundRect)
+    }
+
+    private static func centered(_ size: CGSize, scale: CGFloat, canvas: CGSize, dx: CGFloat) -> CGRect {
+        let w = size.width * scale
+        let h = size.height * scale
+        return CGRect(x: (canvas.width - w) / 2 + dx, y: (canvas.height - h) / 2, width: w, height: h)
+    }
+
+    static func render(
+        background: CGImage, foreground: CGImage?, shift: Double, exporting: Bool
+    ) throws -> CGImage {
+        let width = exporting ? 1_080 : 270
+        let height = exporting ? 1_920 : 480
+        guard let space = CGColorSpace(name: CGColorSpace.sRGB),
+              let context = CGContext(
+                data: nil, width: width, height: height, bitsPerComponent: 8, bytesPerRow: 0,
+                space: space, bitmapInfo: CGImageAlphaInfo.noneSkipLast.rawValue
+              ) else { throw Failure.renderFailed }
+        let canvas = CGSize(width: CGFloat(width), height: CGFloat(height))
+        let images = placement(
+            background: CGSize(width: CGFloat(background.width), height: CGFloat(background.height)),
+            foreground: foreground.map { CGSize(width: CGFloat($0.width), height: CGFloat($0.height)) },
+            canvas: canvas, shift: shift
+        )
+        context.setFillColor(CGColor(gray: 0, alpha: 1))
+        context.fill(CGRect(origin: .zero, size: canvas))
+        context.interpolationQuality = .high
+        context.draw(background, in: images.background)
+        if let foreground, let rect = images.foreground { context.draw(foreground, in: rect) }
+        guard let image = context.makeImage() else { throw Failure.renderFailed }
+        return image
+    }
+
+    static func png(background: CGImage, foreground: CGImage?, shift: Double) throws -> Data {
+        let image = try render(background: background, foreground: foreground, shift: shift, exporting: true)
+        let data = NSMutableData()
+        guard let destination = CGImageDestinationCreateWithData(data as CFMutableData, UTType.png.identifier as CFString, 1, nil) else {
+            throw Failure.renderFailed
+        }
+        CGImageDestinationAddImage(destination, image, nil)
+        guard CGImageDestinationFinalize(destination) else { throw Failure.renderFailed }
+        return data as Data
+    }
+}
diff --git a/GestaltX/W9WallpaperStudioView.swift b/GestaltX/W9WallpaperStudioView.swift
new file mode 100644
index 0000000..fade67e
--- /dev/null
+++ b/GestaltX/W9WallpaperStudioView.swift
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import CoreGraphics
+import SwiftUI
+import UniformTypeIdentifiers
+
+@MainActor
+struct W9WallpaperStudioView: View {
+    @State private var inputLayer = W9WallpaperStudio.Layer.background
+    @State private var isChoosing = false
+    @State private var request: FileRequest?
+    @State private var background: LayerImage?
+    @State private var foreground: LayerImage?
+    @State private var shift = 0.0
+    @State private var preview: CGImage?
+    @State private var isRendering = false
+    @State private var isExporting = false
+    @State private var document: PNGDocument?
+    @State private var status: String?
+
+    private struct LayerImage: Identifiable {
+        let id = UUID()
+        let value: CGImage
+    }
+
+    private struct FileRequest: Identifiable, Sendable {
+        let id = UUID()
+        let url: URL
+        let layer: W9WallpaperStudio.Layer
+    }
+
+    private struct PreviewKey: Equatable {
+        let background: UUID?
+        let foreground: UUID?
+        let shift: Double
+    }
+
+    private struct PNGDocument: FileDocument {
+        static var readableContentTypes: [UTType] { [.png] }
+        let bytes: Data
+
+        init(_ bytes: Data) { self.bytes = bytes }
+
+        init(configuration: ReadConfiguration) throws {
+            guard let bytes = configuration.file.regularFileContents else { throw CocoaError(.fileReadCorruptFile) }
+            self.bytes = bytes
+        }
+
+        func fileWrapper(configuration: WriteConfiguration) throws -> FileWrapper {
+            FileWrapper(regularFileWithContents: bytes)
+        }
+    }
+
+    static var title: String { String(localized: "Parallax Wallpaper Studio", table: "W9Studio") }
+
+    var body: some View {
+        List {
+            Section {
+                Button { choose(.background) } label: { Label(label("Choose Background"), systemImage: "photo") }
+                Button { choose(.foreground) } label: { Label(label("Choose PNG Foreground"), systemImage: "square.stack") }
+                    .disabled(background == nil)
+                if foreground != nil {
+                    Button(label("Remove Foreground")) {
+                        foreground = nil
+                        shift = 0
+                    }
+                }
+            } footer: {
+                Text("Use a JPG, PNG, or HEIC background and an optional PNG with transparency. Images stay on this device.", tableName: "W9Studio")
+            }
+            .disabled(isRendering || request != nil)
+
+            if let preview {
+                Section {
+                    Image(decorative: preview, scale: 1)
+                        .resizable()
+                        .scaledToFit()
+                        .frame(maxHeight: 260)
+                        .frame(maxWidth: .infinity)
+                        .accessibilityHidden(true)
+                    if foreground != nil {
+                        Slider(value: $shift, in: -1...1, step: 0.02) {
+                            Text("Horizontal Framing", tableName: "W9Studio")
+                        }
+                        if shift != 0 {
+                            Button(label("Center Layers")) { shift = 0 }
+                        }
+                    }
+                }
+            }
+
+            Section {
+                if request != nil || isRendering { ProgressView() }
+                Button { exportPNG() } label: {
+                    Label(label("Save PNG to Files"), systemImage: "square.and.arrow.up")
+                }
+                .disabled(background == nil || request != nil || isRendering)
+                if let status { Text(status).foregroundStyle(.secondary) }
+            } footer: {
+                Text("Exports a static 1080 × 1920 PNG. It does not set your wallpaper or create a Live Photo.", tableName: "W9Studio")
+            }
+        }
+        .navigationTitle(Self.title)
+        .fileImporter(
+            isPresented: $isChoosing,
+            allowedContentTypes: inputLayer == .foreground ? [.png] : [.jpeg, .png, .heic]
+        ) { result in
+            switch result {
+            case .success(let url):
+                request = .init(url: url, layer: inputLayer)
+                status = nil
+            case .failure:
+                status = label("Could not open this image.")
+            }
+        }
+        .task(id: request?.id) {
+            guard let selected = request else { return }
+            let result = await Task.detached(priority: .userInitiated) {
+                Result { try W9WallpaperStudio.loadImage(at: selected.url, for: selected.layer) }
+            }.value
+            guard !Task.isCancelled, request?.id == selected.id else { return }
+            request = nil
+            switch result {
+            case .success(let image):
+                if selected.layer == .background { background = .init(value: image) }
+                else { foreground = .init(value: image) }
+            case .failure(let error):
+                status = message(error as? W9WallpaperStudio.Failure)
+            }
+        }
+        .task(id: PreviewKey(background: background?.id, foreground: foreground?.id, shift: shift)) {
+            guard let background else { return }
+            preview = try? W9WallpaperStudio.render(
+                background: background.value, foreground: foreground?.value, shift: shift, exporting: false
+            )
+        }
+        .fileExporter(
+            isPresented: $isExporting, document: document, contentType: .png, defaultFilename: "LilaShift-Wallpaper"
+        ) { result in
+            document = nil
+            switch result {
+            case .success: status = label("PNG saved.")
+            case .failure: status = label("Could not save PNG.")
+            }
+        }
+    }
+
+    private func choose(_ layer: W9WallpaperStudio.Layer) {
+        inputLayer = layer
+        isChoosing = true
+    }
+
+    private func exportPNG() {
+        guard let background = background?.value else { return }
+        let overlay = foreground?.value
+        let framing = shift
+        isRendering = true
+        status = nil
+        Task {
+            let result = await Task.detached(priority: .userInitiated) {
+                Result { try W9WallpaperStudio.png(background: background, foreground: overlay, shift: framing) }
+            }.value
+            isRendering = false
+            switch result {
+            case .success(let data):
+                document = PNGDocument(data)
+                isExporting = true
+            case .failure:
+                status = label("Could not render PNG.")
+            }
+        }
+    }
+
+    private func label(_ key: String.LocalizationValue) -> String {
+        String(localized: key, table: "W9Studio")
+    }
+
+    private func message(_ issue: W9WallpaperStudio.Failure?) -> String {
+        switch issue {
+        case .tooLarge: label("This image exceeds 20 MiB.")
+        case .unsupportedImage: label("The image format, dimensions, or foreground alpha channel are not supported.")
+        case .renderFailed: label("Could not render PNG.")
+        case .unreadable, nil: label("Could not open this image.")
+        }
+    }
+}
