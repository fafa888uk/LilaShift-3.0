diff --git a/GestaltX/LocalPlistWorkspace.swift b/GestaltX/LocalPlistWorkspace.swift
new file mode 100644
index 0000000..4747620
--- /dev/null
+++ b/GestaltX/LocalPlistWorkspace.swift
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import CryptoKit
+import Foundation
+
+/// A local copy only. No stored path points back to the imported source or to a system file.
+struct LocalPlistWorkspace {
+    enum Failure: Error, Equatable {
+        case unsupportedFile, tooLarge, notDictionary, staleRevision, damagedRecord, noChange
+    }
+
+    struct Record: Codable, Identifiable, Equatable, Sendable {
+        let id: UUID
+        let name: String
+        let original: Data
+        let originalSHA: String
+        var working: Data
+        var workingSHA: String
+        var previous: Data? = nil
+        var previousSHA: String? = nil
+    }
+
+    struct Change: Equatable {
+        let recordID: UUID
+        let beforeSHA: String
+        let afterSHA: String
+        let changedKeys: [String]
+        let bytes: Data
+    }
+
+    static let maxBytes = 1_048_576
+    let root: URL
+
+    static func readSelectedFile(_ url: URL) throws -> Data {
+        let scoped = url.startAccessingSecurityScopedResource()
+        defer { if scoped { url.stopAccessingSecurityScopedResource() } }
+        let values = try url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+        guard values.isRegularFile == true, values.isSymbolicLink != true else { throw Failure.unsupportedFile }
+        if let size = values.fileSize, size > maxBytes { throw Failure.tooLarge }
+        let handle = try FileHandle(forReadingFrom: url)
+        defer { try? handle.close() }
+        var bytes = Data()
+        while bytes.count <= maxBytes {
+            let count = min(32_768, maxBytes + 1 - bytes.count)
+            guard let chunk = try handle.read(upToCount: count), !chunk.isEmpty else { return bytes }
+            bytes.append(chunk)
+        }
+        throw Failure.tooLarge
+    }
+
+    func importCopy(_ data: Data, name: String) throws -> Record {
+        _ = try Self.dictionary(data)
+        let digest = Self.sha(data)
+        let created = Record(
+            id: UUID(), name: String(name.prefix(100)), original: data, originalSHA: digest,
+            working: data, workingSHA: digest
+        )
+        return try persistAndReadBack(created)
+    }
+
+    func records() throws -> [Record] {
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+        let urls = try FileManager.default.contentsOfDirectory(at: root, includingPropertiesForKeys: nil)
+        return try urls
+            .filter { $0.pathExtension == "json" }
+            .compactMap { UUID(uuidString: $0.deletingPathExtension().lastPathComponent) }
+            .map { try read($0) }
+            .sorted { ($0.name, $0.id.uuidString) < ($1.name, $1.id.uuidString) }
+    }
+
+    func stage(xml: String, for record: Record) throws -> Change {
+        let candidate = Data(xml.utf8)
+        let before = try Self.dictionary(record.working)
+        let after = try Self.dictionary(candidate)
+        let changed = try Set(before.keys).union(after.keys).sorted().filter {
+            try Self.encodedValue(before[$0]) != Self.encodedValue(after[$0])
+        }
+        guard !changed.isEmpty else { throw Failure.noChange }
+        return Change(
+            recordID: record.id, beforeSHA: record.workingSHA, afterSHA: Self.sha(candidate),
+            changedKeys: changed, bytes: candidate
+        )
+    }
+
+    func apply(_ change: Change) throws -> Record {
+        var current = try read(change.recordID)
+        guard current.workingSHA == change.beforeSHA else { throw Failure.staleRevision }
+        _ = try Self.dictionary(change.bytes)
+        guard Self.sha(change.bytes) == change.afterSHA else { throw Failure.damagedRecord }
+        current.previous = current.working
+        current.previousSHA = current.workingSHA
+        current.working = change.bytes
+        current.workingSHA = change.afterSHA
+        return try persistAndReadBack(current)
+    }
+
+    func restoreOriginal(id: UUID, expectedSHA: String) throws -> Record {
+        var current = try read(id)
+        guard current.workingSHA == expectedSHA else { throw Failure.staleRevision }
+        current.previous = current.working
+        current.previousSHA = current.workingSHA
+        current.working = current.original
+        current.workingSHA = current.originalSHA
+        return try persistAndReadBack(current)
+    }
+
+    func restorePrevious(id: UUID, expectedSHA: String) throws -> Record {
+        var current = try read(id)
+        guard current.workingSHA == expectedSHA else { throw Failure.staleRevision }
+        guard let before = current.previous, let digest = current.previousSHA else { throw Failure.noChange }
+        current.previous = current.working
+        current.previousSHA = current.workingSHA
+        current.working = before
+        current.workingSHA = digest
+        return try persistAndReadBack(current)
+    }
+
+    static func editableXML(_ data: Data) throws -> String {
+        let bytes = try PropertyListSerialization.data(fromPropertyList: dictionary(data), format: .xml, options: 0)
+        guard bytes.count <= maxBytes else { throw Failure.tooLarge }
+        return String(decoding: bytes, as: UTF8.self)
+    }
+
+    private static func dictionary(_ data: Data) throws -> [String: Any] {
+        guard data.count <= maxBytes else { throw Failure.tooLarge }
+        guard let values = try PropertyListSerialization.propertyList(from: data, options: [], format: nil) as? [String: Any] else {
+            throw Failure.notDictionary
+        }
+        return values
+    }
+
+    private static func encodedValue(_ value: Any?) throws -> Data? {
+        guard let value else { return nil }
+        return try PropertyListSerialization.data(fromPropertyList: [value], format: .xml, options: 0)
+    }
+
+    private static func sha(_ bytes: Data) -> String {
+        SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined()
+    }
+
+    private func persistAndReadBack(_ record: Record) throws -> Record {
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+        let payload = try JSONEncoder().encode(record)
+#if os(iOS)
+        try payload.write(to: path(record.id), options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+#else
+        try payload.write(to: path(record.id), options: [.atomic])
+#endif
+        let verified = try read(record.id)
+        guard verified == record else { throw Failure.damagedRecord }
+        return verified
+    }
+
+    private func read(_ id: UUID) throws -> Record {
+        let url = path(id)
+        let props = try url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+        guard props.isRegularFile == true, props.isSymbolicLink != true,
+              let size = props.fileSize, size <= 6 * Self.maxBytes else { throw Failure.damagedRecord }
+        let value = try JSONDecoder().decode(Record.self, from: Data(contentsOf: url))
+        guard value.id == id, value.original.count <= Self.maxBytes, value.working.count <= Self.maxBytes,
+              Self.sha(value.original) == value.originalSHA, Self.sha(value.working) == value.workingSHA
+        else { throw Failure.damagedRecord }
+        switch (value.previous, value.previousSHA) {
+        case (nil, nil): break
+        case (let before?, let digest?) where before.count <= Self.maxBytes && Self.sha(before) == digest: break
+        default: throw Failure.damagedRecord
+        }
+        return value
+    }
+
+    private func path(_ id: UUID) -> URL { root.appendingPathComponent("\(id.uuidString).json", isDirectory: false) }
+}
diff --git a/GestaltX/LocalPlistWorkspaceView.swift b/GestaltX/LocalPlistWorkspaceView.swift
new file mode 100644
index 0000000..a75e477
--- /dev/null
+++ b/GestaltX/LocalPlistWorkspaceView.swift
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import SwiftUI
+import UniformTypeIdentifiers
+
+@MainActor
+struct LocalPlistWorkspaceView: View {
+    @EnvironmentObject private var operationLog: UnifiedOperationLog
+    @State private var records: [LocalPlistWorkspace.Record] = []
+    @State private var selected: LocalPlistWorkspace.Record?
+    @State private var draft = ""
+    @State private var proposal: LocalPlistWorkspace.Change?
+    @State private var notice: String?
+    @State private var importing = false
+    @State private var restoring = false
+    @State private var restoreLast = false
+    @State private var exporting = false
+    @State private var document: CopyDocument?
+
+    private struct CopyDocument: FileDocument {
+        static var readableContentTypes: [UTType] { [.propertyList] }
+        let bytes: Data
+
+        init(bytes: Data) { self.bytes = bytes }
+
+        init(configuration: ReadConfiguration) throws {
+            guard let bytes = configuration.file.regularFileContents else { throw CocoaError(.fileReadCorruptFile) }
+            self.bytes = bytes
+        }
+
+        func fileWrapper(configuration: WriteConfiguration) throws -> FileWrapper {
+            FileWrapper(regularFileWithContents: bytes)
+        }
+    }
+
+    private var store: LocalPlistWorkspace {
+        .init(root: URL.applicationSupportDirectory.appending(path: "LocalPlistWorkspace", directoryHint: .isDirectory))
+    }
+
+    var body: some View {
+        List {
+            Section {
+                Button("导入 plist 副本", systemImage: "doc.badge.plus") { importing = true }
+                ForEach(records) { record in
+                    Button { select(record) } label: {
+                        Label(record.name, systemImage: record.id == selected?.id ? "checkmark.circle.fill" : "doc")
+                    }
+                }
+            } footer: {
+                Text("只编辑应用内的独立副本，不修改来源文件、系统设置或 MobileGestalt。")
+            }
+
+            if let selected {
+                Section("副本编辑") {
+                    TextEditor(text: $draft)
+                        .font(.system(.footnote, design: .monospaced))
+                        .frame(minHeight: 180)
+                        .autocorrectionDisabled()
+                        .textInputAutocapitalization(.never)
+                        .accessibilityLabel("plist XML")
+                    Button("检查差异", systemImage: "arrow.left.arrow.right") { prepare(selected) }
+                }
+
+                if let proposal {
+                    Section("写入前核对") {
+                        LabeledContent("变更字段", value: proposal.changedKeys.count.formatted())
+                        ForEach(proposal.changedKeys.prefix(25), id: \.self) { Text($0) }
+                        if proposal.changedKeys.count > 25 { Text("这里只列出前 25 项。") }
+                        Text("原 SHA256：\(proposal.beforeSHA)").font(.caption.monospaced())
+                        Text("新 SHA256：\(proposal.afterSHA)").font(.caption.monospaced())
+                        Button("写入副本并校验", systemImage: "checkmark.shield") { apply(proposal) }
+                    }
+                }
+
+                Section("备份与恢复") {
+                    Button("导出当前副本") { export(selected.working) }
+                    Button("导出原始备份") { export(selected.original) }
+                    if let before = selected.previous, selected.previousSHA != selected.workingSHA {
+                        Button("导出上次写入前的备份") { export(before) }
+                        Button("恢复上次写入前的备份", role: .destructive) { restoreLast = true; restoring = true }
+                    }
+                    if selected.workingSHA != selected.originalSHA {
+                        Button("恢复原始备份", role: .destructive) { restoreLast = false; restoring = true }
+                    }
+                }
+            }
+
+            if let notice { Text(notice).foregroundStyle(.secondary) }
+        }
+        .navigationTitle("本地 plist 工作区")
+        .onChange(of: draft) { _, _ in proposal = nil }
+        .task { refresh() }
+        .fileImporter(isPresented: $importing, allowedContentTypes: [.propertyList]) { result in
+            guard case .success(let url) = result else { return }
+            Task { await importFile(url) }
+        }
+        .fileExporter(isPresented: $exporting, document: document, contentType: .propertyList, defaultFilename: "LilaShift-Local.plist") {
+            if case .success = $0 { notice = "文件已导出。" }
+            else { notice = "导出未完成。" }
+            document = nil
+        }
+        .confirmationDialog("用核对过的备份恢复当前副本？", isPresented: $restoring, titleVisibility: .visible) {
+            Button("恢复并校验", role: .destructive) { restore() }
+        } message: {
+            if let selected {
+                let target = restoreLast ? selected.previousSHA : selected.originalSHA
+                Text("当前 SHA256：\(selected.workingSHA)\n恢复目标：\(target ?? "不可读")")
+            }
+        }
+    }
+
+    private func refresh() {
+        do { records = try store.records() }
+        catch { notice = "无法载入本地副本；未修改文件。" }
+    }
+
+    private func importFile(_ url: URL) async {
+        do {
+            let data = try await Task.detached { try LocalPlistWorkspace.readSelectedFile(url) }.value
+            _ = try LocalPlistWorkspace.editableXML(data)
+            let imported = try store.importCopy(data, name: url.lastPathComponent)
+            select(imported)
+            refresh()
+            notice = "副本与原始备份已写入并读回校验。"
+            operationLog.record(.plist, .info, "导入副本，已校验原始备份")
+        } catch {
+            operationLog.record(.plist, .error, "导入副本未完成")
+            notice = "导入未完成。需要不超过 1 MiB 的有效字典 plist，且不能是链接。"
+        }
+    }
+
+    private func select(_ record: LocalPlistWorkspace.Record) {
+        do {
+            draft = try LocalPlistWorkspace.editableXML(record.working)
+            selected = record
+            proposal = nil
+            notice = nil
+        } catch { notice = "无法打开此副本。" }
+    }
+
+    private func prepare(_ record: LocalPlistWorkspace.Record) {
+        do { proposal = try store.stage(xml: draft, for: record); notice = nil }
+        catch LocalPlistWorkspace.Failure.noChange { proposal = nil; notice = "没有字段变化。" }
+        catch { proposal = nil; notice = "无法生成差异，请核对 XML 格式及大小。" }
+    }
+
+    private func apply(_ change: LocalPlistWorkspace.Change) {
+        guard Data(draft.utf8) == change.bytes else { proposal = nil; return }
+        do {
+            selected = try store.apply(change)
+            proposal = nil
+            refresh()
+            notice = "副本已保存，读回的 SHA256 与本次差异一致。"
+            operationLog.record(.plist, .info, "保存副本，已读回核对")
+        } catch {
+            proposal = nil
+            notice = "未能确认写入；请重新打开副本核对，原始备份未替换。"
+            operationLog.record(.plist, .error, "副本写入未得到读回确认")
+        }
+    }
+
+    private func restore() {
+        guard let selected else { return }
+        do {
+            let verified = try restoreLast
+                ? store.restorePrevious(id: selected.id, expectedSHA: selected.workingSHA)
+                : store.restoreOriginal(id: selected.id, expectedSHA: selected.workingSHA)
+            select(verified)
+            refresh()
+            notice = "恢复后读回的内容与所选备份一致。"
+            operationLog.record(.plist, .info, "恢复副本，已读回核对")
+        } catch {
+            notice = "未能确认恢复；请重新打开副本核对。"
+            operationLog.record(.plist, .error, "副本恢复未得到读回确认")
+        }
+    }
+
+    private func export(_ bytes: Data) {
+        document = .init(bytes: bytes)
+        exporting = true
+    }
+}
