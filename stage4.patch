diff --git a/GestaltX/MGKeyCompatibility.swift b/GestaltX/MGKeyCompatibility.swift
new file mode 100644
index 0000000..8ec47cb
--- /dev/null
+++ b/GestaltX/MGKeyCompatibility.swift
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import Foundation
+
+/// Per-key compatibility evaluation for the monitor (Stage 4).
+/// Reuses the existing `CompatibilityStatus` display model; the
+/// precedence below is the Stage 4 piece, not a unification of the
+/// two existing eligibility systems (that is out of scope).
+///
+/// Precedence — the first matching rule wins, and a rule that cannot
+/// be decided honestly falls through to `unverified`, never to a
+/// guessed state:
+/// 1. Sentinel blocked → `.readFailed` ("not granted on this iOS version").
+/// 2. Sentinel unknown → `.unverified` (the build could not be confirmed).
+/// 3. Unknown product type → `.unverified` (scope cannot be checked).
+/// 4. Out of device scope → `.unsupported`.
+/// 5. Out of iOS scope → `.unsupported`.
+/// 6. Not readable via MGCopyAnswer → `.unverified` (IODeviceTree query key).
+/// 7. No live value → `.unverified` (absent on this device, or the
+///    probe returned nothing — the two cannot be distinguished).
+/// 8. Bool key: live true → `.enabled`; live false + writable →
+///    `.modifiable`; live false + read-only → `.unsupported`.
+/// 9. Non-bool key with a live value: equals the native default →
+///    `.nativeSupported`; otherwise `.unverified` (informational —
+///    the live value is shown, no enabled state applies).
+enum MGKeyCompatibility {
+    static func evaluate(record: MGKeyRecord, productType: String?, iosVersion: String,
+                         live: MGValue?, sentinel: VersionSentinelState) -> (status: CompatibilityStatus, reason: String) {
+        switch sentinel {
+        case .blocked:
+            return (.readFailed, L("Not granted on this iOS version."))
+        case .unknownBuild:
+            return (.unverified, L("The iOS build could not be confirmed."))
+        case .supported:
+            break
+        }
+        guard let productType else {
+            return (.unverified, L("The device model is unknown, so scope cannot be checked."))
+        }
+        guard record.deviceScope.contains(productType: productType) else {
+            return (.unsupported, L("This key does not apply to this device model."))
+        }
+        guard record.iosScope.contains(iosVersion) else {
+            return (.unsupported, L("This key is not present in this iOS version."))
+        }
+        guard record.readableViaMGCopyAnswer else {
+            return (.unverified, L("This key cannot be read with MGCopyAnswer (it is an IODeviceTree query key)."))
+        }
+        guard let live else {
+            return (.unverified, L("No live value: the key may be absent on this device, or the probe returned nothing."))
+        }
+        if case .bool(let value) = live {
+            if value { return (.enabled, L("Live value is on.")) }
+            if record.writable { return (.modifiable, L("Live value is off; this key may be staged.")) }
+            return (.unsupported, L("Live value is off; this key is read-only."))
+        }
+        if let defaultValue = record.defaultValue, live == defaultValue {
+            return (.nativeSupported, L("Live value matches the native default."))
+        }
+        return (.unverified, L("Informational key: the live value is shown, no enabled state applies."))
+    }
+}
diff --git a/GestaltX/MGMonitor.swift b/GestaltX/MGMonitor.swift
new file mode 100644
index 0000000..af89f40
--- /dev/null
+++ b/GestaltX/MGMonitor.swift
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import Foundation
+
+/// The iOS version sentinel (ADR-2-09): the iOS 27.3 beta 2 build
+/// (24C5049d) is the first build where Apple blocked worse_query.
+/// On blocked builds every monitor read reports "not granted on this
+/// iOS version" with stay/downgrade guidance — never an empty list,
+/// never a silent failure.
+enum VersionSentinelState: Equatable, Sendable {
+    /// This build grants the mechanism.
+    case supported
+    /// This build blocks the mechanism.
+    case blocked(build: String)
+    /// The build could not be classified (unparsable, or unreadable).
+    /// Unknown is never assumed supported.
+    case unknownBuild(build: String)
+}
+
+enum VersionSentinel {
+    /// The first build where Apple blocked worse_query (iOS 27.3
+    /// beta 2). The structured twin `blockedFrom` must match it.
+    static let blockedFromBuild = "24C5049d"
+
+    /// Classifies a build string such as "24C5049d". `nil` (no build
+    /// readable) is `.unknownBuild` — never assumed supported. Other
+    /// trains fall through the same total order: an older train is
+    /// supported, a newer train is blocked fail-closed until the
+    /// threshold is reviewed (Stage 6 combines this with the
+    /// version-based support ranges).
+    static func state(forBuild build: String?) -> VersionSentinelState {
+        guard let build, !build.isEmpty else { return .unknownBuild(build: "") }
+        guard let parsed = parse(build) else { return .unknownBuild(build: build) }
+        return parsed >= blockedFrom ? .blocked(build: build) : .supported
+    }
+
+    /// Stay/downgrade guidance for a blocked or unknown build:
+    /// stay on iOS 27.2.1 or below, or downgrade to 27.2.1 while
+    /// Apple still signs it; never upgrade past 27.3 beta 1. `nil`
+    /// for supported builds.
+    static func guidance(for state: VersionSentinelState) -> String? {
+        switch state {
+        case .supported: return nil
+        case .blocked:
+            return L("This iOS version blocks the mechanism. Stay on iOS 27.2.1 or below, or downgrade to 27.2.1 while Apple still signs it. Do not upgrade.")
+        case .unknownBuild:
+            return L("The iOS build could not be confirmed, so the monitor cannot tell whether the mechanism is granted on this version.")
+        }
+    }
+
+    /// The structured twin of `blockedFromBuild`.
+    private static let blockedFrom = Build(major: 24, letter: "C", number: 5049, suffix: "d")
+
+    /// Parses "24C5049d" into its parts, or `nil` when the string is
+    /// not an Apple build number.
+    static func parse(_ build: String) -> Build? {
+        var major = ""
+        var letter: Character?
+        var number = ""
+        var suffix = ""
+        var stage = 0 // 0 major digits, 1 letter, 2 number digits, 3 seed letter
+        for character in build {
+            switch stage {
+            case 0:
+                if character.isNumber { major.append(character) }
+                else if character.isUppercase && character.isASCII { letter = character; stage = 1 }
+                else { return nil }
+            case 1:
+                if character.isNumber { number.append(character); stage = 2 }
+                else { return nil }
+            case 2:
+                if character.isNumber { number.append(character) }
+                else if character.isLowercase && character.isASCII { suffix.append(character); stage = 3 }
+                else { return nil }
+            default: return nil
+            }
+        }
+        guard stage == 2 || stage == 3, let letter, !major.isEmpty, !number.isEmpty,
+              let majorValue = Int(major), let numberValue = Int(number) else { return nil }
+        return Build(major: majorValue, letter: letter, number: numberValue, suffix: suffix)
+    }
+
+    /// One Apple build number, comparable in the order Apple ships
+    /// them: major train, then letter, then number, then seed letter.
+    struct Build: Comparable, Equatable, Sendable {
+        let major: Int
+        let letter: Character
+        let number: Int
+        let suffix: String
+
+        static func < (lhs: Build, rhs: Build) -> Bool {
+            if lhs.major != rhs.major { return lhs.major < rhs.major }
+            if lhs.letter != rhs.letter { return lhs.letter < rhs.letter }
+            if lhs.number != rhs.number { return lhs.number < rhs.number }
+            return lhs.suffixRank < rhs.suffixRank
+        }
+
+        /// A bare build number (no seed letter) ranks after all its
+        /// seeds: it is the finalized build of that number, and a
+        /// finalized build of a blocked beta stays blocked.
+        var suffixRank: Int {
+            guard let scalar = suffix.unicodeScalars.first else { return 26 }
+            return Int(scalar.value) - 97 // "a" == 97
+        }
+    }
+}
+
+/// A CacheData slot probe for one key: the layout-resolved slot
+/// number (a per-device observation, never a layout constant) and
+/// the slot byte at each source. `nil` bytes mean "the slot did not
+/// resolve on that document", never a guessed value.
+struct MGSlotProbe: Equatable, Sendable {
+    let slotNumber: Int
+    /// The slot byte in the first-read document.
+    let originalByte: Bool?
+    /// The slot byte in the staged document.
+    let stagedByte: Bool?
+    /// The live MGCopyAnswer answer for the key.
+    let liveAnswer: Bool?
+    /// The record's native baseline, when known (`nil` = unknown,
+    /// and callers must fail closed on it).
+    let nativeBaseline: Bool?
+
+    /// Whether the live answer disagrees with the native baseline.
+    /// `nil` when either is unknown — unknown is not a disagreement.
+    var disagreesWithNativeBaseline: Bool? {
+        guard let liveAnswer, let nativeBaseline else { return nil }
+        return liveAnswer != nativeBaseline
+    }
+}
+
+/// One monitored key: the three sources side by side, as in
+/// Erosion-CN's MGInspectorView (GPL-3.0 reference only — the
+/// three-source layout is the model, the code is LilaShift's own).
+/// The three sources are the first-read (original) value, the
+/// staged (working-document) value, and the live MGCopyAnswer value.
+struct MGMonitorRow: Equatable, Sendable {
+    let record: MGKeyRecord
+    /// First-read (backup) value. `nil` = the key was absent at first read.
+    let original: MGValue?
+    /// Working-document (staged) value. `nil` = absent from the staged document.
+    let staged: MGValue?
+    /// Live MGCopyAnswer value. `nil` = the live probe returned nothing.
+    let live: MGValue?
+    /// When the live value was read.
+    let liveReadAt: Date?
+    /// The slot probe for CacheData keys (`nil` for CacheExtra-only keys).
+    let slot: MGSlotProbe?
+    let compatibility: CompatibilityStatus
+    let compatibilityReason: String
+    /// Whether `liveReadAt` is older than `MGMonitor.staleAfter`.
+    let isStale: Bool
+
+    /// Whether the sources disagree: a staged change, a staged
+    /// deletion, or the live answer differing from the staged value.
+    /// An absent live value is "unreadable", not a difference, and an
+    /// absent original is "not recorded", not a difference.
+    var hasDifference: Bool {
+        if let original, let staged, original != staged { return true }
+        if original != nil, staged == nil { return true }
+        if let staged, let live, staged != live { return true }
+        if let slot, let liveAnswer = slot.liveAnswer, let stagedByte = slot.stagedByte,
+           liveAnswer != stagedByte { return true }
+        return false
+    }
+}
+
+/// Inputs to one monitor row. Pure data: the engine never reads the
+/// device, the file system or the live probe itself — the caller
+/// (GestaltManager) supplies the three sources.
+struct MGMonitorInput: Sendable {
+    let record: MGKeyRecord
+    let original: MGValue?
+    let staged: MGValue?
+    let live: MGValue?
+    let liveReadAt: Date?
+    let slot: MGSlotProbe?
+    let productType: String?
+    let iosVersion: String
+    let sentinel: VersionSentinelState
+}
+
+/// The monitor engine: pure three-source comparison plus the
+/// per-key compatibility badge. No I/O, no timers — the monitor
+/// refreshes on demand only (no timer polls the device).
+enum MGMonitor {
+    /// Live values older than this are shown as stale. A chosen UX
+    /// value, not a measured threshold.
+    static let staleAfter: TimeInterval = 300
+
+    static func row(for input: MGMonitorInput, now: Date = Date()) -> MGMonitorRow {
+        let (status, reason) = MGKeyCompatibility.evaluate(
+            record: input.record, productType: input.productType,
+            iosVersion: input.iosVersion, live: input.live, sentinel: input.sentinel)
+        let isStale: Bool = {
+            guard let liveReadAt = input.liveReadAt else { return false }
+            return now.timeIntervalSince(liveReadAt) > staleAfter
+        }()
+        return MGMonitorRow(record: input.record, original: input.original, staged: input.staged,
+                            live: input.live, liveReadAt: input.liveReadAt, slot: input.slot,
+                            compatibility: status, compatibilityReason: reason, isStale: isStale)
+    }
+
+    static func rows(for inputs: [MGMonitorInput], now: Date = Date()) -> [MGMonitorRow] {
+        inputs.map { row(for: $0, now: now) }
+    }
+}
diff --git a/GestaltX/MGMonitorView.swift b/GestaltX/MGMonitorView.swift
new file mode 100644
index 0000000..db08c06
--- /dev/null
+++ b/GestaltX/MGMonitorView.swift
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import SwiftUI
+
+/// The realtime MobileGestalt monitor (Stage 4): every database key
+/// with its three sources side by side — first-read (original),
+/// staged (working document), and live MGCopyAnswer — plus the
+/// CacheData slot probe for slot keys and the per-key compatibility
+/// badge. The monitor refreshes on demand only (no timer polls the
+/// device). On a sentinel-blocked build it shows the "not granted on
+/// this iOS version" banner with stay/downgrade guidance, never an
+/// empty list.
+struct MGMonitorView: View {
+    @EnvironmentObject private var model: GestaltManager
+    @State private var query = ""
+    @State private var showDifferencesOnly = false
+
+    private var filteredRows: [MGMonitorRow] {
+        let rows = model.monitorRows
+        let matching = query.isEmpty ? rows : rows.filter { row in
+            MGDatabase.search(query).contains(row.record)
+        }
+        return showDifferencesOnly ? matching.filter(\.hasDifference) : matching
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: GlassTokens.rowSpacing) {
+            Text(L("Every database key, live: the first-read value, the staged value, and the live system answer side by side. A difference means a change is staged, or the live answer disagrees with it."))
+                .font(.subheadline)
+                .foregroundStyle(.secondary)
+            sentinelBanner
+            HStack {
+                TextField(L("Search keys"), text: $query)
+                    .textFieldStyle(.roundedBorder)
+                    .autocapitalization(.none)
+                    .disableAutocorrection(true)
+                Button(L("Refresh")) {
+                    Task { await model.refreshMonitor() }
+                }
+            }
+            Toggle(L("Differences only"), isOn: $showDifferencesOnly)
+            if let readAt = model.monitorReadAt {
+                Text(L("Live values read at") + " " + readAt.formatted(date: .omitted, time: .shortened)
+                     + (model.monitorRows.contains(where: \.isStale) ? " · " + L("stale") : ""))
+                    .font(.caption)
+                    .foregroundStyle(.secondary)
+            }
+            if model.monitorRows.isEmpty {
+                Text(L("No monitor data yet — tap Refresh."))
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+            } else if filteredRows.isEmpty {
+                Text(L("No keys match this filter."))
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+            } else {
+                List(filteredRows, id: \.record.obfuscatedName) { row in
+                    MGMonitorRowView(row: row)
+                }
+                .listStyle(.plain)
+            }
+        }
+        .padding()
+        .background(GlassBackground())
+        .navigationTitle(L("MG Monitor"))
+        .navigationBarTitleDisplayMode(.large)
+        .onAppear {
+            Task { await model.refreshMonitor() }
+        }
+    }
+
+    @ViewBuilder
+    private var sentinelBanner: some View {
+        switch model.monitorSentinel {
+        case .supported:
+            EmptyView()
+        case .blocked(let build):
+            VStack(alignment: .leading, spacing: 4) {
+                Text(L("Not granted on this iOS version.") + " (\(L("build")) \(build)).")
+                    .font(.subheadline)
+                    .fontWeight(.semibold)
+                if let guidance = VersionSentinel.guidance(for: model.monitorSentinel) {
+                    Text(guidance).font(.caption).foregroundStyle(.secondary)
+                }
+            }
+            .padding()
+            .background(GlassBackground())
+        case .unknownBuild:
+            VStack(alignment: .leading, spacing: 4) {
+                Text(L("The iOS build could not be confirmed."))
+                    .font(.subheadline)
+                    .fontWeight(.semibold)
+                if let guidance = VersionSentinel.guidance(for: model.monitorSentinel) {
+                    Text(guidance).font(.caption).foregroundStyle(.secondary)
+                }
+            }
+            .padding()
+            .background(GlassBackground())
+        }
+    }
+}
+
+private struct MGMonitorRowView: View {
+    let row: MGMonitorRow
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 4) {
+            HStack {
+                Text(row.record.readableName).font(.subheadline)
+                if row.hasDifference {
+                    Text(L("Changed")).font(.caption2).fontWeight(.semibold)
+                        .padding(.horizontal, 6).padding(.vertical, 2)
+                        .background(GlassTokens.heroTint.opacity(0.15))
+                        .clipShape(Capsule())
+                }
+                Spacer(minLength: 8)
+                Text(row.compatibility.title).font(.caption).foregroundStyle(.secondary)
+            }
+            Text(row.record.obfuscatedName).font(.caption).foregroundStyle(.secondary).textSelection(.enabled)
+            Text(row.compatibilityReason).font(.caption).foregroundStyle(.secondary)
+            sourceRow(label: L("Original"), value: row.original, absentText: L("Absent"))
+            sourceRow(label: L("Staged"), value: row.staged, absentText: L("Absent"))
+            sourceRow(label: L("Live"), value: row.live, absentText: L("Unreadable"))
+            if let slot = row.slot {
+                slotSection(slot: slot)
+            }
+        }
+    }
+
+    private func sourceRow(label: String, value: MGValue?, absentText: String) -> some View {
+        HStack {
+            Text(label).font(.caption).foregroundStyle(.tertiary)
+                .frame(width: 64, alignment: .leading)
+            Text(value?.displayText ?? absentText)
+                .font(.caption).foregroundStyle(value == nil ? .tertiary : .primary)
+                .textSelection(.enabled)
+        }
+    }
+
+    @ViewBuilder
+    private func slotSection(slot: MGSlotProbe) -> some View {
+        VStack(alignment: .leading, spacing: 2) {
+            Text("\(L("Slot")) \(slot.slotNumber)").font(.caption).fontWeight(.semibold)
+            slotByteRow(label: L("Original"), value: slot.originalByte)
+            slotByteRow(label: L("Staged"), value: slot.stagedByte)
+            slotByteRow(label: L("Live"), value: slot.liveAnswer)
+            if let nativeBaseline = slot.nativeBaseline {
+                Text("\(L("Native baseline")): \(nativeBaseline ? "true" : "false")")
+                    .font(.caption).foregroundStyle(.secondary)
+                if slot.disagreesWithNativeBaseline == true {
+                    Text(L("The live answer disagrees with the native baseline."))
+                        .font(.caption).foregroundStyle(.red)
+                }
+            }
+        }
+    }
+
+    private func slotByteRow(label: String, value: Bool?) -> some View {
+        HStack {
+            Text(label).font(.caption).foregroundStyle(.tertiary)
+                .frame(width: 64, alignment: .leading)
+            Text(value.map { $0 ? "true" : "false" } ?? L("Unknown"))
+                .font(.caption).foregroundStyle(value == nil ? .tertiary : .primary)
+        }
+    }
+}
