+        }
+    }
+
+    func testAIWriteFailedEvent() {
+        guard let first = aiKeys.first else {
+            XCTFail("The AI capability list must not be empty"); return
+        }
+        let event = OperationEvent(kind: .writeFailed, key: first.key, detail: "Write did not verify")
