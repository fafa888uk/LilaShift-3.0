diff --git a/.github/workflows/run-swift-tests.yml b/.github/workflows/run-swift-tests.yml
index ef1757b..048dbf6 100644
--- a/.github/workflows/run-swift-tests.yml
+++ b/.github/workflows/run-swift-tests.yml
@@ -55,6 +55,29 @@ jobs:
           path: tests/__Snapshots__/
           if-no-files-found: ignore
 
+      - name: Collect snapshot failure renders
+        # On a mismatch, SnapshotTesting writes the actual render to
+        # the simulator's /tmp (record: .missing never overwrites
+        # the reference), so the references artifact alone cannot
+        # show what differed — Tests #196's two mismatches were
+        # undiagnosable from it. Collect any failure renders so the
+        # next mismatch can be located pixel by pixel.
+        if: always()
+        run: |
+          mkdir -p /tmp/snapshot-failures
+          find ~/Library/Developer/CoreSimulator -type f -name '*.png' \
+            \( -path '*/tmp/DashboardV3SnapshotTests/*' -o -path '*/tmp/ViewSnapshotTests/*' \) \
+            -exec cp {} /tmp/snapshot-failures/ \; 2>/dev/null || true
+          ls -la /tmp/snapshot-failures/
+
+      - name: Upload snapshot failure renders
+        if: always()
+        uses: actions/upload-artifact@v7
+        with:
+          name: snapshot-failures
+          path: /tmp/snapshot-failures/
+          if-no-files-found: ignore
+
 
 
 
