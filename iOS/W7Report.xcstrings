        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开此文件。"
          }
        }
      }
    },
    "Export from Settings → Privacy & Security → Apple Intelligence Report. This app only reads the file you choose and does not upload or retain it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从「设置 → 隐私与安全性 → Apple 智能报告」导出。本应用只读你选中的文件，不上传、不留存原文。"
          }
        }
      }
    },
    "Model request records": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型请求记录"
