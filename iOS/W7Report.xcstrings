{
  "sourceLanguage": "en",
  "strings": {
    "A report section had an unsupported format.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告包含格式不受支持的字段。"
          }
        }
      }
    },
    "A zero count describes this file only. The app does not verify the report's origin, server attestation, or device eligibility.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "零条仅描述此文件。本应用不核验报告来源、服务器证明或设备准入。"
          }
        }
      }
    },
    "Apple Intelligence Report": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能报告"
          }
        }
      }
    },
