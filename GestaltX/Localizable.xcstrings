    "Restart the device, then re-read: the staged AI values are not what the device reports live.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the device, then re-read: the staged AI values are not what the device reports live."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重启设备后重新读取：暂存的 AI 值与设备的实时回报不一致。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia el dispositivo y vuelve a leerlo: los valores de IA preparados no coinciden con los que comunica actualmente el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاه را راه‌اندازی مجدد کنید و دوباره بخوانید؛ مقادیر آماده‌شدهٔ هوش مصنوعی با مقادیری که دستگاه اکنون گزارش می‌کند یکسان نیستند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを再起動して再度読み取ってください。ステージング済みの AI 値とデバイスが現在報告する値が一致していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 재시동한 뒤 다시 읽어 주세요. 준비된 AI 값이 기기가 현재 보고하는 값과 다릅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустите устройство и повторите чтение: подготовленные значения ИИ не совпадают с текущими ответами устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại thiết bị rồi đọc lại: các giá trị AI đã chuẩn bị không khớp với giá trị thiết bị đang báo."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新啟動裝置後重新讀取：暫存的 AI 值與裝置的即時回報不一致。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新啟動裝置後重新讀取：暫存的 AI 值與裝置的即時回報不一致。"
          }
        }
      }
    },
