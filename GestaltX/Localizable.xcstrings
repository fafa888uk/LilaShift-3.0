    "The diagnostic reports container could not be opened on this system version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The diagnostic reports container could not be opened on this system version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此系统版本上无法打开诊断报告容器。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el contenedor de informes de diagnóstico en esta versión del sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این نسخه سیستم، ظرف گزارش‌های تشخیصی باز نشد。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシステムバージョンでは診断レポートのコンテナを開けませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시스템 버전에서는 진단 보고서 컨테이너를 열 수 없습니다。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть контейнер диагностических отчётов в этой версии системы。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở vùng chứa báo cáo chẩn đoán trên phiên bản hệ thống này。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在此系統版本上無法開啟診斷報告容器。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在此系統版本上無法開啟診斷報告容器。"
          }
        }
      }
    },
