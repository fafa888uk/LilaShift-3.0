    "This wallpaper already exists. Import it again to make a copy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallpaper already exists. Import it again to make a copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此壁纸已存在。再次导入可创建副本。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fondo de pantalla ya existe. Impórtalo de nuevo para crear una copia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تصویر زمینه از قبل وجود دارد. برای ایجاد یک نسخه، آن را دوباره وارد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この壁紙はすでにあります。もう一度読み込むとコピーを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 배경화면은 이미 있습니다. 다시 가져오면 복사본을 만들 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти обои уже существуют. Импортируйте их повторно, чтобы создать копию."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình nền này đã tồn tại. Nhập lại để tạo một bản sao."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此牆紙已存在。再次匯入可建立副本。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此桌布已存在。再次匯入可建立副本。"
          }
        }
      }
    },
    "The wallpaper could not be saved and verified. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallpaper could not be saved and verified. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存并验证此壁纸。请重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar y verificar este fondo de pantalla. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره و تأیید این تصویر زمینه انجام نشد. دوباره تلاش کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この壁紙を保存して検証できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 배경화면을 저장하고 검증하지 못했습니다. 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить и проверить эти обои. Повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu và xác minh hình nền này. Hãy thử lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存並驗證此牆紙。請再試一次。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存並驗證此桌布。請再試一次。"
          }
        }
      }
    },
    "This wallpaper is damaged. Delete it and import it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallpaper is damaged. Delete it and import it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此壁纸已损坏。请删除后重新导入。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fondo de pantalla está dañado. Elimínalo e impórtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تصویر زمینه خراب شده است. آن را حذف کنید و دوباره وارد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この壁紙は破損しています。削除してから再度読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 배경화면이 손상되었습니다. 삭제한 후 다시 가져오세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти обои повреждены. Удалите их и импортируйте заново."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình nền này bị hỏng. Hãy xóa rồi nhập lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此牆紙已損壞。請刪除後重新匯入。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此桌布已損壞。請刪除後重新匯入。"
          }
        }
      }
    },
    "Give the wallpaper a name of 1–64 characters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the wallpaper a name of 1–64 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为壁纸设置一个 1–64 个字符的名称。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna al fondo de pantalla un nombre de 1 a 64 caracteres."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تصویر زمینه نامی با ۱ تا ۶۴ نویسه انتخاب کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙に 1～64 文字の名前を付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경화면 이름을 1~64자로 지정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте обоям имя длиной от 1 до 64 символов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tên hình nền dài từ 1 đến 64 ký tự."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請為牆紙設定一個 1–64 個字元的名稱。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請為桌布設定一個 1–64 個字元的名稱。"
          }
        }
      }
    },
    "This iOS version blocks the mechanism. Stay on iOS 27.2.1 or below, or downgrade to 27.2.1 while Apple still signs it. Do not upgrade.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iOS version blocks the mechanism. Stay on iOS 27.2.1 or below, or downgrade to 27.2.1 while Apple still signs it. Do not upgrade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iOS 版本已封堵该机制。请停留在 iOS 27.2.1 或更早版本，或在 Apple 仍提供签名时降级到 27.2.1。请勿升级。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de iOS bloquea el mecanismo. Mantén iOS 27.2.1 o anterior, o vuelve a 27.2.1 mientras Apple aún lo firme. No actualices."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نسخهٔ iOS سازوکار را مسدود می‌کند. روی iOS 27.2.1 یا نسخه‌های قدیمی‌تر بمانید، یا تا زمانی که Apple هنوز آن را امضا می‌کند به 27.2.1 برگردید. ارتقا ندهید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iOS バージョンでは仕組みがブロックされています。iOS 27.2.1 以前のままにするか、Apple が署名を提供している間に 27.2.1 へダウングレードしてください。アップグレードしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iOS 버전에서는 해당 메커니즘이 차단됩니다. iOS 27.2.1 이하를 유지하거나 Apple이 서명을 제공하는 동안 27.2.1로 다운그레이드하세요. 업그레이드하지 마세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия iOS блокирует механизм. Оставайтесь на iOS 27.2.1 или более ранней версии либо откатитесь до 27.2.1, пока Apple ещё подписывает её. Не обновляйтесь."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản iOS này chặn cơ chế. Hãy giữ iOS 27.2.1 trở xuống, hoặc hạ cấp về 27.2.1 khi Apple vẫn còn ký phiên bản đó. Không nâng cấp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iOS 版本已封鎖此機制。請維持 iOS 27.2.1 或更早版本，或趁 Apple 仍提供簽署時降級至 27.2.1。請勿升級。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iOS 版本已封鎖此機制。請維持 iOS 27.2.1 或更早版本，或趁 Apple 仍提供簽署時降級至 27.2.1。請勿升級。"
          }
        }
      }
    },
    "The iOS build could not be confirmed, so the monitor cannot tell whether the mechanism is granted on this version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iOS build could not be confirmed, so the monitor cannot tell whether the mechanism is granted on this version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认 iOS 构建版本，因此监控器无法判断此版本是否允许使用该机制。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la compilación de iOS, por lo que el monitor no puede determinar si esta versión permite el mecanismo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شمارهٔ ساخت iOS تأیید نشد؛ بنابراین پایشگر نمی‌تواند تشخیص دهد که این نسخه اجازهٔ استفاده از سازوکار را می‌دهد یا نه."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS のビルドを確認できないため、このバージョンで仕組みを利用できるか監視機能では判断できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 빌드를 확인할 수 없어 모니터가 이 버전에서 해당 메커니즘의 사용이 허용되는지 판단할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить сборку iOS, поэтому монитор не может установить, разрешён ли механизм в этой версии."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác nhận bản dựng iOS, nên trình giám sát không thể xác định cơ chế có được phép trên phiên bản này hay không."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認 iOS 組建版本，因此監察器無法判斷此版本是否允許使用此機制。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認 iOS 組建版本，因此監視器無法判斷此版本是否允許使用此機制。"
          }
        }
      }
    },
