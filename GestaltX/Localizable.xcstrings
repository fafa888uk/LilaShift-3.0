    "Fields whose current value differs from the recorded original.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fields whose current value differs from the recorded original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前值与已记录原始值不同的字段。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Campos cuyo valor actual difiere del original registrado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فیلدهایی که مقدار فعلی آن‌ها با مقدار اصلی ثبت‌شده تفاوت دارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在値が記録された元の値と異なる項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 값이 기록된 원래 값과 다른 필드."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля, текущее значение которых отличается от записанного исходного."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trường có giá trị hiện tại khác với giá trị gốc đã ghi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當前值與已記錄原始值不同的欄位。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當前值與已記錄原始值不同的欄位。"
          }
        }
      }
    },
    "Read the device first to see modified values.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the device first to see modified values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先读取本机数据，再查看已修改的值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el dispositivo primero para ver los valores modificados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دیدن مقادیر تغییر‌یافته، ابتدا دستگاه را بخوانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更された値を見るには、まずデバイスを読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정된 값을 보려면 먼저 기기를 읽으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала прочитайте устройство, чтобы увидеть изменённые значения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đọc thiết bị trước để xem các giá trị đã sửa đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請先讀取本機資料，再查看已修改的值。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請先讀取本機資料，再查看已修改的值。"
          }
        }
      }
    },
    "No recorded originals. Whether anything was modified cannot be determined.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recorded originals. Whether anything was modified cannot be determined."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已记录的原始值，无法判断是否修改过。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay originales registrados. No se puede determinar si algo se modificó."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار اصلی ثبت‌شده‌ای وجود ندارد. نمی‌توان تعیین کرد چیزی تغییر کرده است یا نه."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された元の値がありません。何が変更されたか判断できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 원래 값이 없습니다. 무엇이 수정되었는지 확인할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет записанных исходных значений. Невозможно определить, было ли что-то изменено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có giá trị gốc đã ghi. Không thể xác định có gì đã bị sửa đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已記錄的原始值，無法判斷是否修改過。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
