    "Your public IP and the network (ASN) that announces it, from RIPEstat. Online only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your public IP and the network (ASN) that announces it, from RIPEstat. Online only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的公网 IP 及发布该 IP 的网络（ASN），数据来自 RIPEstat。仅在线可用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu IP pública y la red (ASN) que la anuncia, de RIPEstat. Solo en línea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "IP عمومی شما و شبکه (ASN) که آن را اعلام می کند، از RIPEstat. فقط آنلاین."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのパブリック IP と、それをアナウンスするネットワーク（ASN）を RIPEstat から取得します。オンラインのみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RIPEstat에서 가져온 사용자의 공인 IP와 이를 알리는 네트워크(ASN)입니다. 온라인 전용."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш публичный IP и сеть (ASN), которая его анонсирует, из RIPEstat. Только онлайн."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "IP công khai của bạn và mạng (ASN) công bố IP đó, lấy từ RIPEstat. Chỉ khi trực tuyến."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你的公用 IP 及發佈該 IP 的網絡（ASN），資料來自 RIPEstat。僅限連線時使用。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你的公開 IP 及發布該 IP 的網路（ASN），資料來自 RIPEstat。僅限連線時使用。"
          }
        }
      }
    },
