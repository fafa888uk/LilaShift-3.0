{
  "sourceLanguage": "en",
  "strings": {
    "Save Current Launch Image": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Current Launch Image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存当前启动图"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar imagen de inicio actual"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره تصویر آغاز فعلی"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の起動画面を保存"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 시작 이미지 저장"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить текущее изображение запуска"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ảnh khởi động hiện tại"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存目前的啟動畫面"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存目前的啟動畫面"
          }
        }
      }
    },
    "Allow LilaShift to add photos in Settings, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow LilaShift to add photos in Settings, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 紫序 添加照片，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a LilaShift añadir fotos en Ajustes e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات اجازه افزودن عکس را به LilaShift بدهید و دوباره امتحان کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でLilaShiftによる写真の追加を許可してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 LilaShift의 사진 추가를 허용한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите LilaShift добавлять фото в Настройках и повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép LilaShift thêm ảnh trong Cài đặt rồi thử lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許 LilaShift 加入相片後再試一次。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許 LilaShift 加入照片後再試一次。"
          }
        }
      }
    },
    "The launch image was saved to Photos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The launch image was saved to Photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动图已保存到相册。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen de inicio se ha guardado en Fotos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر آغاز در عکس‌ها ذخیره شد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動画面を「写真」に保存しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 이미지를 사진에 저장했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение запуска сохранено в Фото."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu ảnh khởi động vào Ảnh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動畫面已儲存至「相片」。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動畫面已儲存至「照片」。"
          }
        }
      }
    },
