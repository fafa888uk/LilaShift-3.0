        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新启动设备才能生效。实际调光行为取决于屏幕面板。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se requiera reiniciar el dispositivo. La atenuación real depende del panel."
          }
        },
        "fa": {
