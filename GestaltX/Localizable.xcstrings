        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを再起動してください。AI の変更は適用されていますが、再起動後の検証はまだです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 재시동해 주세요. AI 변경 사항은 적용되었지만 재시동 후 검증되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустите устройство: изменения ИИ применены, но ещё не проверены после перезапуска."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy khởi động lại thiết bị: các thay đổi AI đã được áp dụng nhưng chưa được xác minh sau khi khởi động lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
