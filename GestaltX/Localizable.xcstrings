    "The app replaced this file. Its existing backup was kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app replaced this file. Its existing backup was kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 App 替换了此文件，已保留其现有备份。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app reemplazó este archivo. Se conservó su copia de seguridad existente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه این فایل را جایگزین کرد. پشتیبان موجود آن حفظ شد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App がこのファイルを置き換えました。既存のバックアップは保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 이 파일을 교체했습니다. 기존 백업은 유지되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение заменило этот файл. Существующая резервная копия сохранена."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng đã thay thế tệp này. Bản sao lưu hiện có đã được giữ lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "該 App 替換了此檔案，已保留其現有備份。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "該 App 替換了此檔案，已保留其現有備份。"
          }
        }
      }
    },
    "The original backup is invalid or belongs to another file. It was kept unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original backup is invalid or belongs to another file. It was kept unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始备份无效或属于其他文件，已保持原样。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad original no es válida o pertenece a otro archivo. Se mantuvo sin cambios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پشتیبان اصلی نامعتبر است یا متعلق به فایل دیگری است. بدون تغییر باقی ماند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のバックアップが無効か、別のファイルのものです。変更せずに保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 백업이 유효하지 않거나 다른 파일의 것입니다. 변경하지 않고 유지되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходная резервная копия недействительна или принадлежит другому файлу. Она оставлена без изменений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu gốc không hợp lệ hoặc thuộc về tệp khác. Nó được giữ nguyên."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "原始備份無效或屬於其他檔案，已保持原樣。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "原始備份無效或屬於其他檔案，已保持原樣。"
          }
        }
      }
    },
