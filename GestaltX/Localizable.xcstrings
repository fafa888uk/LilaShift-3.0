          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непроверенная комбинация явно подтверждена пользователем; подготовка продолжается."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổ hợp chưa xác minh đã được người dùng xác nhận rõ ràng; tiếp tục chuẩn bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者已明確確認該未驗證組合，繼續暫存。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者已明確確認該未驗證組合，繼續暫存。"
          }
        }
      }
    },
