    "Health, simulation and recorded changes at a glance. Details are on the pages below.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health, simulation and recorded changes at a glance. Details are on the pages below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康评分、模拟结果与已记录的更改一目了然，详情见下方页面。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salud, simulación y cambios registrados de un vistazo. Los detalles están en las páginas siguientes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سلامت، شبیه‌سازی و تغییرات ثبت‌شده در یک نگاه. جزئیات در صفحات زیر است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルス、シミュレーション、記録された変更を一目で確認できます。詳細は下のページをご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강, 시뮬레이션 및 기록된 변경 사항을 한눈에 확인하세요. 자세한 내용은 아래 페이지에 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние, симуляция и записанные изменения — одним взглядом. Подробности — на страницах ниже."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tình trạng, mô phỏng và các thay đổi đã ghi chỉ trong nháy mắt. Chi tiết ở các trang bên dưới."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "健康評分、模擬結果與已記錄的更改一目了然，詳情見下方頁面。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "健康評分、模擬結果與已記錄的更改一目了然，詳情見下方頁面。"
          }
        }
      }
    },
