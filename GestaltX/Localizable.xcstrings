          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "整個裝置檔案將被備份取代。"
          }
        }
      }
    },
    "A check failed. The restore cannot proceed until it is resolved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A check failed. The restore cannot proceed until it is resolved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一项检查未通过。在解决之前无法继续恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una comprobación falló. La restauración no puede continuar hasta resolverlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک بررسی ناموفق بود. تا زمان رفع آن، بازیابی نمی‌تواند ادامه یابد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックが失敗しました。解決するまで復元を続行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사에 실패했습니다. 해결될 때까지 복원을 계속할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка не пройдена. Восстановление невозможно, пока проблема не устранена."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một kiểm tra đã thất bại. Không thể tiếp tục khôi phục cho đến khi khắc phục."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "有一項檢查未通過。在解決之前無法繼續恢復。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "有一項檢查未通過。在解決之前無法繼續恢復。"
          }
        }
      }
    },
    "Check the preview above, then confirm to restore the whole backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the preview above, then confirm to restore the whole backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查上方预览，然后确认以恢复整个备份。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la vista previa y confirma para restaurar toda la copia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌نمایش بالا را بررسی کنید، سپس برای بازیابی کل پشتیبان تأیید کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のプレビューを確認してから、バックアップ全体の復元を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 미리보기를 확인한 뒤 전체 백업 복원을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте предпросмотр выше, затем подтвердите восстановление всей копии."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra bản xem trước ở trên, rồi xác nhận để khôi phục toàn bộ bản sao lưu."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查上方預覽，然後確認以恢復整個備份。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查上方預覽，然後確認以恢復整個備份。"
          }
        }
      }
    },
