    "Display Zoom is derived from the native scale exceeding the scale; verify it by toggling Display Zoom on the device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display Zoom is derived from the native scale exceeding the scale; verify it by toggling Display Zoom on the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示缩放是根据原生缩放大于缩放比例推断得出的；请在设备上切换“显示缩放”加以验证。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El zoom de pantalla se deduce de que la escala nativa supera la escala; verifícalo activando y desactivando el zoom de pantalla en el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بزرگنمایی صفحه از بیشتر بودن مقیاس اصلی نسبت به مقیاس به دست آمده است؛ با تغییر تنظیم بزرگنمایی صفحه در دستگاه آن را بررسی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面表示の拡大は、ネイティブスケールがスケールを超えていることから推定されています。デバイスで画面表示の拡大を切り替えて確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 확대는 네이티브 스케일이 스케일을 초과한다는 점에서 도출된 것입니다. 기기에서 디스플레이 확대를 전환하여 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштаб экрана определяется по тому, что исходный масштаб превышает масштаб; проверьте это, переключив масштаб экрана на устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu phóng màn hình được suy ra từ việc tỉ lệ gốc vượt quá tỉ lệ; hãy xác minh bằng cách bật/tắt thu phóng màn hình trên thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器縮放是根據原生縮放比例大於縮放比例推斷得出；請在裝置上切換「顯示器縮放」加以驗證。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕縮放是根據原生縮放比例大於縮放比例推斷得出；請在裝置上切換「螢幕縮放」加以驗證。"
          }
        }
      }
    },
