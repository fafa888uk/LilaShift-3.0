    "Cross-app access works through iOS 27.3 beta 1. It is blocked from iOS 27.3 beta 2 on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross-app access works through iOS 27.3 beta 1. It is blocked from iOS 27.3 beta 2 on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨 App 访问在 iOS 27.3 beta 1 及更早版本上可用，自 iOS 27.3 beta 2 起被阻止。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso entre apps funciona hasta iOS 27.3 beta 1. Está bloqueado a partir de iOS 27.3 beta 2."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی بین برنامه ها تا iOS 27.3 beta 1 کار می کند. از iOS 27.3 beta 2 به بعد مسدود شده است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App 間のアクセスは iOS 27.3 beta 1 まで動作します。iOS 27.3 beta 2 以降はブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 간 접근은 iOS 27.3 beta 1까지 동작합니다. iOS 27.3 beta 2부터는 차단됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Межпрограммный доступ работает до iOS 27.3 beta 1 включительно. Начиная с iOS 27.3 beta 2 он заблокирован."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập liên ứng dụng hoạt động đến iOS 27.3 beta 1. Từ iOS 27.3 beta 2 trở đi thì bị chặn."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "跨 App 存取在 iOS 27.3 beta 1 及更早版本可用，自 iOS 27.3 beta 2 起被封鎖。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "跨 App 存取在 iOS 27.3 beta 1 及更早版本可用，自 iOS 27.3 beta 2 起被封鎖。"
