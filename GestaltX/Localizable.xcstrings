    "Local network access denied. Allow local network access and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local network access denied. Allow local network access and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网络访问被拒绝。请允许本地网络访问，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso a la red local denegado. Permite el acceso a la red local e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به شبکه محلی رد شد. دسترسی به شبکه محلی را مجاز کنید و دوباره تلاش کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークへのアクセスが拒否されました。ローカルネットワークへのアクセスを許可して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크 접근이 거부되었습니다. 로컬 네트워크 접근을 허용하고 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к локальной сети запрещён. Разрешите доступ к локальной сети и попробуйте снова."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập mạng cục bộ bị từ chối. Hãy cho phép truy cập mạng cục bộ và thử lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本地網絡存取被拒絕。請允許本地網絡存取，然後再試一次。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本地網路存取被拒絕。請允許本地網路存取，然後再試一次。"
          }
        }
      }
    },
