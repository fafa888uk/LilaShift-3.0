    "Only a fake-supervision residue file was found (%@, IsSupervised with no MDM certificate chain). Cleaning it is safe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a fake-supervision residue file was found (%@, IsSupervised with no MDM certificate chain). Cleaning it is safe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发现一个伪监管残留文件（%@，只有 IsSupervised，没有 MDM 证书链），清理是安全的。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se encontró un archivo residual de supervisión falsa (%@, IsSupervised sin cadena de certificados MDM). Limpiarlo es seguro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط یک فایل باقی‌مانده نظارت جعلی یافت شد (%@، IsSupervised بدون زنجیره گواهی MDM). پاک‌سازی آن امن است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "偽の監視残留ファイルが1件だけ見つかりました（%@、IsSupervised のみで MDM 証明書チェーンなし）。消去しても安全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가짜 감독 잔여 파일 하나만 발견되었습니다(%@, IsSupervised만 있고 MDM 인증서 체인 없음). 정리해도 안전합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найден только один остаточный файл поддельного надзора (%@, только IsSupervised, без цепочки сертификатов MDM). Его удаление безопасно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tìm thấy một tệp dư lượng giám sát giả (%@, chỉ có IsSupervised, không có chuỗi chứng chỉ MDM). Dọn nó là an toàn."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "僅發現一個偽監管殘留檔案（%@，只有 IsSupervised，沒有 MDM 憑證鏈），清理是安全的。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅發現一個偽監管殘留檔案（%@，只有 IsSupervised，沒有 MDM 憑證鏈），清理是安全的。"
          }
        }
      }
    },
