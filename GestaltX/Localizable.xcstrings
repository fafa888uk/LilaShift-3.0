    "Restoring first verifies the archive, then backs up the current state, so a failed restore can go back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring first verifies the archive, then backs up the current state, so a failed restore can go back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复时会先验证归档，再备份当前状态，以便在恢复失败时回退。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración primero verifica el archivo y después guarda una copia del estado actual, para poder volver atrás si falla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در بازیابی ابتدا بایگانی بررسی می‌شود، سپس از وضعیت فعلی پشتیبان گرفته می‌شود تا در صورت شکست بازیابی بتوان به آن بازگشت."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元では、最初にアーカイブを検証し、次に現在の状態をバックアップします。復元に失敗した場合は元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원은 먼저 아카이브를 검증한 뒤 현재 상태를 백업하므로, 복원이 실패하면 이전 상태로 돌아갈 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед восстановлением сначала проверяется архив, затем сохраняется текущее состояние, чтобы при сбое можно было вернуться назад."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình khôi phục xác minh bản lưu trữ trước, sau đó sao lưu trạng thái hiện tại để có thể quay lại nếu khôi phục thất bại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復時會先驗證封存檔，再備份目前狀態，以便在恢復失敗時回復。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復時會先驗證封存檔，再備份目前狀態，以便在恢復失敗時回復。"
          }
        }
      }
    },
