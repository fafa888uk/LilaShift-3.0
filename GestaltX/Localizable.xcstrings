    "Restore the slot to its native value from a verified backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the slot to its native value from a verified backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从已验证的备份中将该槽位恢复为原生值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura esa posición a su valor nativo desde una copia de seguridad verificada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با استفاده از یک پشتیبان تأییدشده، آن خانه را به مقدار اصلی خود بازگردانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証済みのバックアップから、そのスロットを本来の値に復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증된 백업을 사용해 해당 슬롯을 기기의 기본값으로 복원해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите исходное значение слота из проверенной резервной копии."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục ô đó về giá trị gốc từ bản sao lưu đã được xác minh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請從已驗證的備份中將該槽位恢復為原生值。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請從已驗證的備份中將該槽位恢復為原生值。"
          }
        }
      }
    },
    "A backup could not be verified": {
