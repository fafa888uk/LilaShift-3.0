    "Replace an app's notification sounds with your own audio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace an app's notification sounds with your own audio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用自己的音频替换 App 的通知音。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye los sonidos de notificación de una app con tu propio audio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای اعلان یک برنامه را با صدای خودتان جایگزین کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App の通知音を自分のオーディオに置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 알림음을 자신의 오디오로 바꿉니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменяйте звуки уведомлений приложений на свои аудио."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay âm thanh thông báo của ứng dụng bằng âm thanh của bạn."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用自己的音訊替換 App 的通知音。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "用自己的音訊取代 App 的通知音。"
          }
        }
      }
    },
