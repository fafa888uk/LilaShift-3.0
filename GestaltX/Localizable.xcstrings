    "Restart the device: the AI changes are applied but not yet verified after a restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the device: the AI changes are applied but not yet verified after a restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重启设备：AI 更改已应用，但尚未在重启后验证。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia el dispositivo: los cambios de IA están aplicados, pero aún no se han verificado tras un reinicio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاه را راه‌اندازی مجدد کنید؛ تغییرات هوش مصنوعی اعمال شده‌اند، اما هنوز پس از راه‌اندازی مجدد تأیید نشده‌اند."
          }
