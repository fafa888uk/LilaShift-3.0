      }
    },
    "Create a fresh backup. This record cannot be used to restore.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a fresh backup. This record cannot be used to restore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请创建新备份。此记录不能用于恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una nueva copia de seguridad. Este registro no se puede usar para restaurar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک پشتیبان تازه بسازید. این رکورد برای بازیابی قابل استفاده نیست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバックアップを作成してください。この記録は復元に使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 백업을 만들어 주세요. 이 기록은 복원에 사용할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новую резервную копию. Эту запись нельзя использовать для восстановления."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tạo bản sao lưu mới. Không thể dùng bản ghi này để khôi phục."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請建立新備份。此記錄不能用於恢復。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請建立新備份。此記錄不能用於恢復。"
          }
        }
      }
    },
    "If the region keeps reverting, restore from a verified backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the region keeps reverting, restore from a verified backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果地区设置持续回退，请从已验证的备份恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la región sigue volviendo al valor anterior, restaura desde una copia de seguridad verificada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر تنظیم منطقه همچنان به مقدار قبلی برمی‌گردد، از یک پشتیبان تأییدشده بازیابی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域設定が繰り返し元に戻る場合は、検証済みのバックアップから復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 설정이 계속 이전 상태로 돌아간다면 검증된 백업으로 복원해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если регион продолжает возвращаться к прежнему значению, выполните восстановление из проверенной резервной копии."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu vùng liên tục trở về giá trị cũ, hãy khôi phục từ bản sao lưu đã được xác minh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如果地區設定持續還原，請從已驗證的備份恢復。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "如果地區設定持續還原，請從已驗證的備份恢復。"
          }
        }
      }
    },
    "Monitor values are stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor values are stale"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监控值已过期"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores del monitor están desactualizados"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقادیر پایش قدیمی شده‌اند"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モニターの値が古くなっています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모니터링 값이 오래되었습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные мониторинга устарели"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giá trị giám sát đã cũ"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "監測值已過期"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "監測值已過期"
          }
        }
      }
    },
    "The live values were read more than five minutes ago.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live values were read more than five minutes ago."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时值的读取时间已超过五分钟。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores actuales se leyeron hace más de cinco minutos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقادیر فعلی بیش از پنج دقیقه پیش خوانده شده‌اند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの現在値を読み取ってから 5 分以上経過しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 값을 읽은 지 5분이 넘었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущие значения были считаны более пяти минут назад."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giá trị trực tiếp được đọc cách đây hơn năm phút."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "即時值的讀取時間已超過五分鐘。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "即時值的讀取時間已超過五分鐘。"
          }
        }
      }
    },
    "Refresh the monitor to re-read the live values.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the monitor to re-read the live values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请刷新监控，重新读取实时值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza el monitor para volver a leer los valores actuales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پایش را تازه‌سازی کنید تا مقادیر فعلی دوباره خوانده شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モニターを更新して、現在値を再度読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모니터를 새로 고쳐 현재 값을 다시 읽어 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите мониторинг, чтобы заново считать текущие значения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm mới màn hình giám sát để đọc lại các giá trị trực tiếp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新整理監測資料，重新讀取即時值。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新整理監測資料，重新讀取即時值。"
          }
        }
      }
    },
    "iOS offers no public API for an app to change the system wallpaper or another app's launch image. Save an image to Photos and set it manually. The Wallpaper Library can use one of your images as the background inside LilaShift.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS offers no public API for an app to change the system wallpaper or another app's launch image. Save an image to Photos and set it manually. The Wallpaper Library can use one of your images as the background inside LilaShift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未提供公开接口供应用更改系统壁纸或其他应用的启动图。请将图片保存到“照片”，然后手动设置。壁纸库可将你的某张图片用作 LilaShift 内部的背景。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no ofrece una API pública para que una app cambie el fondo del sistema ni la imagen de inicio de otra app. Guarda una imagen en Fotos y configúrala manualmente. La biblioteca de fondos permite usar una de tus imágenes como fondo dentro de LilaShift."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS رابط برنامه‌نویسی عمومی برای تغییر تصویر زمینهٔ سیستم یا تصویر آغازین برنامه‌ای دیگر توسط یک برنامه ارائه نمی‌کند. تصویر را در «عکس‌ها» ذخیره کنید و آن را دستی تنظیم کنید. کتابخانهٔ تصاویر زمینه می‌تواند یکی از تصاویر شما را به‌عنوان پس‌زمینهٔ داخل LilaShift به کار ببرد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS には、アプリがシステムの壁紙や別のアプリの起動画像を変更できる公開 API はありません。画像を「写真」に保存し、手動で設定してください。壁紙ライブラリでは、自分の画像を LilaShift 内の背景に使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 앱이 시스템 배경화면이나 다른 앱의 시작 이미지를 변경할 수 있는 공개 API를 제공하지 않습니다. 이미지를 사진 앱에 저장한 뒤 직접 설정해 주세요. 배경화면 보관함에서는 사용자의 이미지를 LilaShift 내부 배경으로 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В iOS нет публичного API, позволяющего приложению менять системные обои или стартовое изображение другого приложения. Сохраните изображение в «Фото» и установите его вручную. Библиотека обоев позволяет использовать ваше изображение как фон внутри LilaShift."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không cung cấp API công khai để ứng dụng thay đổi hình nền hệ thống hoặc ảnh khởi động của ứng dụng khác. Hãy lưu ảnh vào Ảnh rồi thiết lập thủ công. Thư viện hình nền có thể dùng một ảnh của bạn làm nền bên trong LilaShift."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未提供公開介面讓 App 更改系統牆紙或其他 App 的啟動畫面。請將圖片儲存到「相片」，再手動設定。牆紙庫可將你的某張圖片用作 LilaShift 內部的背景。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未提供公開介面讓 App 更改系統桌布或其他 App 的啟動畫面。請將圖片儲存到「照片」，再手動設定。桌布圖庫可將你的某張圖片用作 LilaShift 內部的背景。"
          }
        }
      }
    },
