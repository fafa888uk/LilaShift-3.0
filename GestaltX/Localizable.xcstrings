    "Static analysis only reports what was found in this binary. It cannot prove an app is safe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Static analysis only reports what was found in this binary. It cannot prove an app is safe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静态分析仅报告在此二进制文件中发现的内容，无法证明某个 App 是安全的。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis estático solo informa de lo encontrado en este binario. No puede demostrar que una app sea segura."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تحلیل ایستا فقط آنچه را در این باینری یافت شده گزارش می دهد. نمی تواند ثابت کند که یک برنامه امن است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静的解析は、このバイナリ内で見つかった内容のみを報告します。App が安全であることを証明することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정적 분석은 이 바이너리에서 발견된 내용만 보고합니다. 앱이 안전하다는 것을 증명할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статический анализ сообщает только о том, что найдено в этом бинарном файле. Он не может доказать, что приложение безопасно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân tích tĩnh chỉ báo cáo những gì tìm thấy trong binary này. Nó không thể chứng minh một ứng dụng là an toàn."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "靜態分析僅報告在此二進制檔案中發現的內容，無法證明某個 App 是安全的。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "靜態分析僅報告在此二進位檔案中發現的內容，無法證明某個 App 是安全的。"
          }
        }
      }
    },
    "Statistics only. This page never deletes anything.": {
      "localizations": {
