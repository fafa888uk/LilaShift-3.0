        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若未生效，請重新啟動裝置。需要 iOS 26 或以上版本。"
          }
        }
      }
    },
    "A device restart may be required. Actual charging control depends on hardware.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restart may be required. Actual charging control depends on hardware."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新启动设备才能生效。实际充电控制仍取决于硬件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se requiera reiniciar el dispositivo. El control real de carga depende del hardware."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است راه‌اندازی مجدد دستگاه لازم باشد. کنترل واقعی شارژ به سخت‌افزار بستگی دارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの再起動が必要になる場合があります。実際の充電制御はハードウェアに依存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 재시동이 필요할 수 있습니다. 실제 충전 제어 여부는 기기 하드웨어에 따라 다릅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может потребоваться перезагрузка устройства. Реальное управление зарядкой зависит от оборудования."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị. Khả năng kiểm soát sạc thực tế tùy thuộc vào phần cứng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啓動設備才能生效。實際充電控制仍取決於硬件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啟動裝置才能生效。實際充電控制仍取決於硬體。"
          }
        }
      }
    },
    "A device restart may be required. Only shown on devices where tap-to-wake is hidden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restart may be required. Only shown on devices where tap-to-wake is hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新启动设备才能生效。仅在隐藏轻点唤醒的设备上显示。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que se requiera reiniciar el dispositivo. Solo se muestra en dispositivos donde «Tocar para activar» está oculto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است راه‌اندازی مجدد دستگاه لازم باشد. فقط در دستگاه‌هایی نمایش داده می‌شود که بیدار شدن با لمس در آن‌ها پنهان است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの再起動が必要になる場合があります。タップしてスリープ解除が非表示のデバイスでのみ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 재시동이 필요할 수 있습니다. 탭하여 깨우기 설정이 숨겨진 기기에서만 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может потребоваться перезагрузка устройства. Показывается только на устройствах, где пробуждение касанием скрыто."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị. Chỉ hiển thị trên thiết bị đang ẩn tính năng chạm để bật màn hình."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啓動設備才能生效。僅在隱藏輕點喚醒的設備上顯示。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可能需要重新啟動裝置才能生效。僅在隱藏輕點喚醒的裝置上顯示。"
          }
        }
      }
    },
    "A device restart may be required. This does not add a physical button.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restart may be required. This does not add a physical button."
          }
        },
        "zh-Hans": {
