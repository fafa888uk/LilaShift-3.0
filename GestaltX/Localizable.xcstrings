    "Modification timeline and precise restore, from trusted records only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modification timeline and precise restore, from trusted records only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改时间线与精确恢复，仅依据可信记录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronología de modificaciones y restauración precisa, solo a partir de registros de confianza."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خط زمانی تغییرات و بازیابی دقیق، فقط بر اساس سوابق مورد اعتماد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更タイムラインと正確な復元は、信頼できる記録のみに基づきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정 타임라인과 정확한 복원은 신뢰할 수 있는 기록만을 기준으로 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хронология изменений и точное восстановление — только на основе доверенных записей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dòng thời gian sửa đổi và khôi phục chính xác, chỉ dựa trên bản ghi đáng tin cậy."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "修改時間軸與精確還原，僅依據可信記錄。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "修改時間軸與精確還原，僅依據可信記錄。"
          }
        }
      }
    },
