    "The device model is unknown, so scope cannot be checked.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device model is unknown, so scope cannot be checked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备型号未知，无法检查适用范围。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desconoce el modelo del dispositivo, por lo que no se puede comprobar el ámbito de aplicación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدل دستگاه ناشناخته است، بنابراین نمی‌توان محدودهٔ کاربرد را بررسی کرد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのモデルが不明なため、適用範囲を確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 모델을 알 수 없어 적용 범위를 확인할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель устройства неизвестна, поэтому область применимости проверить нельзя."
          }
