    },
    "The cache layout could not be resolved on this model and OS build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cache layout could not be resolved on this model and OS build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析此机型及系统构建版本的缓存布局。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo determinar la estructura de la caché para este modelo y esta compilación del sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیدمان حافظهٔ نهان در این مدل و ساخت سیستم‌عامل قابل تشخیص نبود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機種と OS ビルドでは、キャッシュの配置を特定できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기종과 OS 빌드에서는 캐시 구조를 파악할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить структуру кеша для этой модели и сборки ОС."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xác định được bố cục bộ nhớ đệm trên mẫu máy và bản dựng hệ điều hành này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析此機型及系統組建版本的快取佈局。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析此機型及系統組建版本的快取佈局。"
          }
        }
      }
    },
    "The proposal touched a hardware-identity field. Remove it from the proposal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proposal touched a hardware-identity field. Remove it from the proposal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案涉及硬件身份字段，请将该项从方案中移除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propuesta afecta a un campo de identidad del hardware. Elimínalo de la propuesta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشنهاد شامل یک فیلد هویت سخت‌افزاری است. آن را از پیشنهاد حذف کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更案にハードウェア識別情報の項目が含まれています。変更案からその項目を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경안에 하드웨어 식별 정보 항목이 포함되어 있습니다. 변경안에서 해당 항목을 제거해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложение затрагивает поле идентификации оборудования. Удалите его из предложения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phương án có tác động đến trường nhận dạng phần cứng. Hãy loại bỏ trường đó khỏi phương án."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "方案涉及硬件身分欄位，請將該項從方案中移除。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "方案涉及硬體身分欄位，請將該項從方案中移除。"
          }
        }
      }
    },
    "On native Apple Intelligence hardware, skip this item: the native slot stays off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On native Apple Intelligence hardware, skip this item: the native slot stays off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在原生支持 Apple 智能的硬件上，请跳过此项：原生槽位保持关闭。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En hardware con compatibilidad nativa con Apple Intelligence, omite este elemento: la posición nativa permanece desactivada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در سخت‌افزاری با پشتیبانی بومی Apple Intelligence، از این مورد بگذرید؛ خانهٔ اصلی خاموش می‌ماند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence を標準でサポートするハードウェアでは、この項目をスキップしてください。本来のスロットは無効のままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence를 기본 지원하는 하드웨어에서는 이 항목을 건너뛰세요. 기기의 기본 슬롯은 꺼진 상태를 유지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На оборудовании со встроенной поддержкой Apple Intelligence пропустите этот пункт: исходный слот остаётся отключённым."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên phần cứng hỗ trợ sẵn Apple Intelligence, hãy bỏ qua mục này: ô gốc vẫn giữ trạng thái tắt."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在原生支援 Apple 智能的硬件上，請略過此項：原生槽位保持關閉。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在原生支援 Apple 智能的硬體上，請略過此項：原生槽位保持關閉。"
          }
        }
      }
    },
    "The CacheData slot could not be located on this device's layout.": {
      "localizations": {
