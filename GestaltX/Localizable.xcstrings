    "This format cannot be converted. Import audio with the same format, sample rate and channel count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This format cannot be converted. Import audio with the same format, sample rate and channel count."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
