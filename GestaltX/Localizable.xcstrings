    "This image format is not supported. Use PNG, JPEG, or HEIC.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image format is not supported. Use PNG, JPEG, or HEIC."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持这种图片格式，请使用 PNG、JPEG 或 HEIC。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de imagen no es compatible. Usa PNG, JPEG o HEIC."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این قالب تصویر پشتیبانی نمی‌شود. از PNG، JPEG یا HEIC استفاده کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像形式はサポートされていません。PNG、JPEG、または HEIC を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지 형식은 지원되지 않습니다. PNG, JPEG 또는 HEIC를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот формат изображения не поддерживается. Используйте PNG, JPEG или HEIC."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định dạng hình ảnh này không được hỗ trợ. Hãy dùng PNG, JPEG hoặc HEIC."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
