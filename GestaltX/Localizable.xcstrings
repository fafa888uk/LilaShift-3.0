    "This only deletes the imported pack from LilaShift. Applied wallpapers will be kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only deletes the imported pack from LilaShift. Applied wallpapers will be kept."
          }
        },
        "zh-Hans": {
