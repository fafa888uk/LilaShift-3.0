    "That path still cannot be read and written by this app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That path still cannot be read and written by this app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 仍无法读取和写入该路径。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app aún no puede leer ni escribir esa ruta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این برنامه هنوز نمی‌تواند آن مسیر را بخواند و بنویسد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この App はまだそのパスを読み書きできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 여전히 해당 경로를 읽고 쓸 수 없습니다."
