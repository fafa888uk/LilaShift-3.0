    "FairPlay-encrypted binaries were skipped, so the verdict does not cover them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FairPlay-encrypted binaries were skipped, so the verdict does not cover them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过 FairPlay 加密的二进制文件，因此判定结果不涵盖它们。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitieron los binarios cifrados con FairPlay, por lo que el veredicto no los cubre."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "باینری های رمزگذاری شده با FairPlay رد شدند، پس حکم شامل آنها نمی شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FairPlay で暗号化されたバイナリはスキップされたため、判定の対象外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FairPlay로 암호화된 바이너리는 건너뛰었으므로 판정에 포함되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бинарные файлы, зашифрованные FairPlay, были пропущены, поэтому вердикт их не охватывает."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các binary mã hóa bằng FairPlay đã bị bỏ qua, nên kết luận không bao gồm chúng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳過 FairPlay 加密的二進制檔案，因此判定結果不涵蓋它們。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳過 FairPlay 加密的二進位檔案，因此判定結果不涵蓋它們。"
          }
        }
      }
    },
