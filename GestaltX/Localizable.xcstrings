    "Show or hide each card on the Tools page. The Personalization Center card itself always stays on this page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show or hide each card on the Tools page. The Personalization Center card itself always stays on this page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择在工具页显示哪些卡片。个性化中心卡片始终保留在本页。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta cada tarjeta en la página Herramientas. La tarjeta del Centro de personalización siempre permanece en esta página."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کارت را در صفحه ابزار نشان دهید یا پنهان کنید. کارت مرکز شخصی‌سازی همیشه در همین صفحه باقی می‌ماند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールページに表示するカードをそれぞれ表示／非表示にできます。パーソナライズセンターのカードは常にこのページに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 페이지에 표시할 카드를 각각 표시하거나 숨기세요. 개인화 센터 카드는 항상 이 페이지에 남아 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывайте или скрывайте каждую карточку на странице «Инструменты». Карточка Центра персонализации всегда остаётся на этой странице."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện hoặc ẩn từng thẻ trên trang Công cụ. Thẻ Trung tâm cá nhân hóa luôn ở lại trang này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要在工具頁顯示的卡片。個人化中心卡片會始終保留在此頁面。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要在工具頁顯示的卡片。個人化中心卡片會始終保留在此頁面。"
          }
        }
      }
