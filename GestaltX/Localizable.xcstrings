            "value": "파일이 변경되었습니다. 적용 전에 다시 읽어 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы изменились. Повторите чтение перед применением."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp đã thay đổi. Hãy đọc lại trước khi áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案已變更，請重新讀取後再套用。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案已變更，請重新讀取後再套用。"
          }
        }
      }
    },
    "The original files could not be backed up.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original files could not be backed up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能备份原始文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los archivos originales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تهیه نسخه پشتیبان از فایل‌های اصلی انجام نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルをバックアップできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일을 백업하지 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить исходные файлы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể sao lưu các tệp gốc."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法備份原始檔案。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法備份原始檔案。"
          }
        }
      }
    },
    "This adds new wallpapers without replacing your existing ones.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This adds new wallpapers without replacing your existing ones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将添加新壁纸，保留现有壁纸。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadirán fondos nuevos y se conservarán los existentes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر زمینه جدید اضافه می‌شوند و تصاویر فعلی حفظ می‌شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の壁紙を置き換えずに新しい壁紙を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 배경화면을 유지하고 새 배경화면을 추가합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут добавлены новые обои с сохранением существующих."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm hình nền mới và giữ nguyên hình nền hiện có."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將新增背景圖片並保留現有圖片。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將新增背景圖片並保留現有圖片。"
          }
        }
      }
    },
    "This pack contains no compatible wallpapers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pack contains no compatible wallpapers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此包中没有兼容的壁纸。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paquete no contiene fondos compatibles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این بسته تصویر زمینه سازگاری ندارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパックには対応する壁紙がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 팩에 호환되는 배경화면이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В наборе нет совместимых обоев."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói này không chứa hình nền tương thích."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此套件沒有兼容的背景圖片。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此套件沒有相容的背景圖片。"
          }
        }
      }
    },
    "This wallpaper was changed outside LilaShift. It was not removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallpaper was changed outside LilaShift. It was not removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "壁纸已被其他方式修改，未执行移除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo se modificó fuera de LilaShift y no se ha eliminado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تصویر زمینه خارج از LilaShift تغییر کرده و حذف نشده است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この壁紙はLilaShift以外で変更されているため、削除しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LilaShift 외부에서 변경된 배경화면이므로 제거하지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обои изменены вне LilaShift и не были удалены."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình nền đã bị thay đổi bên ngoài LilaShift nên chưa được xóa."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "背景圖片已在 LilaShift 之外變更，因此未移除。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "背景圖片已在 LilaShift 之外變更，因此未移除。"
          }
        }
      }
    },
    "Wallpaper added. Open the wallpaper gallery to select it. If it does not appear, restart the device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallpaper added. Open the wallpaper gallery to select it. If it does not appear, restart the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "壁纸已添加，请打开图库选择。若未出现，请重新启动设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fondo añadido. Abre la galería de fondos para seleccionarlo. Si no aparece, reinicia el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر زمینه اضافه شد. گالری تصویر زمینه را باز کنید تا آن را انتخاب کنید. اگر ظاهر نشد، دستگاه را راه‌اندازی مجدد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙を追加しました。ギャラリーを開いて選択してください。表示されない場合は、デバイスを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경화면이 추가되었습니다. 갤러리를 열어 선택하세요. 나타나지 않으면 기기를 다시 시작하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обои добавлены. Откройте галерею обоев, чтобы выбрать их. Если они не появились, перезапустите устройство."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thêm hình nền. Mở thư viện hình nền để chọn. Nếu không xuất hiện, hãy khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已新增桌布，請開啟圖庫選擇。若未出現，請重新啟動裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已新增桌布，請開啟圖庫選擇。若未出現，請重新啟動裝置。"
          }
        }
      }
    },
    "Wallpaper saved to Photos. Set it from Photos (Use as Wallpaper) or with the Shortcuts Set Wallpaper action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallpaper saved to Photos. Set it from Photos (Use as Wallpaper) or with the Shortcuts Set Wallpaper action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "壁纸已保存到相册。请在“照片”中打开它并选择“用作壁纸”，或使用快捷指令的“设定壁纸”操作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fondo de pantalla guardado en Fotos. Ajústalo desde Fotos (Usar como fondo de pantalla) o con la acción Establecer fondo de pantalla de Atajos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر پس‌زمینه در عکس‌ها ذخیره شد. آن را از عکس‌ها (استفاده به‌عنوان تصویر پس‌زمینه) یا با اقدام «تنظیم تصویر پس‌زمینه» در میانبرها تنظیم کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙を写真に保存しました。「写真」から「壁紙に設定」を選ぶか、ショートカットの「壁紙を設定」アクションで設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경화면이 사진에 저장되었습니다. 사진에서 '배경화면으로 사용'을 선택하거나 단축어의 '배경화면 설정' 동작으로 설정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обои сохранены в Фото. Установите их из Фото («Использовать как обои») или с помощью действия «Установить обои» в Командах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu hình nền vào Ảnh. Đặt từ Ảnh (Dùng làm Hình nền) hoặc bằng tác vụ Đặt Hình nền trong Phím tắt."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙已儲存到相片。請在「相片」中開啟並選擇「設為壁紙」，或使用捷徑的「設定壁紙」操作。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "桌布已儲存到照片。請在「照片」中開啟並選擇「設為桌布」，或使用捷徑的「設定桌布」操作。"
          }
        }
      }
    },
