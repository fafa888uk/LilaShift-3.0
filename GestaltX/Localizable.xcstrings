        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ tệp thiết bị sẽ được thay bằng bản sao lưu."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
