        }
      }
    },
    "Restart the device if the change does not appear. Requires iOS 26 or later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the device if the change does not appear. Requires iOS 26 or later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若未生效，请重新启动设备。需要 iOS 26 或更高版本。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el cambio no aparece, reinicia el dispositivo. Requiere iOS 26 o posterior."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر تغییر ظاهر نشد، دستگاه را راه‌اندازی مجدد کنید. به iOS 26 یا جدیدتر نیاز دارد."
