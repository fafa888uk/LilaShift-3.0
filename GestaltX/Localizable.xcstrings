          "stringUnit": {
            "state": "translated",
            "value": "A found path is still pending verification until a maintainer confirms the app version on a real device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到的路径仍待验证，须由维护者在真机上确认 App 版本后才算完成。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
