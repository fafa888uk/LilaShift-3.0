        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminará el paquete importado de LilaShift. Los fondos aplicados se conservarán."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط بستهٔ واردشده از LilaShift حذف می‌شود. تصاویر زمینهٔ اعمال‌شده باقی می‌مانند."
          }
        },
        "ja": {
          "stringUnit": {
