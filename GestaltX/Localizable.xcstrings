    },
    "The live probe reports Apple Intelligence off on this native-AI iPhone, which conflicts with staging AI capabilities. Confirm explicitly before staging.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live probe reports Apple Intelligence off on this native-AI iPhone, which conflicts with staging AI capabilities. Confirm explicitly before staging."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时检测报告此原生 AI iPhone 的 Apple 智能为关闭，与暂存 AI 能力冲突。暂存前请明确确认。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación en vivo indica que Apple Intelligence está desactivado en este iPhone con IA nativa, lo que entra en conflicto con la preparación de funciones de IA. Confirme explícitamente antes de preparar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی زنده گزارش می‌دهد که Apple Intelligence در این آیفون با هوش مصنوعی بومی خاموش است، که با آماده‌سازی قابلیت‌های هوش مصنوعی در تضاد است. پیش از آماده‌سازی صراحتاً تأیید کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ検出によると、このネイティブ AI 対応 iPhone では Apple Intelligence がオフになっており、AI 機能のステージングと競合します。ステージングする前に明示的に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 검사에서 이 네이티브 AI iPhone의 Apple Intelligence가 꺼져 있어 AI 기능 스테이징과 충돌한다고 보고합니다. 스테이징하기 전에 명시적으로 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живая проверка сообщает, что Apple Intelligence выключена на этом iPhone с нативным ИИ, что противоречит подготовке возможностей ИИ. Подтвердите явно перед подготовкой."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra trực tiếp báo cáo Apple Intelligence đang tắt trên iPhone có AI gốc này, mâu thuẫn với việc chuẩn bị các khả năng AI. Hãy xác nhận rõ ràng trước khi chuẩn bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "即時檢測報告此原生 Apple 智能 iPhone 的 Apple 智慧為關閉，與暫存 AI 能力衝突。暫存前請明確確認。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "即時檢測報告此原生 Apple 智能 iPhone 的 Apple 智慧為關閉，與暫存 AI 能力衝突。暫存前請明確確認。"
          }
        }
      }
    },
