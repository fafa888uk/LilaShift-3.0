          "stringUnit": {
            "state": "translated",
            "value": "儲存的指紋來自另一台裝置"
          }
        }
      }
    },
    "The stored fingerprint belongs to a different device, so the recorded support scope does not apply here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stored fingerprint belongs to a different device, so the recorded support scope does not apply here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的指纹属于另一台设备，因此记录的支持范围不适用于此设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La huella guardada pertenece a otro dispositivo, por lo que el alcance de compatibilidad registrado no se aplica aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اثر انگشت ذخیره‌شده متعلق به دستگاه دیگری است؛ بنابراین محدودهٔ پشتیبانی ثبت‌شده برای این دستگاه کاربرد ندارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されているデバイス指紋は別のデバイスのものなので、記録された対応範囲はこのデバイスには適用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 기기 지문은 다른 기기의 것이므로 기록된 지원 범위가 이 기기에는 적용되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый отпечаток принадлежит другому устройству, поэтому записанный диапазон поддержки здесь неприменим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dấu vân tay đã lưu thuộc về thiết bị khác, nên phạm vi hỗ trợ đã ghi không áp dụng cho thiết bị này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的指紋屬於另一部裝置，因此記錄的支援範圍不適用於此裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的指紋屬於另一台裝置，因此記錄的支援範圍不適用於此裝置。"
          }
        }
      }
    },
    "The device fingerprint changed": {
      "localizations": {
        "en": {
          "stringUnit": {
