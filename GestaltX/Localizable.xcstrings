    "Review the changed fields. If the change is expected, re-capture the fingerprint.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the changed fields. If the change is expected, re-capture the fingerprint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查发生变化的字段。如果变化符合预期，请重新采集指纹。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los campos modificados. Si el cambio es el esperado, vuelve a capturar la huella."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فیلدهای تغییرکرده را بررسی کنید. اگر تغییر مورد انتظار است، اثر انگشت را دوباره ثبت کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更された項目を確認してください。想定どおりの変更であれば、デバイス指紋を再取得してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경된 항목을 확인해 주세요. 예상한 변경이라면 기기 지문을 다시 수집해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте изменившиеся поля. Если изменение ожидаемое, заново сохраните отпечаток."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại các trường đã thay đổi. Nếu thay đổi đúng như dự kiến, hãy thu thập lại dấu vân tay."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查發生變化的欄位。如果變化符合預期，請重新擷取指紋。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查發生變化的欄位。如果變化符合預期，請重新擷取指紋。"
          }
        }
      }
    },
    "Create a fresh backup, then retry the write.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a fresh backup, then retry the write."
          }
        },
        "zh-Hans": {
