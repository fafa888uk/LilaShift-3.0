        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拨号盘皮肤已应用，部分无效图片已跳过。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema del marcador aplicado; se omitieron algunas imágenes no válidas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پوسته صفحه‌کلید اعمال شد؛ برخی تصاویر نامعتبر نادیده گرفته شدند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイヤルスキンを適用しました。一部の無効な画像はスキップされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다이얼 스킨이 적용되었습니다. 일부 잘못된 이미지는 건너뛰었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформление номеронабирателя применено; некоторые недопустимые изображения пропущены."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã áp dụng giao diện bàn phím; một số hình ảnh không hợp lệ đã bị bỏ qua."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
