      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline: only local ping and traceroute results are shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线：仅显示本地 ping 与 traceroute 结果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión: solo se muestran los resultados locales de ping y traceroute."
          }
        },
        "fa": {
