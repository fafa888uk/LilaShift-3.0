    "Check whether this model is in the supported list, and re-read the device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether this model is in the supported list, and re-read the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认该机型是否在支持列表中，并重新读取设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si este modelo está en la lista de compatibles y vuelve a leer el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی کنید آیا این مدل در فهرست پشتیبانی‌شده است یا نه، و دستگاه را دوباره بخوانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルが対応リストにあるか確認し、デバイスを再度読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델이 지원 목록에 있는지 확인하고 기기를 다시 읽으십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, есть ли эта модель в списке поддерживаемых, и прочитайте устройство ещё раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra xem mẫu máy này có trong danh sách được hỗ trợ không, rồi đọc lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認此型號是否在支援清單中，並重新讀取裝置。"
          }
        },
        "zh-Hant-TW": {
