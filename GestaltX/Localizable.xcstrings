    "Builds from 24C5049d on are blocked; newer trains are blocked until the threshold is reviewed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds from 24C5049d on are blocked; newer trains are blocked until the threshold is reviewed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 24C5049d 开始的构建已被阻止；在重新审查阈值之前，更高版本分支也会被阻止。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compilaciones desde 24C5049d están bloqueadas; las series posteriores también se bloquean hasta revisar el umbral."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساخت‌های 24C5049d و بعد از آن مسدود هستند؛ شاخه‌های انتشار جدیدتر نیز تا بازبینی آستانه مسدود می‌مانند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24C5049d 以降のビルドはブロックされます。新しいリリース系列も、判定基準を再確認するまでブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "24C5049d부터의 빌드는 차단됩니다. 더 새로운 릴리스 계열도 기준을 재검토할 때까지 차단됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборки начиная с 24C5049d заблокированы; более новые ветки также блокируются до пересмотра порога."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản dựng từ 24C5049d trở đi bị chặn; các nhánh phát hành mới hơn cũng bị chặn cho đến khi ngưỡng được rà soát."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "從 24C5049d 開始的組建已被封鎖；在重新審查門檻前，更新的版本系列也會被封鎖。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從 24C5049d 開始的組建已被封鎖；在重新審查門檻前，更新的版本系列也會被封鎖。"
          }
        }
      }
    },
    "Build %@: blocked fail-closed — it is from a newer train than the reviewed threshold (24C5049d, iOS 27.3 beta 2), and support for this train has not been reviewed. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build %@: blocked fail-closed — it is from a newer train than the reviewed threshold (24C5049d, iOS 27.3 beta 2), and support for this train has not been reviewed. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建 %@：为安全起见已阻止——它属于比已审查阈值（24C5049d，iOS 27.3 beta 2）更新的版本分支，此分支的支持情况尚未审查。%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilación %@: bloqueada por seguridad; pertenece a una serie posterior al umbral revisado (24C5049d, iOS 27.3 beta 2) y su compatibilidad aún no se ha evaluado. %@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساخت %@: برای حفظ ایمنی مسدود شد؛ این ساخت از شاخه‌ای جدیدتر از آستانهٔ بررسی‌شده (24C5049d، iOS 27.3 بتای ۲) است و پشتیبانی از این شاخه هنوز بررسی نشده است. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルド %@：安全のためブロックしました。確認済みの基準（24C5049d、iOS 27.3 beta 2）より新しいリリース系列で、この系列の対応状況はまだ確認されていません。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드 %@: 안전을 위해 차단되었습니다. 검토된 기준(24C5049d, iOS 27.3 베타 2)보다 새로운 릴리스 계열이며, 이 계열의 지원 여부는 아직 검토되지 않았습니다. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборка %@: заблокирована по принципу безопасного отказа — она относится к ветке новее проверенного порога (24C5049d, iOS 27.3 beta 2), а поддержка этой ветки ещё не проверена. %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng %@: bị chặn để bảo đảm an toàn — thuộc nhánh mới hơn ngưỡng đã rà soát (24C5049d, iOS 27.3 beta 2), và khả năng hỗ trợ nhánh này chưa được rà soát. %@"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "組建 %@：依安全原則封鎖——其版本系列新於已審查的門檻（24C5049d，iOS 27.3 beta 2），此系列的支援狀態尚未審查。%@"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "組建 %@：依安全原則封鎖——其版本系列新於已審查的門檻（24C5049d，iOS 27.3 beta 2），此系列的支援狀態尚未審查。%@"
          }
        }
      }
    },
