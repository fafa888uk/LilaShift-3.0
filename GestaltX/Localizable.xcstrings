    "This is a legacy backup with no recorded digest, so its integrity cannot be verified. No system changes were made.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a legacy backup with no recorded digest, so its integrity cannot be verified. No system changes were made."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是未记录摘要的旧版备份，因此无法验证其完整性。未对系统进行任何更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad antigua no tiene un resumen registrado, por lo que no se puede verificar su integridad. No se ha modificado el sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پشتیبان قدیمی فاقد هش ثبت‌شده است، بنابراین نمی‌توان یکپارچگی آن را تأیید کرد. هیچ تغییری در سیستم ایجاد نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはダイジェストが記録されていない旧形式のバックアップのため、整合性を検証できません。システムは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해시가 기록되지 않은 이전 형식의 백업이므로 무결성을 검증할 수 없습니다. 시스템은 변경되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это резервная копия старого формата без записанной контрольной суммы, поэтому её целостность невозможно проверить. Система не изменена."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là bản sao lưu cũ không có mã băm được ghi lại, nên không thể xác minh tính toàn vẹn. Hệ thống không bị thay đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這是未記錄摘要的舊版備份，因此無法驗證其完整性。未對系統進行任何變更。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這是未記錄摘要的舊版備份，因此無法驗證其完整性。未對系統進行任何變更。"
          }
        }
      }
    },
