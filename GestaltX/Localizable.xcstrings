    "Some device values changed since the fingerprint was captured.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some device values changed since the fingerprint was captured."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自记录指纹以来，一些设备值已更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos valores del dispositivo cambiaron desde que se capturó la huella."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی مقادیر دستگاه از زمان ثبت اثر انگشت تغییر کرده‌اند."
          }
        },
        "ja": {
