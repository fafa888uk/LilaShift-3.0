    "Fake supervision residue removed. A genuine MDM profile was not touched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fake supervision residue removed. A genuine MDM profile was not touched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伪监管残留已清除，未触碰真正的 MDM 配置文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
