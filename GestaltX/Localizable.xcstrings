    "Key: waGD2UTpntjbDXD1r3oALQ (Erosion-CN MGCacheLayout). Not present in upstream GestaltX 1.1.1.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key: waGD2UTpntjbDXD1r3oALQ (Erosion-CN MGCacheLayout). Not present in upstream GestaltX 1.1.1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键：waGD2UTpntjbDXD1r3oALQ（Erosion-CN MGCacheLayout）。上游 GestaltX 1.1.1 中没有。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave: waGD2UTpntjbDXD1r3oALQ (Erosion-CN MGCacheLayout). No está presente en GestaltX 1.1.1 original."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید: waGD2UTpntjbDXD1r3oALQ (Erosion-CN MGCacheLayout). در GestaltX بالادستی 1.1.1 وجود ندارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キー: waGD2UTpntjbDXD1r3oALQ（Erosion-CN MGCacheLayout）。上流のGestaltX 1.1.1には存在しません。"
          }
        },
        "ko": {
