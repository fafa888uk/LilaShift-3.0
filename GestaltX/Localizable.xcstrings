    "Custom presets are plans only. They are not connected to staging or applying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom presets are plans only. They are not connected to staging or applying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义预设仅为计划，未连接暂存或套用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes personalizados son solo planes. No están conectados a la preparación ni a la aplicación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌تنظیم‌های سفارشی فقط طرح هستند. به مرحله‌بندی یا اعمال متصل نیستند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムプリセットは計画のみです。ステージングや適用には接続されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 프리셋은 계획일 뿐입니다. 스테이징이나 적용에 연결되어 있지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательские пресеты — только планы. Они не связаны с подготовкой или применением."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt sẵn tùy chỉnh chỉ là kế hoạch. Chúng không được kết nối với việc chuẩn bị hay áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂預設僅為計劃，未連接暫存或套用。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂預設僅為計畫，未連接暫存或套用。"
          }
        }
      }
    },
    "Custom presets, catalog sort and Tools page cards — saved on this device only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom presets, catalog sort and Tools page cards — saved on this device only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义预设、目录排序与工具页卡片——仅保存在本机。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes personalizados, orden del catálogo y tarjetas de la página Herramientas: solo se guardan en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌تنظیم‌های سفارشی، مرتب‌سازی فهرست و کارت‌های صفحه ابزار — فقط در همین دستگاه ذخیره می‌شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムプリセット、カタログの並び替え、ツールページのカード——このデバイスにのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 프리셋, 카탈로그 정렬, 도구 페이지 카드 — 이 기기에만 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательские пресеты, сортировка каталога и карточки страницы «Инструменты» — сохраняются только на этом устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt sẵn tùy chỉnh, sắp xếp danh mục và thẻ trang Công cụ — chỉ lưu trên thiết bị này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂預設、目錄排序與工具頁卡片——僅儲存在此裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂預設、目錄排序與工具頁卡片——僅儲存在此裝置。"
          }
        }
      }
    },
