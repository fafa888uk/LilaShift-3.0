    },
    "The enhanced version is distributed under the GNU GPL v3.0. Its complete corresponding source is distributed with the release.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The enhanced version is distributed under the GNU GPL v3.0. Its complete corresponding source is distributed with the release."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强版遵循 GNU GPL v3.0 发布。随发布一同提供其完整对应源代码。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión mejorada se distribuye bajo la GNU GPL v3.0. Su código fuente correspondiente completo se distribuye con la versión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه بهبودیافته تحت GNU GPL نسخه 3.0 توزیع می‌شود. کد منبع متناظر کامل آن همراه با انتشار ارائه می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張版は GNU GPL v3.0 に基づいて配布されます。対応する完全なソースコードもリリースとともに配布されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개선된 버전은 GNU GPL v3.0에 따라 배포됩니다. 이에 대응하는 전체 소스 코드도 릴리스와 함께 배포됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшенная версия распространяется по лицензии GNU GPL v3.0. Соответствующий полный исходный код распространяется вместе с выпуском."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản cải tiến được phân phối theo GNU GPL v3.0. Mã nguồn tương ứng đầy đủ được phân phối cùng với bản phát hành."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "增強版遵循 GNU GPL v3.0 發佈。隨發佈一同提供其完整對應原始碼。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "增強版遵循 GNU GPL v3.0 發佈。隨發佈一同提供其完整對應原始碼。"
          }
        }
      }
    },
    "No license stated": {
