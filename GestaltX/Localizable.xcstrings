    "Already supported on this device — no change needed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already supported on this device — no change needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备已原生支持，无需修改。"
          }
        },
        "es": {
