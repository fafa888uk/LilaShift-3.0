          "stringUnit": {
            "state": "translated",
            "value": "자산 태그가 적용되었습니다. 잠금 화면에서 확인하려면 기기를 재시동하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тег актива применён. Перезапустите устройство, чтобы увидеть его на экране блокировки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã áp dụng thẻ tài sản. Khởi động lại thiết bị để xem trên Màn hình khóa."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已套用資產標籤。重新啟動設備後，即可在鎖定屏幕上看到。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已套用資產標籤。重新啟動裝置後，即可在鎖定畫面上看到。"
          }
        }
      }
    },
