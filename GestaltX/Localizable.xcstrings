    "A custom preset cannot contain the same preset twice.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom preset cannot contain the same preset twice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义预设不能两次包含同一预设。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ajuste personalizado no puede contener el mismo ajuste dos veces."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک پیش‌تنظیم سفارشی نمی‌تواند یک پیش‌تنظیم را دو بار دربر بگیرد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムプリセットに同じプリセットを2回含めることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 프리셋은 같은 프리셋을 두 번 포함할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательский пресет не может содержать один и тот же пресет дважды."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt sẵn tùy chỉnh không thể chứa cùng một cài đặt sẵn hai lần."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂預設不能重複包含同一預設。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂預設不能重複包含同一預設。"
          }
        }
      }
    },
