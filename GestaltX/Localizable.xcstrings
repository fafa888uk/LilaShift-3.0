    "All Tools cards are hidden. Re-enable them in the Personalization Center.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Tools cards are hidden. Re-enable them in the Personalization Center."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具页卡片已全部隐藏，请在个性化中心重新开启。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las tarjetas de Herramientas están ocultas. Vuelve a activarlas en el Centro de personalización."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه کارت‌های ابزار پنهان شده‌اند. آن‌ها را در مرکز شخصی‌سازی دوباره فعال کنید."
