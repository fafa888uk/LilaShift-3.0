    "Device-specific results are available after reading the device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device-specific results are available after reading the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取设备后可查看设备专属结果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados específicos del dispositivo están disponibles después de leer el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نتایج مخصوص دستگاه پس از خواندن دستگاه در دسترس است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス固有の結果は、デバイスを読み取った後に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기별 결과는 기기를 읽은 후에 확인할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты для этого устройства станут доступны после чтения устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả riêng của thiết bị sẽ có sau khi đọc thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取裝置後即可查看裝置專屬結果。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取裝置後即可查看裝置專屬結果。"
          }
        }
      }
    },
    "Browse, search and organize every preset.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse, search and organize every preset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览、搜索并整理全部预设。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora, busca y organiza todos los presets."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه پیش تنظیم ها را مرور، جستجو و مرتب کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのプリセットを閲覧、検索、整理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 프리셋을 찾아보고, 검색하고, 정리합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте, ищите и упорядочивайте все пресеты."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyệt, tìm kiếm và sắp xếp mọi preset."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽、搜尋並整理全部預設。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽、搜尋並整理全部預設。"
          }
        }
      }
    },
