    "Create a fresh backup. A failed backup cannot be used to restore.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a fresh backup. A failed backup cannot be used to restore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请创建新备份。验证失败的备份不能用于恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una nueva copia de seguridad. Una copia que no supere la verificación no puede usarse para restaurar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک پشتیبان تازه بسازید. پشتیبانی که در بررسی ناموفق بوده برای بازیابی قابل استفاده نیست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバックアップを作成してください。検証に失敗したバックアップは復元に使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 백업을 만들어 주세요. 검증에 실패한 백업은 복원에 사용할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новую резервную копию. Копию, не прошедшую проверку, нельзя использовать для восстановления."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tạo bản sao lưu mới. Không thể dùng bản sao lưu xác minh thất bại để khôi phục."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請建立新備份。驗證失敗的備份不能用於恢復。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請建立新備份。驗證失敗的備份不能用於恢復。"
          }
        }
      }
    },
    "Backups have no recorded digest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups have no recorded digest"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份未记录校验摘要"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad no tienen una huella de integridad registrada"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای پشتیبان‌ها هش ثبت نشده است"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップにハッシュ値が記録されていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에 기록된 해시값이 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для резервных копий не записаны хеши"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản sao lưu không có mã băm được ghi lại"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "備份未記錄雜湊摘要"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "備份未記錄雜湊摘要"
          }
        }
      }
    },
    "Every verified backup is a legacy backup with no recorded digest, so integrity cannot be proven.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every verified backup is a legacy backup with no recorded digest, so integrity cannot be proven."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已验证的备份都是未记录校验摘要的旧版备份，因此无法证明其完整性。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las copias comprobadas son antiguas y carecen de una huella de integridad registrada, por lo que no se puede demostrar su integridad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ پشتیبان‌های بررسی‌شده قدیمی هستند و هش ثبت‌شده ندارند؛ بنابراین نمی‌توان یکپارچگی آن‌ها را اثبات کرد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済みのバックアップはすべて、ハッシュ値が記録されていない旧形式のため、完全性を証明できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증된 백업이 모두 해시값이 기록되지 않은 이전 형식이므로 무결성을 입증할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все проверенные резервные копии имеют старый формат без записанного хеша, поэтому их целостность нельзя подтвердить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả bản sao lưu đã kiểm tra đều thuộc định dạng cũ và không có mã băm được ghi lại, nên không thể chứng minh tính toàn vẹn."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已驗證的備份都是未記錄雜湊摘要的舊版備份，因此無法證明其完整性。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已驗證的備份都是未記錄雜湊摘要的舊版備份，因此無法證明其完整性。"
          }
        }
      }
    },
    "Create a fresh backup with a recorded digest. Restore from a legacy backup only after explicit confirmation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a fresh backup with a recorded digest. Restore from a legacy backup only after explicit confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请创建带有校验摘要记录的新备份。只有在明确确认后，才从旧版备份恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una nueva copia de seguridad con una huella de integridad registrada. Restaura desde una copia antigua solo tras confirmarlo expresamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک پشتیبان تازه با هش ثبت‌شده بسازید. فقط پس از تأیید صریح، از پشتیبان قدیمی بازیابی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハッシュ値を記録した新しいバックアップを作成してください。旧形式のバックアップからの復元は、明示的に確認した場合に限って行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해시값이 기록된 새 백업을 만들어 주세요. 이전 형식의 백업으로는 명시적으로 확인한 경우에만 복원해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новую резервную копию с записанным хешем. Восстанавливайте старую копию только после явного подтверждения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo bản sao lưu mới có ghi mã băm. Chỉ khôi phục từ bản sao lưu định dạng cũ sau khi xác nhận rõ ràng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請建立有記錄雜湊摘要的新備份。只有在明確確認後，才從舊版備份恢復。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請建立有記錄雜湊摘要的新備份。只有在明確確認後，才從舊版備份恢復。"
          }
        }
      }
    },
    "Verify the backups before relying on one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify the backups before relying on one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先验证备份，再依赖它进行操作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica las copias de seguridad antes de confiar en ellas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از اتکا به پشتیبان‌ها، آن‌ها را بررسی و تأیید کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを利用する前に検証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 사용하기 전에 먼저 검증해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте резервные копии, прежде чем полагаться на них."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xác minh các bản sao lưu trước khi dựa vào chúng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請先驗證備份，再依賴它進行操作。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請先驗證備份，再依賴它進行操作。"
          }
        }
      }
    },
    "Create a fresh backup before retrying the restore.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a fresh backup before retrying the restore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先创建新备份，再重试恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una nueva copia de seguridad antes de volver a intentar la restauración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از تلاش دوباره برای بازیابی، یک پشتیبان تازه بسازید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元をやり直す前に、新しいバックアップを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원을 다시 시도하기 전에 새 백업을 만들어 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новую резервную копию перед повторной попыткой восстановления."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo bản sao lưu mới trước khi thử khôi phục lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請先建立新備份，再重試恢復。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請先建立新備份，再重試恢復。"
          }
        }
      }
    },
    "This iOS version blocks the mechanism. Stay on iOS 27.2.1 or below.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iOS version blocks the mechanism. Stay on iOS 27.2.1 or below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iOS 版本阻止了该机制。请保持在 iOS 27.2.1 或更低版本。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de iOS bloquea el mecanismo. Mantente en iOS 27.2.1 o una versión anterior."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نسخهٔ iOS سازوکار را مسدود می‌کند. روی iOS 27.2.1 یا نسخه‌های پایین‌تر بمانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iOS バージョンではこの仕組みがブロックされています。iOS 27.2.1 以前を維持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iOS 버전에서는 해당 방식이 차단됩니다. iOS 27.2.1 이하 버전을 유지해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия iOS блокирует данный механизм. Оставайтесь на iOS 27.2.1 или более ранней версии."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản iOS này chặn cơ chế đó. Hãy duy trì iOS 27.2.1 trở xuống."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iOS 版本封鎖了此機制。請維持在 iOS 27.2.1 或更低版本。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iOS 版本封鎖了此機制。請維持在 iOS 27.2.1 或更低版本。"
          }
        }
      }
    },
    "Review the restore preview: a check failed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the restore preview: a check failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查恢复预览：有一项检查未通过。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la vista previa de restauración: una comprobación falló."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌نمایش بازیابی را بررسی کنید؛ یکی از بررسی‌ها ناموفق بوده است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元プレビューを確認してください。チェックに失敗した項目があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원 미리보기를 확인해 주세요. 통과하지 못한 검사가 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите предварительный результат восстановления: одна из проверок не пройдена."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại bản xem trước khôi phục: một bước kiểm tra không đạt."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查恢復預覽：有一項檢查未通過。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查恢復預覽：有一項檢查未通過。"
          }
        }
      }
    },
    "The restore step failed. Check the restore report for the detail.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The restore step failed. Check the restore report for the detail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复步骤失败。请查看恢复报告了解详情。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paso de restauración falló. Consulta los detalles en el informe de restauración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحلهٔ بازیابی ناموفق بود. جزئیات را در گزارش بازیابی بررسی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元手順に失敗しました。詳細は復元レポートを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원 단계가 실패했습니다. 자세한 내용은 복원 보고서를 확인해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаг восстановления завершился ошибкой. Подробности приведены в отчёте о восстановлении."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bước khôi phục thất bại. Xem báo cáo khôi phục để biết chi tiết."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復步驟失敗。請查看恢復報告了解詳情。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復步驟失敗。請查看恢復報告了解詳情。"
          }
        }
      }
    },
    "The restore did not complete. Check the restore report for the failed step.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The restore did not complete. Check the restore report for the failed step."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复未完成。请查看恢复报告，确认失败的步骤。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración no se completó. Consulta el informe de restauración para identificar el paso que falló."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی کامل نشد. مرحلهٔ ناموفق را در گزارش بازیابی بررسی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元が完了しませんでした。失敗した手順を復元レポートで確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원이 완료되지 않았습니다. 실패한 단계는 복원 보고서에서 확인해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление не завершено. Найдите неудавшийся шаг в отчёте о восстановлении."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục chưa hoàn tất. Xem báo cáo khôi phục để biết bước nào thất bại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復未完成。請查看恢復報告，確認失敗的步驟。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復未完成。請查看恢復報告，確認失敗的步驟。"
          }
        }
      }
    },
    "Backup “%@”: %@ — %@": {
