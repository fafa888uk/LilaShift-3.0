    "The kernel Jetsam mechanism cleared background processes after physical memory ran out.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kernel Jetsam mechanism cleared background processes after physical memory ran out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "物理内存耗尽后，内核 Jetsam 机制清理了后台进程。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mecanismo Jetsam del kernel eliminó procesos en segundo plano al agotarse la memoria física."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از اتمام حافظه فیزیکی، مکانیزم Jetsam هسته فرآیندهای پس‌زمینه را پاک کرد。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物理メモリが枯渇したため、カーネルの Jetsam がバックグラウンドプロセスを整理しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물리 메모리가 소진되자 커널 Jetsam 메커니즘이 백그라운드 프로세스를 정리했습니다。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После исчерпания физической памяти механизм Jetsam ядра завершил фоновые процессы。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi hết bộ nhớ vật lý, cơ chế Jetsam của nhân đã dọn các tiến trình nền。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "物理記憶體耗盡後，內核 Jetsam 機制清理了背景行程。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "物理記憶體耗盡後，內核 Jetsam 機制清理了背景行程。"
          }
        }
      }
    },
    "The kernel refused the sandbox extension token for this path.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
