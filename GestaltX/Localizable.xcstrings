    "The stored fingerprint is from a different device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stored fingerprint is from a different device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的指纹来自另一台设备"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La huella guardada pertenece a otro dispositivo"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اثر انگشت ذخیره‌شده متعلق به دستگاه دیگری است"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されているデバイス指紋は別のデバイスのものです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 기기 지문은 다른 기기에서 가져온 것입니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый отпечаток относится к другому устройству"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dấu vân tay đã lưu thuộc về thiết bị khác"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的指紋來自另一部裝置"
          }
        },
