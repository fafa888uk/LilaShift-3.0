          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источник этой резервной копии ненадёжен, поэтому автоматически восстановить её нельзя. Её можно проверить вручную."
          }
        },
        "vi": {
          "stringUnit": {
