    "Preview only. This does not change the installed app, its Home Screen icon, SpringBoard, or LaunchServices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview only. This does not change the installed app, its Home Screen icon, SpringBoard, or LaunchServices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅预览，不会修改已安装的 App、其桌面图标、SpringBoard 或 LaunchServices。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo vista previa. Esto no cambia la app instalada, su icono de la pantalla de inicio, SpringBoard ni LaunchServices."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط پیش‌نمایش. این کار برنامه نصب‌شده، نماد صفحه اصلی آن، SpringBoard یا LaunchServices را تغییر نمی‌دهد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューのみです。インストール済みアプリ、そのホーム画面アイコン、SpringBoard、LaunchServices は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기 전용입니다. 설치된 앱, 홈 화면 아이콘, SpringBoard 또는 LaunchServices는 변경되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только предпросмотр. Установленное приложение, его значок на экране «Домой», SpringBoard и LaunchServices не изменяются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xem trước. Thao tác này không thay đổi ứng dụng đã cài đặt, biểu tượng màn hình chính, SpringBoard hay LaunchServices."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供預覽，不會修改已安裝的 App、其主畫面圖示、SpringBoard 或 LaunchServices。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供預覽，不會修改已安裝的 App、其主畫面圖示、SpringBoard 或 LaunchServices。"
          }
        }
      }
    },
    "Use 1–32 characters without control characters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–32 characters without control characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 1–32 个字符，且不含控制字符。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa de 1 a 32 caracteres sin caracteres de control."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از 1 تا 32 نویسه بدون نویسه‌های کنترلی استفاده کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制御文字を含まない 1〜32 文字を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어 문자 없이 1~32자를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте от 1 до 32 символов без управляющих символов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng 1–32 ký tự, không chứa ký tự điều khiển."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 1–32 個字元，且不含控制字元。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 1–32 個字元，且不含控制字元。"
          }
        }
      }
    },
