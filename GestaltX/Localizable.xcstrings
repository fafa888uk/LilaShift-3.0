    "Reorder and show or hide the diagnostics rows on the Tools home. The order is saved on this device only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reorder and show or hide the diagnostics rows on the Tools home. The order is saved on this device only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具首页对诊断行重新排序、显示或隐藏。顺序仅保存在本设备上。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena y muestra u oculta las filas de diagnóstico en la página principal de Herramientas. El orden solo se guarda en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ردیف‌های عیب‌یابی در صفحه اصلی ابزارها را مرتب کنید و نمایش یا پنهان کنید. ترتیب فقط در همین دستگاه ذخیره می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールホームの診断行を並べ替えたり、表示・非表示にしたりできます。順序はこのデバイスにのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 홈의 진단 행을 재정렬하고 표시하거나 숨길 수 있습니다. 순서는 이 기기에만 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте порядок и показывайте или скрывайте строки диагностики на главной странице инструментов. Порядок сохраняется только на этом устройстве."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp lại và hiển thị hoặc ẩn các hàng chẩn đoán trên trang chính Công cụ. Thứ tự chỉ được lưu trên thiết bị này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具首頁對診斷行重新排序、顯示或隱藏。順序僅儲存在本裝置上。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具首頁對診斷行重新排序、顯示或隱藏。順序僅儲存在本裝置上。"
          }
        }
      }
    },
    "Read the device first to see the diagnostics summary.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the device first to see the diagnostics summary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先读取设备，再查看诊断摘要。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee primero el dispositivo para ver el resumen de diagnóstico."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا دستگاه را بخوانید تا خلاصه عیب‌یابی را ببینید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断の概要を見るには、まずデバイスを読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 요약을 보려면 먼저 기기를 읽어 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала прочитайте устройство, чтобы увидеть сводку диагностики."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đọc thiết bị trước để xem tóm tắt chẩn đoán."
          }
