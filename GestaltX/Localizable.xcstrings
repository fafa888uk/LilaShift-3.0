    "This image is smaller than the device screen. The cropped copy will be upscaled and may look soft.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image is smaller than the device screen. The cropped copy will be upscaled and may look soft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图片小于设备屏幕。裁剪副本将被放大，可能略显模糊。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagen es más pequeña que la pantalla del dispositivo. La copia recortada se ampliará y puede verse borrosa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تصویر از صفحهٔ دستگاه کوچک‌تر است. نسخهٔ برش‌خورده بزرگ می‌شود و ممکن است کمی تار به نظر برسد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像はデバイスの画面より小さいため、切り抜いたコピーは拡大され、ぼやけることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지는 기기 화면보다 작습니다. 잘라낸 사본이 확대되어 흐릿하게 보일 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение меньше экрана устройства. Обрезанная копия будет увеличена и может выглядеть размытой."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh này nhỏ hơn màn hình thiết bị. Bản sao đã cắt sẽ được phóng lớn và có thể bị mờ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此圖片小於裝置螢幕。裁剪副本將會放大，可能略顯模糊。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此影像小於裝置螢幕。裁切副本將會放大，可能略顯模糊。"
          }
        }
      }
    },
