    "The whole device file is replaced by the backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole device file is replaced by the backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个设备文件将被备份替换。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el archivo del dispositivo se reemplazará por la copia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کل فایل دستگاه با پشتیبان جایگزین می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスファイル全体がバックアップに置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 파일 전체가 백업으로 대체됩니다."
          }
        },
        "ru": {
