    "Recommendations are generated on this device from its own readings. Nothing is sent anywhere.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommendations are generated on this device from its own readings. Nothing is sent anywhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议根据本机自身的读取数据在设备上生成，不会向任何地方发送数据。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las recomendaciones se generan en este dispositivo a partir de sus propias lecturas. No se envía nada a ningún sitio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توصیه‌ها روی همین دستگاه و از خواندن‌های خود آن ساخته می‌شوند. چیزی به هیچ‌جا ارسال نمی‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推奨事項は、このデバイス自身の読み取り値からデバイス上で生成されます。外部に送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권장 사항은 이 기기 자체의 측정값에서 기기상에서 생성됩니다. 어디에도 전송되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендации создаются на этом устройстве из его собственных показаний. Ничего никуда не отправляется."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất được tạo trên thiết bị này từ dữ liệu đọc của chính nó. Không gửi gì đi đâu cả."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "建議依據本設備自身的讀取資料於設備上產生，不會向任何地方傳送資料。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "建議依據本裝置自身的讀取資料於裝置上產生，不會向任何地方傳送資料。"
          }
        }
      }
    },
