          }
        }
      }
    },
    "The CacheData slot cannot be repaired to a known baseline on this device, so staging is refused until the recorded original value is available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CacheData slot cannot be repaired to a known baseline on this device, so staging is refused until the recorded original value is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的 CacheData 槽位无法修复到已知的基线，因此在获得已记录的原值之前拒绝暂存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura de CacheData no se puede reparar a un valor base conocido en este dispositivo, así que la preparación se rechaza hasta que el valor original registrado esté disponible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شکاف CacheData در این دستگاه را نمی‌توان به مقدار پایه شناخته‌شده بازگرداند، بنابراین تا زمانی که مقدار اصلی ثبت‌شده در دسترس نباشد، مرحله‌بندی رد می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの CacheData スロットは既知の基準値に修復できないため、記録された元の値が利用可能になるまでステージングは拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 CacheData 슬롯을 알려진 기준값으로 복구할 수 없어 기록된 원래 값을 사용할 수 있을 때까지 스테이징이 거부됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слот CacheData на этом устройстве нельзя восстановить до известного базового уровня, поэтому подготовка отклоняется до появления записанного исходного значения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể sửa khe CacheData về giá trị gốc đã biết trên thiết bị này nên việc chuẩn bị bị từ chối cho đến khi có giá trị gốc đã ghi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此設備上的 CacheData 槽位無法修復至已知的基線，因此在取得已記錄的原始值之前拒絕暫存。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的 CacheData 槽位無法修復至已知的基線，因此在取得已記錄的原始值之前拒絕暫存。"
          }
        }
      }
    },
    "The backup could not be verified. No system changes were made.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup could not be verified. No system changes were made."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证备份，未做任何系统更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la copia de seguridad. No se realizaron cambios en el sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پشتیبان تأیید نشد. هیچ تغییری در سیستم انجام نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを確認できませんでした。システムへの変更は行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 확인할 수 없습니다. 시스템 변경 사항이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить резервную копию. Изменений в системе не внесено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh bản sao lưu. Không có thay đổi hệ thống nào."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證備份，未做任何系統變更。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證備份，未做任何系統變更。"
          }
        }
      }
    },
    "The change history could not be read. No system changes were made.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change history could not be read. No system changes were made."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取更改历史，未做任何系统更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el historial de cambios. No se realizaron cambios en el sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سابقه تغییرات خوانده نشد. هیچ تغییری در سیستم انجام نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更履歴を読み取れませんでした。システムへの変更は行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 기록을 읽을 수 없습니다. 시스템 변경 사항이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать историю изменений. Изменений в системе не внесено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc lịch sử thay đổi. Không có thay đổi hệ thống nào."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取變更歷史記錄，未做任何系統變更。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取變更歷史記錄，未做任何系統變更。"
          }
        }
      }
    },
    "The change history could not be saved and verified. No system changes were made.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change history could not be saved and verified. No system changes were made."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存并验证更改历史，未做任何系统更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar y verificar el historial de cambios. No se realizaron cambios en el sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سابقه تغییرات ذخیره و تأیید نشد. هیچ تغییری در سیستم انجام نشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更履歴を保存して検証できませんでした。システムへの変更は行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 기록을 저장하고 확인할 수 없습니다. 시스템 변경 사항이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить и проверить историю изменений. Изменений в системе не внесено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu và xác minh lịch sử thay đổi. Không có thay đổi hệ thống nào."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存並驗證變更歷史記錄，未做任何系統變更。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存並驗證變更歷史記錄，未做任何系統變更。"
          }
        }
      }
    },
    "The device data changed since the snapshot. Read again before simulating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device data changed since the snapshot. Read again before simulating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自快照以来设备数据已更改。请重新读取后再模拟。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos del dispositivo cambiaron desde la instantánea. Vuelve a leer antes de simular."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های دستگاه از زمان عکس فوری تغییر کرده است. پیش از شبیه‌سازی دوباره بخوانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショット以降にデバイスのデータが変更されました。シミュレーションの前に再度読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스냅샷 이후 기기 데이터가 변경되었습니다. 시뮬레이션하기 전에 다시 읽으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные устройства изменились после снимка. Прочитайте снова перед симуляцией."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu thiết bị đã thay đổi kể từ ảnh chụp. Hãy đọc lại trước khi mô phỏng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自快照以來設備資料已變更。請重新讀取後再模擬。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自快照以來裝置資料已變更。請重新讀取後再模擬。"
          }
        }
      }
    },
    "The device data matches the snapshot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device data matches the snapshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备数据与快照一致。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos del dispositivo coinciden con la instantánea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های دستگاه با عکس فوری مطابقت دارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのデータはスナップショットと一致しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 데이터가 스냅샷과 일치합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные устройства совпадают со снимком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu thiết bị khớp với ảnh chụp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設備資料與快照一致。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置資料與快照一致。"
          }
        }
      }
    },
    "The first-read value is the first-recorded value, never a factory original. Fields with no trusted original never offer a precise restore.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first-read value is the first-recorded value, never a factory original. Fields with no trusted original never offer a precise restore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次读取值即首次记录值，绝非出厂原值。没有可信原值的字段绝不提供精确恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor de primera lectura es el primer valor registrado, nunca un original de fábrica. Los campos sin un original de confianza nunca ofrecen una restauración precisa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار اولین خواندن، مقدار اولین ثبت است، نه مقدار اصلی کارخانه. فیلدهایی که مقدار اصلی مورد اعتماد ندارند هرگز بازیابی دقیق ارائه نمی‌دهند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回読み取り値は初回記録値であり、出荷時の元の値ではありません。信頼できる元の値がないフィールドでは、正確な復元は提供されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최초 읽기 값은 최초 기록 값이며, 출고 시 원래 값이 아닙니다. 신뢰할 수 있는 원래 값이 없는 필드는 정확한 복원을 제공하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение первого чтения — это впервые записанное значение, а не заводской оригинал. Для полей без доверенного оригинала точное восстановление никогда не предлагается."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị đọc lần đầu là giá trị ghi lần đầu, không bao giờ là giá trị gốc của nhà máy. Trường không có giá trị gốc đáng tin cậy sẽ không bao giờ có khôi phục chính xác."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "首次讀取值即首次記錄值，絕非出廠原始值。沒有可信原始值的欄位絕不提供精確還原。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "首次讀取值即首次記錄值，絕非出廠原始值。沒有可信原始值的欄位絕不提供精確還原。"
          }
        }
      }
    },
    "The region code restores with the eSIM & Region group, not per item.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The region code restores with the eSIM & Region group, not per item."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地区代码随 eSIM 与地区组合一起恢复，不支持单项恢复。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de región se restaura con el grupo eSIM y región, no por elemento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد منطقه همراه با گروه eSIM و منطقه بازیابی می‌شود، نه به‌صورت تک‌موردی."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域コードは eSIM と地域のグループと一緒に復元され、個別には復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 코드는 eSIM 및 지역 그룹과 함께 복원되며, 항목별로는 복원되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код региона восстанавливается вместе с группой eSIM и региона, а не по отдельности."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã vùng được khôi phục cùng nhóm eSIM & Vùng, không khôi phục từng mục."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "地區代碼會隨 eSIM 與地區群組一起還原，不支援單項還原。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "地區代碼會隨 eSIM 與地區群組一起還原，不支援單項還原。"
          }
        }
      }
    },
