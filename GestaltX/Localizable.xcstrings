    "This app's own operation events and session log, with level and keyword filters; sharing exports the entries shown.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app's own operation events and session log, with level and keyword filters; sharing exports the entries shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 自身的操作事件与会话日志，支持按级别和关键词筛选；分享时会导出当前显示的条目。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos de funcionamiento y registro de sesión de la propia app, con filtros por nivel y por palabra clave; al compartir se exportan las entradas mostradas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رویدادهای عملکرد و گزارش نشست خود برنامه، با فیلتر سطح و کلیدواژه؛ اشتراک گذاری موارد نمایش داده شده را خروجی می گیرد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この App 自身の動作イベントとセッションログ。レベルとキーワードで絞り込みができ、共有すると表示中のエントリが書き出されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 자체의 동작 이벤트와 세션 로그. 수준 및 키워드 필터를 제공하며, 공유하면 표시된 항목이 내보내집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События работы и журнал сеансов самого приложения, с фильтрами по уровню и ключевому слову; при отправке экспортируются показанные записи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện hoạt động và nhật ký phiên của chính ứng dụng, có bộ lọc theo mức độ và từ khóa; khi chia sẻ sẽ xuất các mục đang hiển thị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 自身的操作事件與工作階段日誌，支援按級別和關鍵字篩選；分享時會匯出目前顯示的項目。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 自身的操作事件與工作階段紀錄，支援按級別和關鍵字篩選；分享時會匯出目前顯示的項目。"
          }
        }
      }
    },
