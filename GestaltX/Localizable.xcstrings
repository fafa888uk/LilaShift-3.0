    "No favorites yet. The four preset groups are shown instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No favorites yet. The four preset groups are shown instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无收藏，改为显示四个预设组合。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay favoritos. Se muestran los cuatro grupos de presets."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز برگزیده ای نیست. چهار گروه پیش تنظیم نمایش داده می شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りはまだありません。4つのプリセットグループを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기가 아직 없습니다. 네 가지 프리셋 그룹을 대신 표시합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранного пока нет. Показаны четыре группы пресетов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có mục yêu thích. Hiển thị bốn nhóm preset thay thế."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無收藏，改為顯示四個預設組合。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無收藏，改為顯示四個預設組合。"
          }
        }
      }
    },
