          }
        }
      }
    },
    "CacheExtra audioIntelligence is staged as 1 while CacheData slot #%d reads its native 0. Whether the CacheExtra key alone is safe on native-AI hardware is unverified — confirm explicitly before staging.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra audioIntelligence is staged as 1 while CacheData slot #%d reads its native 0. Whether the CacheExtra key alone is safe on native-AI hardware is unverified — confirm explicitly before staging."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra audioIntelligence 已暂存为 1，而 CacheData 槽位 #%d 读数为原生 0。仅 CacheExtra 键在原生 AI 硬件上是否安全尚未验证——暂存前请明确确认。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra audioIntelligence está preparado como 1 mientras la ranura CacheData #%d lee su 0 nativo. No está verificado si la clave CacheExtra por sí sola es segura en hardware con IA nativa; confirme explícitamente antes de preparar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra audioIntelligence به‌عنوان 1 آماده شده است، در حالی که شیار CacheData #%d مقدار 0 بومی خود را می‌خواند. این‌که آیا کلید CacheExtra به‌تنهایی روی سخت‌افزار هوش مصنوعی بومی امن است یا نه، تأیید نشده است — پیش از آماده‌سازی صراحتاً تأیید کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra の audioIntelligence が 1 としてステージングされていますが、CacheData スロット #%d の読み取り値はネイティブの 0 です。CacheExtra キー単独でネイティブ AI ハードウェア上安全かどうかは未検証です。ステージングする前に明示的に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra audioIntelligence가 1로 스테이징되어 있지만 CacheData 슬롯 #%d의 읽은 값은 네이티브 0입니다. CacheExtra 키만으로 네이티브 AI 하드웨어에서 안전한지는 검증되지 않았습니다. 스테이징하기 전에 명시적으로 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra audioIntelligence подготовлен как 1, а слот CacheData #%d показывает свой нативный 0. Не проверено, безопасен ли один ключ CacheExtra на оборудовании с нативным ИИ, — подтвердите явно перед подготовкой."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra audioIntelligence đã được chuẩn bị là 1 trong khi khe CacheData #%d đọc được 0 gốc của nó. Việc chỉ riêng khóa CacheExtra có an toàn trên phần cứng AI gốc hay không chưa được xác minh — hãy xác nhận rõ ràng trước khi chuẩn bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra audioIntelligence 已暫存為 1，而 CacheData 插槽 #%d 讀數為原生 0。僅 CacheExtra 鍵在原生 AI 硬體上是否安全尚未驗證——暫存前請明確確認。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "CacheExtra audioIntelligence 已暫存為 1，而 CacheData 插槽 #%d 讀數為原生 0。僅 CacheExtra 鍵在原生 AI 硬體上是否安全尚未驗證——暫存前請明確確認。"
          }
        }
      }
    },
