    "No post-restart document has been read. Nothing is claimed accepted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No post-restart document has been read. Nothing is claimed accepted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未读取重启后的文档。没有任何内容被声称为已接受。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha leído ningún documento posterior al reinicio. Nada se declara aceptado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ سندی پس از راه‌اندازی مجدد خوانده نشده است. هیچ چیزی پذیرفته‌شده اعلام نمی‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後のドキュメントはまだ読み取られていません。承認されたものとして主張されるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시작 후 문서를 아직 읽지 않았습니다. 수락된 것으로 주장되는 항목이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документ после перезагрузки не прочитан. Ничего не заявлено принятым."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đọc tài liệu nào sau khi khởi động lại. Không có gì được coi là đã chấp nhận."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未讀取重新啟動後的文件。沒有任何內容被聲稱為已接受。"
