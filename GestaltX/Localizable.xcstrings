    "Screen, biometrics, Low Power Mode, brightness and disk space — read-only, from public iOS APIs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen, biometrics, Low Power Mode, brightness and disk space — read-only, from public iOS APIs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕、生物识别、低电量模式、亮度和磁盘空间——只读，来自公开 iOS API。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalla, biometría, modo de bajo consumo, brillo y espacio en disco. Solo lectura, a partir de API públicas de iOS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحه نمایش، بیومتریک، حالت کم مصرف، روشنایی و فضای دیسک. فقط خواندنی، از API های عمومی iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面、生体認証、低電力モード、明るさ、ディスク容量。読み取り専用で、公開 iOS API から取得しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면, 생체 인식, 저전력 모드, 밝기, 디스크 공간. 읽기 전용이며 공개 iOS API에서 가져옵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран, биометрия, режим энергосбережения, яркость и место на диске. Только чтение, из открытых API iOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình, sinh trắc học, chế độ nguồn điện thấp, độ sáng và dung lượng đĩa. Chỉ đọc, từ API công khai của iOS."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕、生物識別、低電量模式、亮度和磁碟空間——唯讀，來自公開 iOS API。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕、生物辨識、低耗電模式、亮度和磁碟空間——唯讀，來自公開 iOS API。"
          }
        }
      }
    },
