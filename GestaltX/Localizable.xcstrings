          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备的真实能力与构建信息，本地记录并附 SHA-256 摘要。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capacidades reales y la compilación de este dispositivo, registradas localmente con un resumen SHA-256."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قابلیت‌ها و ساخت واقعی این دستگاه، به‌صورت محلی با خلاصه SHA-256 ثبت شده است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの実際の能力とビルドを、SHA-256 ダイジェスト付きでローカルに記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 실제 기능과 빌드를 SHA-256 다이제스트와 함께 로컬에 기록합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реальные возможности и сборка этого устройства, записанные локально с дайджестом SHA-256."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các năng lực và bản dựng thực của thiết bị này, được ghi cục bộ kèm mã băm SHA-256."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "該設備的真實能力與構建信息，本地記錄並附 SHA-256 摘要。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "該裝置的真實能力與組建資訊，本地記錄並附 SHA-256 摘要。"
          }
        }
      }
    },
    "This score is a diagnostic summary only. It does not guarantee safety or that any feature will work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This score is a diagnostic summary only. It does not guarantee safety or that any feature will work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此评分仅为诊断性汇总，不保证安全，也不保证任何功能一定可用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta puntuación es solo un resumen de diagnóstico. No garantiza seguridad ni que ninguna función vaya a funcionar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این امتیاز فقط یک خلاصه تشخیصی است. ایمنی یا کارکرد هیچ قابلیتی را تضمین نمی‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスコアは診断の概要にすぎません。安全性や機能の動作を保証するものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 점수는 진단 요약일 뿐입니다. 안전성이나 기능 동작을 보장하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта оценка — только диагностическая сводка. Она не гарантирует безопасность или работу функций."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm này chỉ là tóm tắt chẩn đoán. Nó không đảm bảo an toàn hay bất kỳ tính năng nào sẽ hoạt động."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
