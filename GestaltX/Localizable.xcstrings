    "Personal Translator slot is off on a native-AI iPhone — Photos Clean Up and Camera Siri may fail.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal Translator slot is off on a native-AI iPhone — Photos Clean Up and Camera Siri may fail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人翻译槽位在原生 Apple 智能 iPhone 上处于关闭状态，照片消除与相机 Siri 可能失效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura del Traductor personal está desactivada en un iPhone con IA nativa; Limpieza de Fotos y Siri de la cámara podrían fallar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شیار مترجم شخصی در آیفون با هوش مصنوعی بومی خاموش است — پاک‌سازی عکس و سیری دوربین ممکن است از کار بیفتد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ AI 対応 iPhone でパーソナル翻訳スロットがオフになっています。写真クリーンアップとカメラ Siri が失敗する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 AI iPhone에서 개인 번역 슬롯이 꺼져 있어 사진 정리 및 카메라 Siri가 실패할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слот личного переводчика выключен на iPhone с нативным ИИ — «Очистка фото» и Siri камеры могут не работать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khe Dịch cá nhân đang tắt trên iPhone có AI gốc — Xóa vật thể trong Ảnh và Siri máy ảnh có thể lỗi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "個人翻譯槽位在原生 Apple 智能 iPhone 上處於關閉狀態，照片消除與相機 Siri 可能失效。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "個人翻譯槽位在原生 Apple 智能 iPhone 上處於關閉狀態，照片消除與相機 Siri 可能失效。"
          }
        }
      }
    },
    "Audio Intelligence slot is on — Photos high-quality Clean Up may fail.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Intelligence slot is on — Photos high-quality Clean Up may fail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频智能槽位处于开启状态，照片高质量消除可能失败。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura de Inteligencia de audio está activada; la Limpieza de alta calidad en Fotos podría fallar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شیار هوش صوتی روشن است — پاک‌سازی باکیفیت عکس ممکن است ناموفق باشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオインテリジェンスのスロットがオンになっています。写真の高品質クリーンアップが失敗する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 인텔리전스 슬롯이 켜져 있어 사진 고품질 정리가 실패할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слот аудиоинтеллекта включён — высококачественная «Очистка фото» может не работать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khe Trí tuệ âm thanh đang bật — Xóa vật thể chất lượng cao trong Ảnh có thể lỗi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊智能槽位處於開啟狀態，照片高品質消除可能失敗。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊智能槽位處於開啟狀態，照片高品質消除可能失敗。"
          }
        }
      }
    },
    "Personal Translator CacheData slot #%d reads 0 on a native-AI iPhone — its native baseline is 1. Photos Clean Up and Camera Siri may fail.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal Translator CacheData slot #%d reads 0 on a native-AI iPhone — its native baseline is 1. Photos Clean Up and Camera Siri may fail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 AI iPhone 上个人翻译 CacheData 槽位 #%d 读数为 0，原生基线为 1。照片消除与相机 Siri 可能失败。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura CacheData #%d del Traductor personal lee 0 en un iPhone con IA nativa; su línea base nativa es 1. Limpieza de Fotos y Siri de la cámara podrían fallar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شیار CacheData #%d مترجم شخصی در آیفون با هوش مصنوعی بومی مقدار 0 را می‌خواند؛ مقدار پایه بومی آن 1 است. پاک‌سازی عکس‌ها و سیری دوربین ممکن است از کار بیفتد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ AI 対応 iPhone でパーソナル翻訳 CacheData スロット #%d の読み取り値が 0 です。ネイティブのベースラインは 1 です。写真クリーンアップとカメラ Siri が失敗する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 AI iPhone에서 개인 번역 CacheData 슬롯 #%d의 읽은 값이 0입니다. 네이티브 기준값은 1입니다. 사진 클린업과 카메라 Siri가 실패할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слот CacheData #%d личного переводчика показывает 0 на iPhone с нативным ИИ; его базовое значение — 1. «Очистка фото» и Siri камеры могут не работать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khe CacheData #%d của Trình dịch cá nhân đọc được 0 trên iPhone có AI gốc; giá trị gốc của nó là 1. Dọn ảnh và Siri máy ảnh có thể lỗi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 Apple 智能 iPhone 上個人翻譯 CacheData 插槽 #%d 讀數為 0，原生基線為 1。照片消除與相機 Siri 可能失效。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 Apple 智能 iPhone 上個人翻譯 CacheData 插槽 #%d 讀數為 0，原生基線為 1。照片消除與相機 Siri 可能失效。"
          }
        }
      }
    },
    "Audio Intelligence CacheData slot #%d reads 1 — its native baseline is 0. Photos high-quality Clean Up may fail.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Intelligence CacheData slot #%d reads 1 — its native baseline is 0. Photos high-quality Clean Up may fail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频智能 CacheData 槽位 #%d 读数为 1，原生基线为 0。照片高质量消除可能失败。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura CacheData #%d de Inteligencia de audio lee 1; su línea base nativa es 0. La Limpieza de Fotos de alta calidad podría fallar."
          }
        },
        "fa": {
