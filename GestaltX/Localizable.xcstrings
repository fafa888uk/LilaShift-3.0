          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu thay đổi không xuất hiện, hãy khởi động lại thiết bị. Yêu cầu iOS 26 trở lên."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
