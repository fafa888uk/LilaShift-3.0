        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu thay đổi không xuất hiện, hãy khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
