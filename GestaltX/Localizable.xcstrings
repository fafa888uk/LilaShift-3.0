    "This proposal changes a device-identity field. Staging it is refused.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This proposal changes a device-identity field. Staging it is refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此方案会更改设备身份字段，已拒绝暂存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta propuesta cambia un campo de identidad del dispositivo. Se rechaza su preparación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پیشنهاد فیلد هویت دستگاه را تغییر می‌دهد. مرحله‌بندی آن رد شد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この提案はデバイス識別フィールドを変更します。ステージングは拒否されました。"
          }
        },
        "ko": {
