    "The crop fills the screen without stretching. The original is kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The crop fills the screen without stretching. The original is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裁剪结果会填满屏幕而不拉伸，原图会保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recorte llena la pantalla sin estirar la imagen. Se conserva el original."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برش بدون کشیدگی، صفحه را پر می‌کند. تصویر اصلی حفظ می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を引き伸ばさずに画面全体に収まるよう切り抜きます。元の画像は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 늘리지 않고 화면에 꽉 차게 자릅니다. 원본은 보존됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезка заполняет экран без растягивания изображения. Оригинал сохраняется."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh được cắt để phủ kín màn hình mà không bị kéo giãn. Ảnh gốc được giữ lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "裁剪結果會填滿螢幕而不拉伸，原圖會保留。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "裁切結果會填滿螢幕而不拉伸，原圖會保留。"
          }
        }
      }
    },
