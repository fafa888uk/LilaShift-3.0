        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này vẫn không thể đọc và ghi đường dẫn đó。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 仍無法讀取和寫入該路徑。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 仍無法讀取和寫入該路徑。"
          }
