          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chuyển đổi định dạng này. Hãy nhập âm thanh có cùng định dạng, tần số lấy mẫu và số kênh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此格式暫不支援轉換，請匯入格式、取樣率及聲道數相同的音訊。"
          }
        },
