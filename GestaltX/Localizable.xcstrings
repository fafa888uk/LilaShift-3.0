    "This clears only this app's own Caches directory. It never touches system caches.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears only this app's own Caches directory. It never touches system caches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清理本应用自己的 Caches 目录，绝不触碰系统缓存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo borra el directorio Caches de esta app. Nunca toca las cachés del sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فقط پوشه Caches همین برنامه را پاک می‌کند. هرگز به حافظه‌های نهان سیستم دست نمی‌زند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリ自身の Caches ディレクトリのみを消去します。システムキャッシュには一切触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 자체의 Caches 디렉터리만 지웁니다. 시스템 캐시는 건드리지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищается только собственный каталог Caches этого приложения. Системные кэши не затрагиваются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xóa thư mục Caches của chính ứng dụng này. Không bao giờ chạm vào bộ nhớ đệm hệ thống."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
