    "The read failed. Re-read the device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The read failed. Re-read the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取失败，请重新读取设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura falló. Vuelve a leer el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خواندن ناموفق بود. اطلاعات دستگاه را دوباره بخوانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取りに失敗しました。デバイスを再度読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기에 실패했습니다. 기기를 다시 읽어 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение завершилось ошибкой. Повторно считайте данные устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc không thành công. Hãy đọc lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取失敗，請重新讀取裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取失敗，請重新讀取裝置。"
          }
        }
      }
    },
    "Apple Intelligence keys are not staged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence keys are not staged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能键尚未暂存"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de Apple Intelligence no están preparadas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیدهای Apple Intelligence آماده نشده‌اند"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence のキーがステージングされていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 키가 준비되지 않았습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи Apple Intelligence не подготовлены"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các khóa Apple Intelligence chưa được chuẩn bị"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能鍵尚未暫存"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能鍵尚未暫存"
          }
        }
      }
    },
    "None of the 7 AI keys is staged, and the live answers show them off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the 7 AI keys is staged, and the live answers show them off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 个 AI 键均未暂存，设备的实时回报也显示它们处于关闭状态。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna de las 7 claves de IA está preparada y las respuestas actuales del dispositivo indican que están desactivadas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ‌یک از ۷ کلید هوش مصنوعی آماده نشده و پاسخ‌های فعلی دستگاه نیز خاموش بودن آن‌ها را نشان می‌دهد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7 個の AI キーはどれもステージングされておらず、デバイスの現在の応答でも無効になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 키 7개가 모두 준비되지 않았으며, 기기의 현재 응답에서도 꺼진 상태로 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один из 7 ключей ИИ не подготовлен, а текущие ответы устройства показывают, что все они отключены."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có khóa nào trong 7 khóa AI được chuẩn bị và kết quả đọc trực tiếp cho thấy chúng đều đang tắt."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "7 個 AI 鍵均未暫存，裝置的即時回報亦顯示它們處於關閉狀態。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "7 個 AI 鍵均未暫存，裝置的即時回報也顯示它們處於關閉狀態。"
          }
        }
      }
    },
    "Stage the AI preset (one-tap unlock or AI Only) so the 7 AI keys are staged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage the AI preset (one-tap unlock or AI Only) so the 7 AI keys are staged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂存 AI 预设（一键解锁或仅 AI），使 7 个 AI 键进入暂存状态。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara el ajuste de IA (desbloqueo con un toque o Solo IA) para dejar listas las 7 claves de IA."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌تنظیم هوش مصنوعی («بازگشایی با یک لمس» یا «فقط هوش مصنوعی») را آماده کنید تا هر ۷ کلید هوش مصنوعی آماده شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI プリセット（ワンタップ解除または AI のみ）をステージングして、7 個の AI キーを準備してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 프리셋(원터치 잠금 해제 또는 AI만)을 준비하여 AI 키 7개를 적용 대기 상태로 만들어 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовьте набор настроек ИИ («Разблокировка одним касанием» или «Только ИИ»), чтобы подготовить все 7 ключей ИИ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuẩn bị cấu hình AI (mở khóa một chạm hoặc Chỉ AI) để đưa cả 7 khóa AI vào trạng thái sẵn sàng áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "暫存 AI 預設（一鍵解鎖或僅 AI），讓 7 個 AI 鍵進入暫存狀態。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "暫存 AI 預設（一鍵解鎖或僅 AI），讓 7 個 AI 鍵進入暫存狀態。"
          }
        }
      }
    },
