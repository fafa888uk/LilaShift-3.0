            "state": "translated",
            "value": "전체 소스 코드는 적용 가능한 오픈소스 라이선스에 따라 제공됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный исходный код предоставляется в соответствии с применимыми лицензиями с открытым исходным кодом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã nguồn đầy đủ được cung cấp theo các giấy phép mã nguồn mở hiện hành."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "完整原始碼依據適用的開源授權提供。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "完整原始碼依據適用的開源授權提供。"
          }
