          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все карточки «Инструменты» скрыты. Включите их снова в Центре персонализации."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả thẻ Công cụ đã bị ẩn. Bật lại chúng trong Trung tâm cá nhân hóa."
