    "Battery health, cycle count and capacity are not available through public iOS APIs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery health, cycle count and capacity are not available through public iOS APIs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池健康、循环次数与容量无法通过 iOS 公开 API 获取。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salud de la batería, el número de ciclos y la capacidad no están disponibles a través de las API públicas de iOS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سلامت باتری، تعداد چرخه‌ها و ظرفیت از طریق APIهای عمومی iOS در دسترس نیستند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーの状態、充電回数、容量は iOS の公開 API では取得できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 상태, 충전 횟수, 용량은 iOS 공개 API로 확인할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние аккумулятора, число циклов и ёмкость недоступны через публичные API iOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tình trạng pin, số chu kỳ sạc và dung lượng không có qua API công khai của iOS."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "電池健康度、循環次數與容量無法透過 iOS 公開 API 取得。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "電池健康度、循環次數與容量無法透過 iOS 公開 API 取得。"
          }
        }
      }
    },
