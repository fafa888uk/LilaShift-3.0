        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspects the selected IPA locally. Signature files and permission descriptions are metadata only. This does not verify trust, entitlements, or whether the app is safe to install."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机检查所选 IPA。签名文件和权限用途说明仅作为元数据展示。结果不代表签名可信、权限已授权或安装安全。"
