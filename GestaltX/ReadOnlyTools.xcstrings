    "Charts sample LilaShift while this screen is active. CPU is expressed as a percentage of one logical core.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charts sample LilaShift while this screen is active. CPU is expressed as a percentage of one logical core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面处于前台时采样紫序的性能数据。CPU 占用率以单个逻辑核心为基准。"
          }
        }
      }
    },
    "Checks a file locally without saving or displaying its private keys. A structural check cannot confirm whether an iPhone still trusts the pairing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks a file locally without saving or displaying its private keys. A structural check cannot confirm whether an iPhone still trusts the pairing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机检查文件，私钥不会保存或显示。文件结构完整并不能确认 iPhone 是否仍然信任该配对。"
          }
        }
      }
    },
    "Checks whether the system language model is available to apps on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether the system language model is available to apps on this device."
