    "The system icon lookup is separate from the on-disk icon cache. Cache writes are unverified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system icon lookup is separate from the on-disk icon cache. Cache writes are unverified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标来自系统查询。磁盘图标与名称缓存的写入仍待验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示由系統查詢傳回。磁碟圖示與名稱快取的寫入仍待驗證。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示由系統查詢傳回。磁碟圖示與名稱快取的寫入仍待驗證。"
          }
        },
