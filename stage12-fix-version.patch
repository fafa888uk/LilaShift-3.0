diff --git a/GestaltX/ShareLilaShift.swift b/GestaltX/ShareLilaShift.swift
index 6f73b1a..6114845 100644
--- a/GestaltX/ShareLilaShift.swift
+++ b/GestaltX/ShareLilaShift.swift
@@ -1,29 +1,26 @@
 // SPDX-License-Identifier: GPL-3.0-only
-// LilaShift 3.0: share the current pre-release with others.
+// LilaShift 4.0: share the current release with others.
 // There are no referral codes, invite links or rewards — the share
 // only points at the public release page and the Telegram updates
-// channel. The shared build is 3.0.0-rc.1, a pre-release, never a
-// stable release.
+// channel. The shared build is 4.0.0.
 import Foundation
 
 /// Content for the "Share LilaShift" row in About.
 enum ShareLilaShift {
-    /// Public release page for 3.0.0-rc.1.
-    static let releaseURLString = "https://github.com/fafa888uk/LilaShift-3.0/releases/tag/v3.0.0-rc.1"
+    /// Public release page for 4.0.0.
+    static let releaseURLString = "https://github.com/fafa888uk/LilaShift-3.0/releases/tag/v4.0.0"
     /// Telegram updates channel.
     static let telegramURLString = "https://t.me/LilaShiftUpdates"
     /// Version label of the shared build.
-    static let versionLabel = "3.0.0-rc.1"
+    static let versionLabel = "4.0.0"
 
     static var releaseURL: URL { URL(string: releaseURLString)! }
     static var telegramURL: URL { URL(string: telegramURLString)! }
 
-    /// Localized label stating the shared build is a pre-release.
-    static var preReleaseLabel: String { L("Pre-release") }
-
-    /// The full share text: app name, version, pre-release label and
-    /// both links. The URLs are constants and are never translated.
+    /// The full share text: app name, version and both links. The
+    /// URLs are constants and are never translated. 4.0.0 is a formal
+    /// release, so no pre-release label is attached.
     static func text() -> String {
-        "LilaShift \(versionLabel) (\(preReleaseLabel))\n\(releaseURLString)\n\(L("Telegram Updates Channel")): \(telegramURLString)"
+        "LilaShift \(versionLabel)\n\(releaseURLString)\n\(L("Telegram Updates Channel")): \(telegramURLString)"
     }
 }
diff --git a/tests/ShareLilaShiftTests.swift b/tests/ShareLilaShiftTests.swift
index 430f538..c013223 100644
--- a/tests/ShareLilaShiftTests.swift
+++ b/tests/ShareLilaShiftTests.swift
@@ -14,22 +14,23 @@ final class ShareLilaShiftTests: XCTestCase {
         XCTAssertTrue(text.contains(ShareLilaShift.telegramURLString), "Share text must link the Telegram updates channel")
     }
 
-    func testShareTextNamesVersionAndMarksPreRelease() {
+    func testShareTextNamesVersionWithoutPreReleaseMark() {
         let text = ShareLilaShift.text()
         XCTAssertTrue(text.contains(ShareLilaShift.versionLabel), "Share text must name the shared version")
-        XCTAssertTrue(text.contains(ShareLilaShift.preReleaseLabel), "Share text must mark the build as a pre-release")
+        XCTAssertFalse(text.localizedCaseInsensitiveContains("pre-release"), "A formal release must not be marked as a pre-release")
+        XCTAssertFalse(text.contains("预发布"), "A formal release must not be marked as a pre-release")
         XCTAssertTrue(text.contains(L("Telegram Updates Channel")), "Share text must label the Telegram link")
     }
 
-    func testShareTextDoesNotClaimStableRelease() {
+    func testShareTextLinksFormalRelease() {
         let text = ShareLilaShift.text()
-        XCTAssertFalse(text.localizedCaseInsensitiveContains("stable release"), "A pre-release must never be presented as stable")
-        XCTAssertFalse(text.contains("正式版"), "A pre-release must never be presented as stable")
+        XCTAssertTrue(text.contains("/releases/tag/v4.0.0"), "Share text must link the formal 4.0.0 release page")
+        XCTAssertFalse(text.localizedCaseInsensitiveContains("rc."), "A formal release must not link a release candidate")
     }
 
     func testShareURLsAreValid() {
         XCTAssertEqual(ShareLilaShift.releaseURL.host, "github.com")
-        XCTAssertEqual(ShareLilaShift.releaseURL.path, "/fafa888uk/LilaShift-3.0/releases/tag/v3.0.0-rc.1")
+        XCTAssertEqual(ShareLilaShift.releaseURL.path, "/fafa888uk/LilaShift-3.0/releases/tag/v4.0.0")
         XCTAssertEqual(ShareLilaShift.telegramURL.host, "t.me")
         XCTAssertEqual(ShareLilaShift.telegramURL.path, "/LilaShiftUpdates")
     }
