      }
    },
    "Exports a static 1080 × 1920 PNG. It does not set your wallpaper or create a Live Photo.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出 1080 × 1920 的静态 PNG，不设置系统壁纸，也不会生成实况照片。"
          }
        }
      }
    },
    "Horizontal Framing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水平取景"
