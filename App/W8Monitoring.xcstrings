    "Critical": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严重"
          }
        }
      }
    },
    "Current process only. Samples about every two seconds while this page is active.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅统计本应用进程。此页在前台时约每两秒采样。"
          }
        }
      }
    },
    "Elapsed time since opening this monitor. It is not system uptime.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从打开此监控页开始计算，不是系统运行时间。"
          }
        }
      }
    },
